{
  "id": "CH-006",
  "name": "send one-way records server evidence",
  "roles": {
    "registry": {
      "count": 0
    },
    "server": [
      {
        "name": "api-a",
        "channel": "scenario.api"
      }
    ],
    "client": [
      {
        "name": "client-a"
      }
    ]
  },
  "steps": [
    {
      "waitReady": {
        "target": "server:api-a"
      }
    },
    {
      "clientSend": {
        "client": "client-a",
        "channel": "scenario.api",
        "packetName": "ScenarioProfileCommand",
        "commandId": "ch-006-command-1",
        "value": "refresh"
      }
    },
    {
      "assertEvidence": {
        "target": "server:api-a",
        "commandId": "ch-006-command-1"
      }
    }
  ],
  "expect": {
    "reply": {},
    "serverEvidence": {
      "commandIds": [
        "ch-006-command-1"
      ]
    }
  },
  "artifacts": {
    "logs": "logs",
    "report": "report.json",
    "evidence": "server:/evidence"
  }
}
