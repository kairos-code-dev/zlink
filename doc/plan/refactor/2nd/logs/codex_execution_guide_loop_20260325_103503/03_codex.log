+    _default_pub = NULL;
+    _default_sub = NULL;
+    _default_pub_fast.store (NULL, std::memory_order_release);
+    _default_sub_fast.store (NULL, std::memory_order_release);
+    _internal_receiver_fast.store (NULL, std::memory_order_release);
+}
