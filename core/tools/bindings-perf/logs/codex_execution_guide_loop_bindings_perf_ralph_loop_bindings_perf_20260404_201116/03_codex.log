    char *count_end = NULL;
    const unsigned long long parsed_count =
      std::strtoull (size_end + 1, &count_end, 10);
    if (!count_end || *count_end != '\0' || parsed_count == 0)
        return false;

    *msg_size_out_ = static_cast<size_t> (parsed_size);
    *ready_count_out_ = static_cast<size_t> (parsed_count);
    return true;
}

