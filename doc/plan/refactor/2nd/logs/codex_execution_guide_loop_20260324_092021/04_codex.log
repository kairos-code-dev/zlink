-
-static int send_parts_via_dispatch_pipe (pipe_t *pipe_,
-                                         zlink_msg_t *parts_,
-                                         size_t part_count_)
-{
-    if (!pipe_ || !parts_ || part_count_ == 0) {
-        errno = EINVAL;
