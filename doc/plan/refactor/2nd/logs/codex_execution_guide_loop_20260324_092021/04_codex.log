+        return spot->node->set_tls_server (cert_, key_);
+    }
+
+    if (is_registered_spot_node_handle (handle_))
+        return static_cast<zlink::spot_node_t *> (handle_)->set_tls_server (
+          cert_, key_);
+
+    errno = EFAULT;
+    return -1;
+}
+
+int spot_subject_set_tls_client (void *handle_,
+                                 const char *ca_cert_,
