{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "stripInternal": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/canonical.ts",
    "src/errors.ts",
    "src/message.ts",
    "src/buffer_like.ts",
    "src/native.ts",
    "src/validation.ts",
    "src/socket/constants.ts"
  ],
  "exclude": [
    "dist",
    "prebuilds",
    "native",
    "node_modules"
  ]
}
