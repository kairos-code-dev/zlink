+        zlink::service_public_api_scope_t admission (node->public_api_guard ());
+        if (!admission.acquired ())
+            return -1;
+        if (pub_option >= 0
+            && node->set_pub_option (pub_option, optval_, optvallen_) != 0)
+            return -1;
+        if (sub_option >= 0
+            && node->set_sub_option (sub_option, optval_, optvallen_) != 0)
+            return -1;
+        return 0;
+    }
+
+    errno = EFAULT;
+    return -1;
+}
