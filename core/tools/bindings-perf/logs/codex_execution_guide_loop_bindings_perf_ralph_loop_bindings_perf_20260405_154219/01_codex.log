        return send_result_t::sent;
    case ZLINK_SEND_RESULT_BACKPRESSURED:
        return send_result_t::backpressured;
    case ZLINK_SEND_RESULT_NOT_READY:
        return send_result_t::not_ready;
    default:
        return send_result_t::sent;
    }
}

