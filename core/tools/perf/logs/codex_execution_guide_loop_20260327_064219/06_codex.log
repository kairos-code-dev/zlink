+void test_bootstrap_descriptor_republish_stops_after_ready_topology_stabilizes ()
+{
+    zlink::spot_runtime_t runtime (NULL);
+
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::should_publish_bootstrap_descriptor (
+        &runtime, false, 0));
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::should_publish_bootstrap_descriptor (
+        &runtime, true, 0));
+
+    runtime.mesh_peer_state.connected_ready_peer_count.store (
+      2, std::memory_order_release);
+    runtime.mesh_peer_state.version.store (7, std::memory_order_release);
+
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::should_publish_bootstrap_descriptor (
+        &runtime, true, 6));
+    TEST_ASSERT_FALSE (
+      zlink::spot_data_plane_protocol_t::should_publish_bootstrap_descriptor (
+        &runtime, true, 7));
 }
 
+void test_bootstrap_descriptor_republish_resumes_after_topology_change ()
+{
+    zlink::spot_runtime_t runtime (NULL);
+    runtime.mesh_peer_state.connected_ready_peer_count.store (
+      1, std::memory_order_release);
+    runtime.mesh_peer_state.version.store (3, std::memory_order_release);
+
+    TEST_ASSERT_FALSE (
+      zlink::spot_data_plane_protocol_t::should_publish_bootstrap_descriptor (
+        &runtime, true, 3));
+
+    runtime.mesh_peer_state.version.store (4, std::memory_order_release);
+
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::should_publish_bootstrap_descriptor (
+        &runtime, true, 3));
+}
+}
