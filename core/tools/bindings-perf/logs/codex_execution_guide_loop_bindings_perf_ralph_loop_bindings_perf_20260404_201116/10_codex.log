{
    zlink::socket_t *sock;
    std::vector<char> payload;
    bool awaiting_reply;
    bool send_pending;
    bool pollout_enabled;
    bool id_sent;

    socket_state_t ()
        : sock (NULL),
          payload (),
          awaiting_reply (false),
          send_pending (false),
          pollout_enabled (false),
          id_sent (false)
    {
    }
};

