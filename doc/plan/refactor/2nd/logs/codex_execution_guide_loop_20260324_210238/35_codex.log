import re
baseline_path='doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt'
current_path='core/perf/results/multi/report/perf_linux_recv_20260325_072150_codex-iter-20260325q.txt'
keys=[('MULTI_SPOT','wss','64B'),('MULTI_SPOT','wss','256B'),('MULTI_SPOT','wss','65536B'),('MULTI_SPOT','wss','262144B')]
def parse(path):
    rows={}
    pattern=None
    transport=None
    with open(path,encoding='utf-8') as f:
        for line in f:
            m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)',line)
            if m:
                pattern=m.group(1); transport=None; continue
            m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b',line)
            if m and 'Done' not in line:
                transport=m.group(1); continue
            if '|' not in line or pattern is None or transport is None:
                continue
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            if len(cols)<2 or cols[0] in ('Size','----------'):
                continue
            size=cols[0]
            thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
            if thr: rows[(pattern,transport,size)] = float(thr.group(1))
    return rows
b=parse(baseline_path); c=parse(current_path)
for key in keys:
    base=b[key]; cur=c[key]; rel=(cur-base)/base
    print(f'{key[0]},{key[1]},{key[2]},baseline={base:.1f},current={cur:.1f},rel={rel:+.4%}')
