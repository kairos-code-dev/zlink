new file mode 100644
index 0000000000000000000000000000000000000000..88f49fd19555de82b568d37c487e142d371b3fbc
--- /dev/null
+++ b/core/tests/unittest/unittest_spot_data_plane_protocol.cpp
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+
+#include "precompiled.hpp"
+
+#include "services/spot/spot_data_plane_internal.hpp"
+#include "utils/macros.hpp"
+#include "services/spot/spot_runtime.hpp"
+
+#include "unity.h"
+
+#include <string.h>
+
+namespace
+{
+void test_mesh_xsub_monitor_ready_zero_does_not_mark_connected ()
+{
+    zlink::spot_runtime_t runtime (NULL);
+    zlink_monitor_event_t raw;
+    memset (&raw, 0, sizeof (raw));
+    raw.event = ZLINK_EVENT_CONNECTION_READY_CHANGED;
+    raw.value = 0;
+    strncpy (raw.remote_addr, "wss://127.0.0.1:9000", sizeof (raw.remote_addr) - 1);
+
+    bool connected = true;
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::decode_mesh_xsub_monitor_connection_change (
+        raw, &connected));
+    TEST_ASSERT_FALSE (connected);
+
+    zlink::spot_data_plane_protocol_t::sync_mesh_xsub_connected_endpoint (
+      &runtime, raw, connected);
+    TEST_ASSERT_TRUE (runtime.connected_peer_endpoints.empty ());
+    TEST_ASSERT_EQUAL_UINT64 (0, runtime.connected_peer_version.load ());
+}
+
+void test_mesh_xsub_monitor_ready_one_marks_connected ()
+{
+    zlink::spot_runtime_t runtime (NULL);
+    zlink_monitor_event_t raw;
+    memset (&raw, 0, sizeof (raw));
+    raw.event = ZLINK_EVENT_CONNECTION_READY_CHANGED;
+    raw.value = 1;
+    strncpy (raw.remote_addr, "wss://127.0.0.1:9000", sizeof (raw.remote_addr) - 1);
+
+    bool connected = false;
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::decode_mesh_xsub_monitor_connection_change (
+        raw, &connected));
+    TEST_ASSERT_TRUE (connected);
+
+    zlink::spot_data_plane_protocol_t::sync_mesh_xsub_connected_endpoint (
+      &runtime, raw, connected);
+    TEST_ASSERT_EQUAL_UINT (1, runtime.connected_peer_endpoints.size ());
+    TEST_ASSERT_EQUAL_UINT64 (1, runtime.connected_peer_version.load ());
+}
+
+void test_mesh_xsub_monitor_disconnect_clears_connected_peer ()
+{
+    zlink::spot_runtime_t runtime (NULL);
+    zlink_monitor_event_t raw;
+    memset (&raw, 0, sizeof (raw));
+    strncpy (raw.remote_addr, "wss://127.0.0.1:9000", sizeof (raw.remote_addr) - 1);
+
+    raw.event = ZLINK_EVENT_CONNECTION_READY_CHANGED;
+    raw.value = 1;
+    bool connected = false;
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::decode_mesh_xsub_monitor_connection_change (
+        raw, &connected));
+    zlink::spot_data_plane_protocol_t::sync_mesh_xsub_connected_endpoint (
+      &runtime, raw, connected);
+
+    raw.event = ZLINK_EVENT_DISCONNECTED;
+    raw.value = 0;
+    TEST_ASSERT_TRUE (
+      zlink::spot_data_plane_protocol_t::decode_mesh_xsub_monitor_connection_change (
+        raw, &connected));
+    TEST_ASSERT_FALSE (connected);
+
+    zlink::spot_data_plane_protocol_t::sync_mesh_xsub_connected_endpoint (
+      &runtime, raw, connected);
+    TEST_ASSERT_TRUE (runtime.connected_peer_endpoints.empty ());
+    TEST_ASSERT_EQUAL_UINT64 (2, runtime.connected_peer_version.load ());
+}
+}
+
+int main (int argc, char **argv)
+{
+    UNITY_BEGIN ();
+    RUN_TEST (test_mesh_xsub_monitor_ready_zero_does_not_mark_connected);
+    RUN_TEST (test_mesh_xsub_monitor_ready_one_marks_connected);
+    RUN_TEST (test_mesh_xsub_monitor_disconnect_clears_connected_peer);
+    return UNITY_END ();
+}

