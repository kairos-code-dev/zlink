-        send_unregister_ack (router_, sender_id_, 0x01, "foreign provider");
-        return;
-    }
-
-    sit->second.providers.erase (pit);
-    if (sit->second.providers.empty ())
-        _services.erase (sit);
-
-    _list_seq++;
-    send_unregister_ack (router_, sender_id_, 0x00, std::string ());
