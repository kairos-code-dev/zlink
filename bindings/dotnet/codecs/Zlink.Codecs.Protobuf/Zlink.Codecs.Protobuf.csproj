<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>5.3.4</Version>
    <AssemblyName>Zlink.Codecs.Protobuf</AssemblyName>
    <PackageId>Zlink.Codecs.Protobuf</PackageId>
    <Authors>ulalax</Authors>
    <Description>Protobuf codec extensions for zlink .NET bindings</Description>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ulala-x/zlink</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zlink\Zlink.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.29.1" />
  </ItemGroup>
</Project>
