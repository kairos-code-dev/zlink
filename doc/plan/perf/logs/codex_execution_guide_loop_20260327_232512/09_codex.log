inline int begin (zlink_msg_t **parts_out_, size_t *part_count_out_)
{
    if (!parts_out_ || !part_count_out_) {
        errno = EFAULT;
        return -1;
    }

    reset ();
    *parts_out_ = NULL;
    *part_count_out_ = 0;
    return 0;
}

