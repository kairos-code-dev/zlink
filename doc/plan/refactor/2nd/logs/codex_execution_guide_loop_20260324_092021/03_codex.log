--- /dev/null
+++ b/core/src/services/spot/spot_subject_access.hpp
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+
+#ifndef __ZLINK_SPOT_SUBJECT_ACCESS_HPP_INCLUDED__
+#define __ZLINK_SPOT_SUBJECT_ACCESS_HPP_INCLUDED__
+
