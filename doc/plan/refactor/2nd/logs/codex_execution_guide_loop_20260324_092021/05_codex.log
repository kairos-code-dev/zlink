-        }
-    }
-    if (_node) {
-        _node->submit_sub_summary (this, has_filters_after
-                                           ? ZLINK_TOPOLOGY_STATE_READY
-                                           : ZLINK_TOPOLOGY_STATE_CONNECTING,
-                                   0);
-    }
-    mark_subject_lost (subject, NULL);
-    if (first_error != 0) {
-        errno = first_error;
-        return -1;
-    }
-    return 0;
-}
