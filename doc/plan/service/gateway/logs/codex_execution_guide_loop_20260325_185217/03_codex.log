-                        continue;
-                    }
-
-                    GatewayPhaseSendResult sendResult = TryGatewayPhaseSend(
-                        activeSlots, sendPoller, sendPending, msgSize, runId,
-                        phase, ref state, index);
-                    if (sendResult == GatewayPhaseSendResult.Fatal)
