+void test_router_send_rid_mandatory_hwm ()
+{
+    char my_endpoint[MAX_SOCKET_STRING];
+    void *router = test_context_socket (ZLINK_SOCKET_ROUTER);
+
+    int mandatory = 1;
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_set_router_option (
