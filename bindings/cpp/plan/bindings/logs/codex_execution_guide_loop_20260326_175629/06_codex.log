diff --git a/bindings/cpp/samples/common/sample_common.hpp b/bindings/cpp/samples/common/sample_common.hpp
index 8ed4828d955561cfd98bc36114dc8db0b26d566e..89b821d68b4ba977f7b09d7db7b8b26a96431b12
--- a/bindings/cpp/samples/common/sample_common.hpp
+++ b/bindings/cpp/samples/common/sample_common.hpp
@@ -14,6 +14,10 @@
 #include <sstream>
 #include <string>
 
+#if defined(ZLINK_HAVE_WINDOWS)
+#include <process.h>
+#endif
+
 #if !defined(ZLINK_HAVE_WINDOWS)
 #include <arpa/inet.h>
 #include <netinet/in.h>
@@ -39,10 +43,17 @@
 
 inline std::string unique_tcp (const char *base_)
 {
-    static unsigned port = 22500;
+    static unsigned counter = 0;
+    const unsigned pid =
+#if defined(ZLINK_HAVE_WINDOWS)
+      static_cast<unsigned> (_getpid ());
+#else
+      static_cast<unsigned> (getpid ());
+#endif
+    const unsigned port = 30000u + ((pid % 1000u) * 20u) + (++counter);
     std::ostringstream stream;
     (void) base_;
-    stream << "tcp://127.0.0.1:" << ++port;
+    stream << "tcp://127.0.0.1:" << port;
     return stream.str ();
 }
 
