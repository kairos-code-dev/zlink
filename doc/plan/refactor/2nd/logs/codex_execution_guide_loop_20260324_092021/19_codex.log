원래 multi failure surface는 사라졌고, `MULTI_SPOT` full은 now `status=complete`입니다. 이제 baseline exact-compare로 남은 worst tuple을 다시 계산하고, fanout 변경 영향 확인을 위해 single도 한 번 최신값으로 갱신하겠습니다.
exec
/bin/bash -lc "python - <<'PY'
from pathlib import Path
base=Path('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt')
cur=Path('core/perf/results/multi/report/perf_linux_recv_20260324_184116_spot-multi-20260324e.txt')

def parse(p):
    d={}
    for line in p.read_text().splitlines():
        if line.startswith('RESULT,'):
            _,_,pattern,transport,size,metric,value=line.split(',')
            if metric=='throughput':
                d[(pattern,transport,int(size))]=float(value)
    return d
b=parse(base); c=parse(cur)
rows=[]
for k,v in b.items():
    if k[0]"'!='"'MULTI_SPOT':
        continue
    if k not in c:
        rows.append((-9,k,v,float('nan')))
    elif c[k] < v:
        rows.append(((c[k]-v)/v,k,v,c[k]))
rows.sort()
for rel,k,v,cv in rows:
    print(f'{k[0]} {k[1]} {k[2]} baseline={v:.1f} current={cv:.1f} rel={rel:.2%}')
print('count', len(rows))
