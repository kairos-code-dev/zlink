-        }
-    }
-
-    {
-        scoped_lock_t lock (_sync);
-        for (size_t i = 0; i < keys.size (); ++i) {
-            std::map<topology_key_t, topology_summary_t>::iterator it =
-              _summary_store.find (keys[i]);
