   383	{
   384	    if (duration_ <= std::chrono::steady_clock::duration::zero ())
   385	        return true;
   386	
   387	    const auto deadline = std::chrono::steady_clock::now () + duration_;
   388	
   389	    while (std::chrono::steady_clock::now () < deadline) {
   390	        if (!perf_metric::stamp_payload (payload_.data (),
   391	                                         payload_.size (),
   392	                                         k_run_id,
   393	                                         phase_,
   394	                                         msg_size_,
   395	                                         seq_++,
   396	                                         perf_metric::now_us ())) {
   397	            errno = EINVAL;
   398	            return false;
   399	        }
   400	
   401	        zlink::message_t outbound =
   402	          zlink::message_t::from_bytes (payload_.data (), payload_.size ());
   403	        if (!outbound.valid ()) {
   404	            errno = EINVAL;
   405	            return false;
   406	        }
   407	
   408	        const zlink::send_result_t result =
