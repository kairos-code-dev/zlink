-        return false;
-
-    const char *star = strchr (filter_, '*');
-    if (!star) {
-        if (raw_filter_out_)
-            *raw_filter_out_ = std::string (filter_, len);
-        if (is_pattern_out_)
-            *is_pattern_out_ = false;
-        return true;
-    }
-
-    if (star != filter_ + len - 1 || len < 2)
-        return false;
-
-    if (strchr (star + 1, '*'))
-        return false;
-
-    if (raw_filter_out_)
-        *raw_filter_out_ = std::string (filter_, len - 1);
-    if (is_pattern_out_)
