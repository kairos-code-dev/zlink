+      get_socket_int_option (default_sub->poller_socket (), ZLINK_OPT_RCVTIMEO));
+
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_spot_node_destroy (&node_handle));
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_ctx_term (ctx));
