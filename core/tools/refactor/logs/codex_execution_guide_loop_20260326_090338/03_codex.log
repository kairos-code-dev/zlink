+        *adopted_report_dealer_out_ = it->second.dealer;
+        it->second.dealer = NULL;
+    }
+    if (it->second.dealer) {
+        it->second.dealer->close ();
+        it->second.dealer = NULL;
+    }
+    _bootstrap_states.erase (it);
+}
