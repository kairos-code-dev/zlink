-        state.dealer->setsockopt (ZLINK_INTERNAL_OPT_RCVTIMEO, &rcvtimeo_ms,
-                                  sizeof (rcvtimeo_ms));
-        if (state.dealer->connect (registry_endpoint_.c_str ()) != 0) {
-            (void) _lifecycle.close_socket (state.dealer);
-            state.dealer = NULL;
-            return -1;
-        }
-    }
-
-    *dealer_out_ = state.dealer;
-    return 0;
-}
