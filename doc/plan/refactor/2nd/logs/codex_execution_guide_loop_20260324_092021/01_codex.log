+
+#ifndef __ZLINK_DISCOVERY_REGISTRY_QUERY_ACCESS_HPP_INCLUDED__
+#define __ZLINK_DISCOVERY_REGISTRY_QUERY_ACCESS_HPP_INCLUDED__
+
+#include <zlink.h>
+
