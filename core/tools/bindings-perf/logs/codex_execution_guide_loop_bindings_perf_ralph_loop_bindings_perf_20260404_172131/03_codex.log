+                                   const bench_multi_resource_metrics_t &metrics)
+{
+    if (role == "server") {
+        print_server_resource_metrics (lib, pattern, transport, size, metrics);
+        return;
+    }
+    if (role == "client")
+        print_client_resource_metrics (lib, pattern, transport, size, metrics);
 }
 
