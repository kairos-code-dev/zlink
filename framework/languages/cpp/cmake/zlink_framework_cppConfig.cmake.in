@PACKAGE_INIT@

get_filename_component(
  ZLINK_FRAMEWORK_CPP_PACKAGE_PREFIX
  "${CMAKE_CURRENT_LIST_DIR}/../../../"
  ABSOLUTE)

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(nlohmann_json CONFIG)
@ZLINK_HTTP_CLIENT_EXPORT_OPENSSL_DEPENDENCY@
@ZLINK_STREAM_CONNECTOR_EXPORT_MESSAGEPACK_DEPENDENCY@
@ZLINK_STREAM_CONNECTOR_EXPORT_PROTOBUF_DEPENDENCY@

if(NOT TARGET zlink-native)
  if(WIN32)
    add_library(zlink-native SHARED IMPORTED)
    set_target_properties(zlink-native PROPERTIES
      IMPORTED_LOCATION "${ZLINK_FRAMEWORK_CPP_PACKAGE_PREFIX}/bin/zlink.dll")
  elseif(APPLE)
    add_library(zlink-native SHARED IMPORTED)
    set_target_properties(zlink-native PROPERTIES
      IMPORTED_LOCATION "${ZLINK_FRAMEWORK_CPP_PACKAGE_PREFIX}/lib/libzlink.dylib")
  else()
    add_library(zlink-native SHARED IMPORTED)
    set_target_properties(zlink-native PROPERTIES
      IMPORTED_LOCATION "${ZLINK_FRAMEWORK_CPP_PACKAGE_PREFIX}/lib/libzlink.so")
  endif()
endif()
if(NOT TARGET zlink::cpp)
  include("${CMAKE_CURRENT_LIST_DIR}/../zlink_cpp/zlink_cppTargets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/zlink_framework_cppTargets.cmake")
