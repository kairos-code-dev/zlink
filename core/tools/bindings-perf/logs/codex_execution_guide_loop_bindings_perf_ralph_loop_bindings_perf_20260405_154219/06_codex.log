        "PERF_MULTI_DURATION_SECONDS", "PERF_DURATION_SECONDS", 5, 1);
    settings.connect_ready_timeout_ms =
      resolve_multi_int_env_with_fallback (
        "PERF_MULTI_CONNECT_READY_TIMEOUT_MS",
        "PERF_CONNECT_READY_TIMEOUT_MS",
        5000,
