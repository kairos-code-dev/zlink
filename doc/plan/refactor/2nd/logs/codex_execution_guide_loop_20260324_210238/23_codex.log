/bin/bash -lc "python - <<'PY'
import re
baseline_path='doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt'
current_path='core/perf/results/multi/report/perf_linux_recv_20260325_035957_iter-barrier-restore-20260325_035957.txt'

def parse(path):
    rows={}
    pattern=None
    transport=None
    with open(path,encoding='utf-8') as f:
        for line in f:
            m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)',line)
            if m:
                pattern=m.group(1); transport=None; continue
            m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b',line)
            if m and 'Done' not in line:
                transport=m.group(1); continue
            if '|' not in line or pattern is None or transport is None:
                continue
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            if len(cols)<2 or cols[0] in ('Size','----------'):
                continue
            size=cols[0]
            thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
            if thr:
                rows[(pattern,transport,size)] = float(thr.group(1))
    return rows
baseline=parse(baseline_path)
current=parse(current_path)
keys=[k for k in baseline if k[0]=='MULTI_SPOT' and k[1] in ('tls','wss') and k[2] in ('64B','256B','65536B','262144B')]
reg=[]
for k in keys:
    b=baseline[k]; c=current[k]; rel=(c-b)/b
    reg.append((rel,k,b,c))
reg.sort()
for rel,k,b,c in reg:
    print(f\"{k[0]},{k[1]},{k[2]},baseline={b:.1f},current={c:.1f},rel={rel:.2%}\")
