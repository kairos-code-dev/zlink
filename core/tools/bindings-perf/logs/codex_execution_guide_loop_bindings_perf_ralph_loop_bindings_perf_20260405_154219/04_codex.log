            errno = EINVAL;
            return -1;
        }

        item_t *item = new item_t ();
        item->socket_handle = socket_.handle ();
        item->socket = &socket_;
        item->fd = 0;
        item->events = static_cast<short> (events_);
        item->user = user_;
        item->is_socket = true;

        const int rc = zlink_poller_add (
          _poller, socket_.handle (), item, static_cast<short> (events_));
        if (rc != 0)
            delete item;
        if (rc != 0)
            return rc;

        _items.push_back (item);
        return 0;
    }

