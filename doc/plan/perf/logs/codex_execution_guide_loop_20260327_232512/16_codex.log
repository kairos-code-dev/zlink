+                                   size_t routing_id_size_,
+                                   zlink_msg_t *parts_,
+                                   size_t part_count_,
+                                   zlink_send_flags_t flags_)
+{
+    const int type = socket_type (handle_);
+    if (type != ZLINK_CORE_SOCKET_ROUTER) {
+        errno = ENOTSUP;
+        return -1;
+    }
+
+    if (part_count_ == 1) {
+        const int rc = handle_.socket->send_routed_data (
+          routing_id_data_, routing_id_size_,
+          reinterpret_cast<zlink::msg_t *> (&parts_[0]), flags_ & ZLINK_DONTWAIT);
+        if (rc != 0)
+            return -1;
+        errno = 0;
+        return 0;
+    }
+
+    return zlink::logical_multipart_send_routed_data (
+      handle_.socket, routing_id_data_, routing_id_size_, parts_, part_count_,
+      flags_);
