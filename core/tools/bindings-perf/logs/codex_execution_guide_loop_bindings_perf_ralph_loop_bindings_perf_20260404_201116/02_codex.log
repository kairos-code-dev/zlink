   301	class callback_slot_t
   302	{
   303	  public:
   304	    callback_slot_t ()
   305	        : _spot (NULL),
   306	          _active_start_us (NULL),
   307	          _queue (k_callback_queue_capacity),
   308	          _head (0),
   309	          _tail (0),
   310	          _stop (false),
   311	          _failed (false),
   312	          _synced (false),
   313	          _expected_msg_size (0),
   314	          _active_duration_us (0),
   315	          _active_count (0),
   316	          _latency ()
   317	    {
   318	    }
   319	
   320	    ~callback_slot_t () { stop (); }
   321	
   322	    bool attach (zlink::service::spot_t &spot_,
   323	                 std::atomic<uint64_t> *active_start_us_,
   324	                 size_t expected_msg_size_,
   325	                 uint64_t active_duration_us_)
   326	    {
   327	        _spot = &spot_;
   328	        _active_start_us = active_start_us_;
   329	        _expected_msg_size.store (expected_msg_size_, std::memory_order_release);
   330	        _active_duration_us.store (active_duration_us_, std::memory_order_release);
   331	        _active_count.store (0, std::memory_order_release);
   332	        _head.store (0, std::memory_order_release);
   333	        _tail.store (0, std::memory_order_release);
   334	        _stop.store (false, std::memory_order_release);
   335	        _failed.store (false, std::memory_order_release);
   336	        _synced.store (false, std::memory_order_release);
   337	        if (_spot->on_subscribe(&callback_slot_t::handle_subscribe, this) != 0)
   338	            return false;
   339	        _worker = std::thread (&callback_slot_t::worker_loop, this);
   340	        return true;
   341	    }
   342	
   343	    void stop ()
   344	    {
   345	        _stop.store (true, std::memory_order_release);
   346	        if (_worker.joinable ())
   347	            _worker.join ();
   348	        if (_spot)
   349	            (void) _spot->on_subscribe(NULL, NULL);
   350	        _spot = NULL;
   351	    }
   352	
   353	    bool failed () const
   354	    {
   355	        return _failed.load (std::memory_order_acquire);
   356	    }
   357	
   358	    bool synced () const
   359	    {
   360	        return _synced.load (std::memory_order_acquire);
   361	    }
   362	
   363	    unsigned long long active_count () const
   364	    {
   365	        return _active_count.load (std::memory_order_acquire);
   366	    }
   367	
   368	    const perf::multi::bench_latency_sampler_t &latency () const
   369	    {
   370	        return _latency;
   371	    }
   372	
   373	  private:
   374	    static void handle_subscribe (const zlink_routing_id_t *,
   375	                                  const char *topic_,
   376	                                  size_t topic_len_,
   377	                                  zlink_msg_t *parts_,
   378	                                  size_t part_count_,
   379	                                  void *userdata_)
   380	    {
   381	        callback_slot_t *self = static_cast<callback_slot_t *> (userdata_);
   382	        if (!self || !parts_ || part_count_ == 0) {
   383	            if (parts_)
   384	                zlink_multipart_close (parts_, part_count_);
   385	            return;
   386	        }
   387	
   388	        callback_event_t event;
   389	        if (topic_ && topic_len_ == std::strlen (k_topic)
   390	            && std::memcmp (topic_, k_topic, topic_len_) == 0
   391	            && part_count_ == 1) {
   392	            event.received_ts_us = perf_metric::now_us ();
   393	            event.header_ok = perf_metric::decode_payload_header (
   394	              zlink_msg_data (&parts_[0]), zlink_msg_size (&parts_[0]), &event.header);
   395	        }
   396	
   397	        if (!self->push (event))
   398	            self->_failed.store (true, std::memory_order_release);
   399	
   400	        zlink_multipart_close (parts_, part_count_);
   401	    }
   402	
   403	    bool push (const callback_event_t &event_)
   404	    {
   405	        const size_t tail = _tail.load (std::memory_order_relaxed);
   406	        const size_t next = (tail + 1) % _queue.size ();
   407	        if (next == _head.load (std::memory_order_acquire))
   408	            return false;
   409	
   410	        _queue[tail] = event_;
   411	        _tail.store (next, std::memory_order_release);
   412	        return true;
   413	    }
   414	
   415	    void worker_loop ()
   416	    {
   417	        while (!_stop.load (std::memory_order_acquire)
   418	               || _head.load (std::memory_order_acquire)
   419	                    != _tail.load (std::memory_order_acquire)) {
   420	            const size_t head = _head.load (std::memory_order_relaxed);
   421	            if (head == _tail.load (std::memory_order_acquire))
   422	                continue;
   423	
   424	            const callback_event_t event = _queue[head];
   425	            _head.store ((head + 1) % _queue.size (), std::memory_order_release);
   426	
   427	            if (!event.header_ok
   428	                || event.header.msg_size
   429	                     != _expected_msg_size.load (std::memory_order_acquire)) {
   430	                continue;
   431	            }
   432	
   433	            _synced.store (true, std::memory_order_release);
   434	
   435	            if (event.header.phase
   436	                != static_cast<uint32_t> (perf_metric::phase_active)
   437	                || !_active_start_us) {
   438	                continue;
   439	            }
   440	
   441	            uint64_t start = _active_start_us->load (std::memory_order_acquire);
   442	            if (start == 0) {
   443	                const uint64_t candidate = event.received_ts_us;
   444	                (void) _active_start_us->compare_exchange_strong (
   445	                  start, candidate, std::memory_order_acq_rel);
   446	                start = _active_start_us->load (std::memory_order_acquire);
   447	            }
   448	            if (start == 0 || event.received_ts_us < start)
   449	                continue;
   450	
   451	            const uint64_t duration =
   452	              _active_duration_us.load (std::memory_order_acquire);
   453	            if (duration == 0 || event.received_ts_us > start + duration)
   454	                continue;
   455	
   456	            _active_count.fetch_add (1, std::memory_order_acq_rel);
   457	            const double latency_us = event.received_ts_us >= event.header.sent_ts_us
   458	                                        ? static_cast<double> (
   459	                                            event.received_ts_us
   460	                                            - event.header.sent_ts_us)
   461	                                        : 0.0;
   462	            _latency.add (latency_us);
   463	        }
   464	    }
   465	
   466	    zlink::service::spot_t *_spot;
   467	    std::atomic<uint64_t> *_active_start_us;
   468	    std::vector<callback_event_t> _queue;
   469	    std::atomic<size_t> _head;
   470	    std::atomic<size_t> _tail;
   471	    std::atomic<bool> _stop;
   472	    std::atomic<bool> _failed;
   473	    std::atomic<bool> _synced;
   474	    std::atomic<size_t> _expected_msg_size;
   475	    std::atomic<uint64_t> _active_duration_us;
   476	    std::atomic<unsigned long long> _active_count;
   477	    perf::multi::bench_latency_sampler_t _latency;
   478	    std::thread _worker;
   479	};
