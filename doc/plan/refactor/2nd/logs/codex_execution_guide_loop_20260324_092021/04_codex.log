+        case ZLINK_OPT_RCVHWM:
+            return ZLINK_SPOT_SUB_OPT_RCVHWM;
+        case ZLINK_OPT_LINGER:
+            return ZLINK_SPOT_SUB_OPT_LINGER;
+        case ZLINK_OPT_SNDBUF:
+            return ZLINK_SPOT_SUB_OPT_SNDBUF;
+        case ZLINK_OPT_RCVBUF:
