+static int append_frame (std::vector<zlink_msg_t> *frames_, zlink_msg_t *src_)
+{
+    if (!frames_ || !src_) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    frames_->resize (frames_->size () + 1);
+    zlink_msg_t *dst = &frames_->back ();
+    memset (dst, 0, sizeof (zlink_msg_t));
+    msg_t *dst_msg = reinterpret_cast<msg_t *> (dst);
+    if (dst_msg->init () != 0
+        || dst_msg->move (*reinterpret_cast<msg_t *> (src_)) != 0) {
+        zlink_msg_close (dst);
+        frames_->pop_back ();
+        errno = EFAULT;
+        return -1;
+    }
+    return 0;
+}
