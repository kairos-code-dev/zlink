   251	bool publish_control_ready_count (zlink::service::spot_t &control_spot_,
   252	                                  size_t msg_size_,
   253	                                  size_t ready_count_,
   254	                                  int timeout_ms_)
   255	{
   256	    if (msg_size_ == 0 || ready_count_ == 0) {
   257	        errno = EINVAL;
   258	        return false;
   259	    }
   260	
   261	    const std::string payload = std::string ("READY_COUNT,")
   262	                                + std::to_string (msg_size_) + ","
   263	                                + std::to_string (ready_count_);
   264	    const auto deadline = std::chrono::steady_clock::now ()
   265	                          + std::chrono::milliseconds (
   266	                            std::max (1, timeout_ms_));
   267	    while (std::chrono::steady_clock::now () < deadline) {
   268	        zlink::message_t outbound =
   269	          zlink::message_t::from_bytes (payload.data (), payload.size ());
   270	        if (!outbound.valid ()) {
   271	            errno = EINVAL;
   272	            return false;
   273	        }
   274	
   275	        const zlink::send_result_t result =
   276	          control_spot_.try_publish (k_control_topic, outbound);
   277	        if (result == zlink::send_result_t::sent)
   278	            return true;
   279	        if (result != zlink::send_result_t::backpressured
   280	            && result != zlink::send_result_t::not_ready) {
   281	            errno = EFAULT;
   282	            return false;
   283	        }
   284	
   285	        std::this_thread::yield ();
   286	    }
   287	
   288	    errno = ETIMEDOUT;
   289	    return false;
   290	}
