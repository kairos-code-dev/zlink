bool zlink::pipe_t::check_hwm () const
{
    scoped_optional_fast_lock_t lock (
      const_cast<fast_mutex_t *> (&_out_sync));
    const bool full =
      _hwm > 0 && _msgs_written - _peers_msgs_read >= uint64_t (_hwm);
    return !full;
}

