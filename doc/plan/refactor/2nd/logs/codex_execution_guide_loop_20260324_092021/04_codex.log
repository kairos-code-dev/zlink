-
-static bool routing_id_equals (const zlink_routing_id_t &a_,
-                               const zlink_routing_id_t &b_)
-{
-    if (a_.size != b_.size || a_.size == 0)
-        return false;
-    return memcmp (a_.data, b_.data, a_.size) == 0;
