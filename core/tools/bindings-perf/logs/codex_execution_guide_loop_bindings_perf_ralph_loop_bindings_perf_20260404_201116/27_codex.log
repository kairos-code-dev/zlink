            except Exception:
                pass
            wait_sec = shutdown_timeout_ms / 1000.0
            if wait_sec <= 0:
                wait_sec = 0.1
            try:
                server_proc.wait(timeout=wait_sec)
            except subprocess.TimeoutExpired:
                try:
                    server_proc.terminate()
                except Exception:
                    pass
                try:
                    server_proc.wait(timeout=max(1.0, wait_sec))
