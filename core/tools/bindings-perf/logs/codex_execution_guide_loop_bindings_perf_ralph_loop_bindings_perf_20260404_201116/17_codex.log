            (void) slot->spot->set (zlink::socket_options::rcvhwm, _settings.rcvhwm);
            (void) slot->spot->set (zlink::socket_options::rcvtimeo,
                                    _settings.rcvtimeo_ms);

            if (slot->spot->set_subscription (k_topic) != 0)
            {
