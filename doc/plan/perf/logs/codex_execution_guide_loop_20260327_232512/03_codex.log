+        zlink_multipart_close (parts, part_count);
+        TEST_ASSERT_TRUE (parsed);
+        TEST_ASSERT_TRUE (seq >= 0);
+        TEST_ASSERT_TRUE (seq < per_publisher);
+
+        std::vector<bool> *seen = NULL;
