+{
+    return async_mailbox_active.load (std::memory_order_acquire);
+}
+
+bool zlink::socket_lifecycle_coordinator_t::is_async_quiesce_pending () const
+{
+    return async_quiesce_pending.load (std::memory_order_acquire);
+}
