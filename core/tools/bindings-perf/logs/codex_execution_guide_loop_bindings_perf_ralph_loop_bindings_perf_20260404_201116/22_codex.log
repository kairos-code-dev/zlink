struct callback_thread_metrics_t
{
    callback_thread_metrics_t ()
        : owner (NULL),
          registered (false),
          epoch (0),
          active_received (0),
          sample_index (0),
          latency ()
    {
    }

    callback_client_state_t *owner;
    bool registered;
    uint64_t epoch;
    unsigned long long active_received;
    unsigned long long sample_index;
    perf::multi::bench_latency_sampler_t latency;
};

struct callback_client_state_t
{
    callback_client_state_t ()
        : active_start_us (NULL),
          expected_msg_size (0),
          active_duration_us (0),
          collect_active (false),
          fatal (false),
          metrics_epoch (1),
          thread_metrics_mutex (),
          thread_metrics ()
    {
    }

    std::atomic<uint64_t> *active_start_us;
    std::atomic<size_t> expected_msg_size;
    std::atomic<uint64_t> active_duration_us;
    std::atomic<bool> collect_active;
    std::atomic<bool> fatal;
    std::atomic<uint64_t> metrics_epoch;
    std::mutex phase_mutex;
    std::condition_variable phase_cv;
    std::mutex thread_metrics_mutex;
    std::vector<callback_thread_metrics_t *> thread_metrics;
};

static thread_local callback_thread_metrics_t g_callback_thread_metrics;

void reset_callback_thread_metrics (callback_thread_metrics_t *metrics_,
                                    uint64_t epoch_)
{
    if (!metrics_)
        return;

    metrics_->epoch = epoch_;
    metrics_->active_received = 0;
    metrics_->sample_index = 0;
    metrics_->latency = perf::multi::bench_latency_sampler_t ();
}

callback_thread_metrics_t *bind_callback_thread_metrics (
  callback_client_state_t *state_)
{
    if (!state_)
        return NULL;

    callback_thread_metrics_t &metrics = g_callback_thread_metrics;
    if (!metrics.registered || metrics.owner != state_) {
        metrics.owner = state_;
        metrics.registered = true;
        std::lock_guard<std::mutex> lock (state_->thread_metrics_mutex);
        if (std::find (state_->thread_metrics.begin (),
                       state_->thread_metrics.end (),
                       &metrics)
            == state_->thread_metrics.end ()) {
            state_->thread_metrics.push_back (&metrics);
        }
    }

    const uint64_t epoch = state_->metrics_epoch.load (std::memory_order_acquire);
    if (metrics.epoch != epoch)
        reset_callback_thread_metrics (&metrics, epoch);
    return &metrics;
}

void collect_callback_thread_metrics (callback_client_state_t *state_,
                                      unsigned long long *active_received_out_,
                                      perf::multi::bench_latency_stats_t *latency_out_)
{
    if (active_received_out_)
        *active_received_out_ = 0;
    if (latency_out_)
        *latency_out_ = perf::multi::bench_latency_stats_t ();
    if (!state_)
        return;

    perf::multi::bench_latency_sampler_t merged_latency;
    unsigned long long active_received = 0;
    const uint64_t epoch = state_->metrics_epoch.load (std::memory_order_acquire);
    {
        std::lock_guard<std::mutex> lock (state_->thread_metrics_mutex);
        for (size_t i = 0; i < state_->thread_metrics.size (); ++i) {
            callback_thread_metrics_t *metrics = state_->thread_metrics[i];
            if (!metrics || metrics->owner != state_ || metrics->epoch != epoch)
                continue;
            active_received += metrics->active_received;
            merged_latency.merge_from (metrics->latency);
        }
    }

    if (active_received_out_)
        *active_received_out_ = active_received;
    if (latency_out_)
        *latency_out_ = merged_latency.snapshot ();
}

class callback_slot_t
{
  public:
    callback_slot_t () : _spot (NULL), _state (NULL), _synced (false) {}

    bool attach (zlink::service::spot_t &spot_,
                 callback_client_state_t *state_)
    {
        _spot = &spot_;
        _state = state_;
        _synced.store (false, std::memory_order_release);
        return _spot->on_subscribe (&callback_slot_t::handle_subscribe, this) == 0;
    }

    void stop ()
    {
        if (_spot)
            (void) _spot->on_subscribe (NULL, NULL);
        _spot = NULL;
        _state = NULL;
    }

    bool synced () const
    {
        return _synced.load (std::memory_order_acquire);
    }

  private:
    static void handle_subscribe (const zlink_routing_id_t *,
                                  const char *topic_,
                                  size_t topic_len_,
                                  zlink_msg_t *parts_,
                                  size_t part_count_,
                                  void *userdata_)
    {
        callback_slot_t *self = static_cast<callback_slot_t *> (userdata_);
        if (!self || !parts_ || part_count_ == 0) {
            if (parts_)
                zlink_multipart_close (parts_, part_count_);
            return;
        }

        if (!topic_ || topic_len_ != k_topic_len
            || std::memcmp (topic_, k_topic, k_topic_len) != 0
            || part_count_ != 1) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        perf_metric::header_t header;
        const bool header_ok = perf_metric::decode_payload_header (
          zlink_msg_data (&parts_[0]), zlink_msg_size (&parts_[0]), &header);
        if (!header_ok) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        callback_client_state_t *state = self->_state;
        if (!state) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        const size_t expected_msg_size =
          state->expected_msg_size.load (std::memory_order_acquire);
        if (header.msg_size != static_cast<uint32_t> (expected_msg_size)) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        if (!self->_synced.load (std::memory_order_relaxed))
            self->_synced.store (true, std::memory_order_release);
        if (!state->collect_active.load (std::memory_order_acquire)
            || header.phase
                 != static_cast<uint32_t> (perf_metric::phase_active)
            || !state->active_start_us) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        const uint64_t received_ts_us = perf_metric::now_us ();
        uint64_t start = state->active_start_us->load (std::memory_order_acquire);
        bool notify_phase = false;
        if (start == 0) {
            const uint64_t candidate = received_ts_us;
            (void) state->active_start_us->compare_exchange_strong (
              start, candidate, std::memory_order_acq_rel);
            start = state->active_start_us->load (std::memory_order_acquire);
            notify_phase = (start != 0);
        }
        if (start == 0 || received_ts_us < start) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        const uint64_t duration =
          state->active_duration_us.load (std::memory_order_acquire);
        if (duration == 0 || received_ts_us > start + duration) {
            zlink_multipart_close (parts_, part_count_);
            return;
        }

        callback_thread_metrics_t *metrics = bind_callback_thread_metrics (state);
        if (metrics) {
            ++metrics->active_received;
            if (should_sample_spot_latency (++metrics->sample_index)) {
                const double latency_us =
                  received_ts_us >= header.sent_ts_us
                    ? static_cast<double> (received_ts_us - header.sent_ts_us)
                    : 0.0;
                metrics->latency.add (latency_us);
            }
        }

        if (notify_phase)
            state->phase_cv.notify_all ();

        zlink_multipart_close (parts_, part_count_);
    }

    zlink::service::spot_t *_spot;
    callback_client_state_t *_state;
    std::atomic<bool> _synced;
};

