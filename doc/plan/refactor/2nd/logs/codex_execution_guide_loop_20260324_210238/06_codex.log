-    entry.endpoint = endpoint;
-    entry.routing_id = sender_id_;
-    entry.weight = weight;
-    entry.registered_at = now;
-    entry.last_heartbeat = now;
-    entry.source_registry = _registry_id;
-
-    _list_seq++;
-    send_register_ack (router_, sender_id_, 0x00, endpoint, std::string ());
