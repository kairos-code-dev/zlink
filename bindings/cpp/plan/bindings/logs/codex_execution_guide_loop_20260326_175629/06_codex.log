+    zlink::socket_t server(ctx, zlink::socket_type::pair);
     server.bind("tcp://*:5555");
 
-    // PAIR 클라이언트
-    zlink::socket_t client(ctx, ZLINK_PAIR);
+    zlink::socket_t client(ctx, zlink::socket_type::pair);
     client.connect("tcp://127.0.0.1:5555");
 
