-        if (it != _bootstrap_states.end ()) {
-            if (it->second.dealer
-                && uplink_endpoint == registry_endpoint_
-                && _report_dealers.find (uplink_endpoint)
-                     == _report_dealers.end ()) {
-                _report_dealers[uplink_endpoint] = it->second.dealer;
-                it->second.dealer = NULL;
-            }
