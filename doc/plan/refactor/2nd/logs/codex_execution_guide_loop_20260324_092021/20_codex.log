std::string spot_node_t::first_connected_peer_endpoint () const
{
    scoped_lock_t lock (const_cast<mutex_t &> (_sync));
    if (_connected_peer_endpoints.empty ())
        return std::string ();
    return *_connected_peer_endpoints.begin ();
}

