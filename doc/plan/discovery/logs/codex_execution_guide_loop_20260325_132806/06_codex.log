+    TEST_ASSERT_EQUAL_INT (EFSM, zlink_errno ());
+    TEST_ASSERT_EQUAL_INT (-1, zlink_unbind (router, bind_ep));
+    TEST_ASSERT_EQUAL_INT (EFSM, zlink_errno ());
