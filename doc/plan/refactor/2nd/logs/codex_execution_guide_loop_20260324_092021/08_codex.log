/bin/bash -lc "python - <<'PY'
import re
from pathlib import Path
baseline_path = Path('doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt')
current_path = Path('core/perf/results/single/report/perf_linux_callback_20260324_120711_final-single.txt')

def parse(path):
    rows = {}
    pattern = None
    transport = None
    for line in path.read_text(encoding='utf-8').splitlines():
        m = re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
        if m:
            pattern = m.group(1)
            transport = None
            continue
        m = re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
        if m and 'Done' not in line:
            transport = m.group(1)
            continue
        if '|' not in line or pattern is None or transport is None:
            continue
        cols = [c.strip() for c in line.strip().strip('|').split('|')]
        if len(cols) < 2 or cols[0] in ('Size', '----------'):
            continue
        size = cols[0].replace('B','')
        tp = cols[1].replace('Kmsg/s','').replace('msg/s','').replace(',','').strip()
        if not tp:
            continue
        try:
            value = float(tp)
        except ValueError:
            continue
        if 'Kmsg/s' in cols[1]:
            value *= 1000.0
        rows[(pattern, transport, size)] = value
    return rows

base = parse(baseline_path)
cur = parse(current_path)
missing = sorted(set(base) - set(cur))
extra = sorted(set(cur) - set(base))
reg = []
pass_count = 0
for key, b in base.items():
    c = cur.get(key)
    if c is None:
        continue
    delta = (c - b) / b
    if c >= b:
        pass_count += 1
    else:
        reg.append((delta, key, b, c))
reg.sort(key=lambda x: (x[0], -int(x[1][2]), x[1][0]), reverse=False)
print(f'baseline_rows={len(base)} current_rows={len(cur)} missing={len(missing)} extra={len(extra)} pass={pass_count} regressions={len(reg)}')
for delta, key, b, c in reg[:20]:
    pattern, transport, size = key
    print(f'{pattern:15s} {transport:6s} {size:>6s}B baseline={b:.1f} current={c:.1f} delta={delta:.4%}')
if missing:
    print('MISSING:')
    for key in missing[:20]:
        print(key)
