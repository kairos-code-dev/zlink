                                    * 0.5
                                : 0.0;
                            latency.add (latency_us);
                        }
                    }

                    if (std::chrono::steady_clock::now () >= deadline)
                        continue;

                    if (!state->send_pending) {
                        if (!try_send_request (*state, phase))
                            return false;
                    }
