import re
from pathlib import Path
single_base = Path('doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt')
single_cur = Path('core/perf/results/single/report/perf_linux_callback_20260324_152439_spot-single-recheck.txt')
multi_base = Path('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt')
multi_cur = Path('core/perf/results/multi/report/perf_linux_recv_20260324_152028_spot-multi-recheck.txt')

def parse(path):
    rows = {}
    pattern = None
    transport = None
    for line in path.read_text(encoding='utf-8').splitlines():
        m = re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
        if m:
            pattern = m.group(1); transport = None; continue
        m = re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
        if m and 'Done' not in line:
            transport = m.group(1); continue
        if '|' not in line or pattern is None or transport is None:
            continue
        cols = [c.strip() for c in line.strip().strip('|').split('|')]
        if len(cols) < 2 or cols[0] in ('Size', '----------'):
            continue
        try:
            size = int(cols[0])
            throughput = float(cols[-1])
        except ValueError:
            continue
        rows[(pattern, transport, size)] = throughput
    return rows
for name, base_path, cur_path in [('single', single_base, single_cur), ('multi', multi_base, multi_cur)]:
    base = parse(base_path); cur = parse(cur_path)
    missing = sorted(set(base)-set(cur))
    print(name, 'missing', len(missing))
    worst = []
    for key, b in base.items():
        c = cur.get(key)
        if c is None:
            continue
        rel = (c-b)/b if b else 0.0
        if rel < 0:
            worst.append((rel, key, b, c))
    worst.sort()
    print(name, 'regressions', len(worst))
    for rel, key, b, c in worst[:12]:
        print(f'{key[0]} {key[1]} {key[2]} base={b:.1f} cur={c:.1f} rel={rel:.2%}')
    print()
