// Write certificate to temp file and return path
inline std::string write_temp_cert(const char* content, const std::string& suffix) {
    std::string path = "/tmp/bench_" + suffix + ".pem";
    std::ofstream ofs(path);
    if (ofs) {
        ofs << content;
        ofs.close();
    }
    return path;
