+    const int socket_option = map_sub_to_socket_option (option_);
+    if (socket_option < 0) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    if (zlink::spot_sub_t *sub = as_spot_sub_side_handle (handle_)) {
+        zlink::socket_base_t *socket = sub->poller_socket ();
+        if (!socket) {
+            errno = EFAULT;
+            return -1;
