-
-    int socket_option = -1;
-    switch (option_) {
-        case ZLINK_SPOT_SUB_OPT_RCVHWM:
-            socket_option = ZLINK_INTERNAL_OPT_RCVHWM;
-            break;
-        case ZLINK_SPOT_SUB_OPT_LINGER:
-            socket_option = ZLINK_INTERNAL_OPT_LINGER;
