            try:
                size_int = int(size_value)
            except (TypeError, ValueError):
                return
            if size_int <= 0 or size_int in queue_probe_requested_sizes:
                return
            try:
                if server_proc.stdin:
                    server_proc.stdin.write(f"QUEUE,{size_int}\n")
