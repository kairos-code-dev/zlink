+            int(option),
+            ctypes.c_void_p(
+                ptr if isinstance(ptr, int) else ctypes.cast(ptr, ctypes.c_void_p).value or 0
+            ),
+            size,
+        )
+        _ = keepalive
+        if rc != 0:
+            _raise_last_error()
