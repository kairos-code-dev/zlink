    native_.resize (parts_.size ());

    size_t moved = 0;
    for (; moved < parts_.size (); ++moved) {
        if (!parts_[moved].valid ()) {
            errno = EINVAL;
            break;
        }
        if (parts_[moved].move_to (&native_[moved]) != 0)
            break;
    }

    if (moved == parts_.size ())
