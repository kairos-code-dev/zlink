+        if (!admission.acquired ())
+            return -1;
+        zlink::spot_pub_t *pub = ensure_spot_pub (spot);
+        if (!pub) {
+            errno = ENOTSUP;
+            return -1;
+        }
+        return pub->set_option (ZLINK_SPOT_PUB_OPT_NODROP, optval_, optvallen_);
+    }
