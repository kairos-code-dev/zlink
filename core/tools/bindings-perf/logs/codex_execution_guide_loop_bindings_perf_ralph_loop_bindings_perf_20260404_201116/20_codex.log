    ZLINK_CPP_NODISCARD int
    subscribe_impl (std::vector<message_t> &parts_,
                    std::string &topic_,
                    recv_flag flags_ = recv_flag::none,
                    routing_id_t *source_rid_out_ = NULL,
               size_t *topic_len_out_ = NULL,
