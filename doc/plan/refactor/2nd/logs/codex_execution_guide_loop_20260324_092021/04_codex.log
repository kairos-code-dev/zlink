@@ -65,5 +132,6 @@
 
     UNITY_BEGIN ();
     RUN_TEST (test_spot_subject_access_resolves_composite_and_node_poller_sockets);
+    RUN_TEST (test_spot_subject_access_routes_subscription_and_routing_state);
     return UNITY_END ();
 }
