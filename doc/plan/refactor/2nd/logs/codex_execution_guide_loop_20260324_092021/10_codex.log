+std::string capture_debug_text (process_capture_t *proc_)
+{
+    if (!proc_)
+        return std::string ();
+
+    std::lock_guard<std::mutex> lock (proc_->sync);
+    std::string text;
+    text.reserve (proc_->stderr_text.size () + 256);
