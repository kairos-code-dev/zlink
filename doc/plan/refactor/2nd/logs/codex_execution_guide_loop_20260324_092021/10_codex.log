void zlink::socket_base_t::set_all_pipes_nodelay ()
{
    for (pipes_t::size_type i = 0, size = _pipes.size (); i != size; ++i) {
        if (_pipes[i])
            _pipes[i]->set_nodelay ();
    }
}
