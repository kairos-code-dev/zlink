+{
+    return gateway_ ? gateway_->update_peer_weight (routing_id_, weight_) : -1;
+}
+
+int gateway_access_t::destroy (gateway_t *gateway_)
+{
+    return gateway_ ? gateway_->destroy () : -1;
+}
+
+int gateway_access_t::send (gateway_t *gateway_,
