+    topics_size = sizeof (topics_count);
+    TEST_ASSERT_SUCCESS_ERRNO (spot_subject_get_sub_option (
+      handle->sub, ZLINK_SUB_OPT_TOPICS_COUNT, &topics_count, &topics_size));
+    TEST_ASSERT_EQUAL_INT (0, topics_count);
+
