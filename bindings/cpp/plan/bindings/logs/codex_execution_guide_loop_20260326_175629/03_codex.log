+/* SPDX-License-Identifier: MPL-2.0 */
+
+#include "support.hpp"
+
+namespace {
+
+void test_socket_monitor_open_recv_snapshot ()
+{
+    zlink::context_t ctx;
+    zlink::socket_t server (ctx, zlink::socket_type::pair);
+
+    zlink::monitor_handle_t monitor (server, zlink::monitor_event::all);
+    assert (monitor.valid ());
+
+    const std::string endpoint =
+      zlink_cpp_contract::unique_inproc ("monitor-pair");
+    assert (server.bind (endpoint) == 0);
+
+    assert (zlink_cpp_contract::wait_for_monitor_readable (monitor.handle (), 2000));
+    zlink_socket_monitor_event_t event;
+    assert (monitor.recv (event) == 0);
+
+    zlink_monitor_snapshot_t snapshot;
+    assert (monitor.snapshot (snapshot) == 0);
+}
+
+void test_service_monitor_open_snapshot ()
+{
+    zlink::context_t ctx;
+    zlink::service::spot_t spot (ctx);
+    assert (spot.valid ());
+
+    zlink::service_monitor_handle_t monitor (spot);
+    assert (monitor.valid ());
+
+    zlink_monitor_snapshot_t snapshot;
+    assert (monitor.snapshot (snapshot) == 0);
+}
+
+} // namespace
+
+int main ()
+{
+    test_socket_monitor_open_recv_snapshot ();
+    test_service_monitor_open_snapshot ();
+    return 0;
+}
diff --git a/bindings/cpp/tests/contract/test_cpp_contract_options.cpp b/bindings/cpp/tests/contract/test_cpp_contract_options.cpp
