-ctest --test-dir bindings/cpp/build --output-on-failure -L contract
-ctest --test-dir bindings/cpp/build --output-on-failure -L sample-smoke
+ctest --test-dir core/build --output-on-failure -L contract
+ctest --test-dir core/build --output-on-failure -L sample-smoke -j1
 ```
 
