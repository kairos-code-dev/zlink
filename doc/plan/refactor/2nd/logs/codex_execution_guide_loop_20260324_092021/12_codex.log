    b=parse(base_path); c=parse(cur_path)
    reg=[]
    for k,v in b.items():
        if k in c and k[0]==prefix:
            rel=(c[k]-v)/v
            if rel<0:
                reg.append((rel,k,v,c[k]))
    reg.sort()
    print(label, len(reg))
    for rel,k,bv,cv in reg[:6]:
        print(k[1], k[2], bv, cv, rel)
