+    std::vector<registered_service_t> services;
+    std::vector<unsigned char> metadata;
+    int64_t value = 0;
+    {
+        scoped_lock_t lock (_sync);
+        if (size_ > _metadata_max_size) {
+            errno = EMSGSIZE;
+            return -1;
