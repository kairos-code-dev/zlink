+        server->stop ();
+        server->close ();
+    }
+
+    if (!ctx_)
+        return;
+
+    const uint64_t deadline_ms =
+      timeout_ms_ >= 0 ? zlink::clock_t ().now_ms () + timeout_ms_ : 0;
