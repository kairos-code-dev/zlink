 }
 
+void zlink::dist_t::distribute_prechecked (msg_t *msg_)
+{
+    if (_matching == 0) {
+        int rc = msg_->close ();
+        errno_assert (rc == 0);
+        rc = msg_->init ();
+        errno_assert (rc == 0);
+        return;
+    }
+
+    if (_matching == 1 && _active == 1 && _eligible == 1) {
+        (void) write_at_no_hwm_check (0, msg_);
+        const int rc = msg_->init ();
+        errno_assert (rc == 0);
+        return;
+    }
+
+    if (msg_->is_vsm ()) {
+        for (pipes_t::size_type i = 0; i < _matching;) {
+            if (!write_at_no_hwm_check (i, msg_)) {
+                //  Use same index again because entry will have been removed.
+            } else {
+                ++i;
+            }
+        }
+        const int rc = msg_->init ();
+        errno_assert (rc == 0);
+        return;
+    }
+
+    msg_->add_refs (static_cast<int> (_matching) - 1);
+
+    int failed = 0;
+    for (pipes_t::size_type i = 0; i < _matching;) {
+        if (!write_at_no_hwm_check (i, msg_)) {
+            ++failed;
+        } else {
+            ++i;
+        }
+    }
+    if (unlikely (failed))
+        msg_->rm_refs (failed);
+
+    const int rc = msg_->init ();
+    errno_assert (rc == 0);
+}
