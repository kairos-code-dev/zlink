+    for (size_t i = 0; i < moved; ++i) {
+        if (parts_[i].init () == 0)
+            (void) zlink_msg_move (parts_[i].handle (), &native_[i]);
+        (void) zlink_msg_close (&native_[i]);
+    }
+
+    native_.clear ();
+    return -1;
+}
+
+inline int assign_parts_from_native (zlink_msg_t *parts_native_,
+                                     size_t part_count_,
+                                     std::vector<message_t> &parts_)
+{
