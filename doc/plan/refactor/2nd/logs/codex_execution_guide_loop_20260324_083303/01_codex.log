+      zlink::option_owner_of (ZLINK_INTERNAL_OPT_TLS_CERT));
+#endif
+
+    TEST_ASSERT_EQUAL_INT (
+      zlink::options_owner_service_specific,
+      zlink::option_owner_of (ZLINK_INTERNAL_OPT_TOPICS_COUNT));
+    TEST_ASSERT_EQUAL_INT (
