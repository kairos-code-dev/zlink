        errno = 0;
        TEST_ASSERT_FALSE (coordinator.begin_close_or_fail_busy (false));
        TEST_ASSERT_EQUAL_INT (EBUSY, errno);
    }

    errno = 0;
    TEST_ASSERT_TRUE (coordinator.begin_close_or_fail_busy (false));
