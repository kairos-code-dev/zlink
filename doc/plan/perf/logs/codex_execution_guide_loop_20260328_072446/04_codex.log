+zlink::dist_t::send_to_single_matching_pipe_nodrop (msg_t *msg_)
+{
+    zlink_assert (_matching == 1);
+
+    pipe_t *pipe = _pipes[0];
+    const bool more = (msg_->flags () & msg_t::more) != 0;
+    const pipe_write_status_t status =
+      more ? pipe->write_check_hwm_once (msg_)
+           : pipe->write_and_flush_check_hwm_once (msg_);
+
+    if (status == pipe_write_hwm_full)
+        return status;
+
+    if (status == pipe_write_inactive)
+        deactivate_matching_pipe (0);
+
+    if (!more)
+        _active = _eligible;
+
+    _more = more;
+
+    const int rc = msg_->init ();
+    errno_assert (rc == 0);
+    return pipe_write_ready;
+}
