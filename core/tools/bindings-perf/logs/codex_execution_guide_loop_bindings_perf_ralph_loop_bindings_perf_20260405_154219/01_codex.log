        long wait_ms =
          _settings.client_poll_timeout_ms > 0 ? _settings.client_poll_timeout_ms : 100;
        const long remain_ms = std::chrono::duration_cast<std::chrono::milliseconds> (
                                 deadline - now)
                                 .count ();
        if (remain_ms < wait_ms)
            wait_ms = remain_ms;
        if (wait_ms < 1)
            wait_ms = 1;
        return wait_ms;
    }

