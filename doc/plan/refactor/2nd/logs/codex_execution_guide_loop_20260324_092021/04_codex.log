+            errno = EFAULT;
+            return -1;
+        }
+        return sub->poller_socket ()->getsockopt (socket_option, optval_,
+                                                  optvallen_);
+    }
+
+    if (is_registered_spot_node_handle (handle_)) {
+        zlink::spot_node_t *node = static_cast<zlink::spot_node_t *> (handle_);
