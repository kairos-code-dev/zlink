+    @classmethod
+    def _from_handle(cls, handle, own=False):
+        obj = cls.__new__(cls)
+        obj._init_from_native_handle(
+            handle,
+            own=own,
+            socket_type=cls._resolve_socket_type(None),
+        )
+        return obj
