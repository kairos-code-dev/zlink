index 2a36a1102a0bc33946603216c0ac2765b8d6eddb..d484cf7796a865049cf258bcfc37da0cecf326de
--- a/core/src/services/spot/spot_subject_access.cpp
+++ b/core/src/services/spot/spot_subject_access.cpp
@@ -6,7 +6,11 @@
 
 #include "api/service_api_internal.hpp"
 
+#include <algorithm>
 #include <map>
+#include <string>
+#include <string.h>
