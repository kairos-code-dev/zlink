+        zlink::destroy_spot_handle_for_testing (it->second);
+    }
+    g_spot_handles.clear ();
+}
+
+void destroy_default_spot_handle (void *node_)
+{
+    std::lock_guard<std::mutex> lock (g_spot_handle_mutex);
