+int zlink::dist_t::send_to_matching_prechecked (msg_t *msg_)
+{
+    const bool msg_more = (msg_->flags () & msg_t::more) != 0;
+
+    distribute_prechecked (msg_);
+
+    if (!msg_more)
+        _active = _eligible;
+
+    _more = msg_more;
+
+    return 0;
+}
