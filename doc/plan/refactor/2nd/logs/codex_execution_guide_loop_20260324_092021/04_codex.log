+int spot_subject_subscription_at (void *handle_,
+                                  size_t index_,
+                                  char *filter_out_,
+                                  size_t *filter_len_inout_,
+                                  int *is_pattern_out_)
+{
+    std::vector<zlink::spot_sub_t::subject_descriptor_t> subjects;
+    if (append_subscription_subjects (handle_, &subjects) != 0)
+        return -1;
+
