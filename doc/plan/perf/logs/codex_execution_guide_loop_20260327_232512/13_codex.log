namespace zlink
{
struct scoped_fast_lock_t
{
    scoped_fast_lock_t (fast_mutex_t &mutex_) : _mutex (mutex_)
    {
        _mutex.lock ();
    }

    ~scoped_fast_lock_t () { _mutex.unlock (); }

  private:
    fast_mutex_t &_mutex;

    ZLINK_NON_COPYABLE_NOR_MOVABLE (scoped_fast_lock_t)
