diff --git a/bindings/node/src/buffer_like.js b/bindings/node/src/buffer_like.js
new file mode 100644
index 0000000000000000000000000000000000000000..000e625fa6ae4e9dd7a21242ce97a4a317bc42e3
--- /dev/null
+++ b/bindings/node/src/buffer_like.js
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: MPL-2.0
+
+'use strict';
+
+function normalizeBufferLike(value, label = 'value') {
+  if (Buffer.isBuffer(value)) return value;
+  if (value instanceof Uint8Array) {
+    return Buffer.from(value.buffer, value.byteOffset, value.byteLength);
+  }
+  if (typeof value === 'string') return Buffer.from(value);
+  throw new TypeError(`${label} must be Buffer, Uint8Array, or string`);
+}
+
+module.exports = {
+  normalizeBufferLike
+};
