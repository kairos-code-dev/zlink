-    }
-
-    private static void registerReceiverWithRetry(Receiver receiver,
-                                                  String serviceName,
-                                                  String endpoint) {
-        receiver.register(serviceName, endpoint, 1);
-    }
-
-    private static void applyReceiverOptions(Receiver receiver) {
