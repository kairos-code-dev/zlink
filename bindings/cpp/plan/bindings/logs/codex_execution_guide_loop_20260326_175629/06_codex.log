diff --git a/doc/bindings/cpp.ko.md b/doc/bindings/cpp.ko.md
index d46e8cf94e6e5f5db035c06525429104634fd321..f26357d6b391223172001f0f91602e80bd1cba48
--- a/doc/bindings/cpp.ko.md
