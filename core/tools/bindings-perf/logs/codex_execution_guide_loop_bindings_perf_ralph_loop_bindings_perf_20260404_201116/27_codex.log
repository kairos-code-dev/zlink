    bool set_pollout (socket_state_t &state, bool enabled)
    {
        if (!state.sock)
            return false;
        if (state.pollout_enabled == enabled)
            return true;

        const zlink::poll_event events =
          enabled ? (zlink::poll_event::pollin | zlink::poll_event::pollout)
                  : zlink::poll_event::pollin;
        if (_poller.modify (*state.sock, events) != 0)
            return false;
        state.pollout_enabled = enabled;
        return true;
    }

    bool try_send_request (socket_state_t &state, perf_metric::phase_t phase)
    {
        if (!state.sock || state.request_buffer.empty ())
            return false;

        const uint64_t sent_ts = perf_metric::now_us ();
        if (!perf_metric::stamp_payload (&state.request_buffer[0],
                                         state.request_buffer.size (),
                                         _run_id,
                                         phase,
                                         _msg_size,
                                         _seq++,
                                         sent_ts)) {
            return false;
        }

        zlink_msg_t request;
        if (zlink_msg_init_data (&request,
                                 &state.request_buffer[0],
                                 state.request_buffer.size (),
                                 NULL,
                                 NULL)
            != 0) {
            return false;
        }

        const int sent =
          zlink_send (state.sock->handle (), &request, 1, ZLINK_DONTWAIT);
        if (sent == 0) {
            state.awaiting_reply = true;
            state.send_pending = false;
            return set_pollout (state, false);
        }

        const int err = errno;
        (void) zlink_msg_close (&request);
        if (sent < 0 && err == EAGAIN) {
            state.send_pending = true;
            errno = err;
            return set_pollout (state, true);
        }

        errno = err;
        return false;
    }

    int recv_reply (socket_state_t &state, perf_metric::header_t *header_out)
    {
        if (!state.sock || !header_out) {
            errno = EINVAL;
            return -1;
        }

        zlink_msg_t *parts = NULL;
        size_t part_count = 0;
        const int rc = zlink_recv (
          state.sock->handle (), NULL, &parts, &part_count, ZLINK_DONTWAIT);
        if (rc != 0)
            return -1;

        if (part_count == 0 || !parts) {
            zlink_multipart_close (parts, part_count);
            errno = EPROTO;
            return -1;
        }

        const bool decoded = perf_metric::decode_payload_header (
          zlink_msg_data (&parts[0]), zlink_msg_size (&parts[0]), header_out);
        zlink_multipart_close (parts, part_count);
        if (!decoded)
            return 1;
        return 0;
    }

