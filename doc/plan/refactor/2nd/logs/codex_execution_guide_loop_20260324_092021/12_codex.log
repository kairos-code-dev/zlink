def parse_result_data(path):
    rows = {}
    for line in Path(path).read_text(encoding='utf-8').splitlines():
        if not line.startswith('RESULT,'):
            continue
        parts = line.split(',')
        if len(parts) < 7:
            continue
        _, _, pattern, transport, size, metric, value = parts[:7]
        if metric "'!= '"'throughput':
            continue
        rows[(pattern, transport, int(size))] = float(value)
    return rows
for label, baseline, current in [
    ('single', 'doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt', 'core/perf/results/single/report/perf_linux_callback_20260324_152439_spot-single-recheck.txt'),
    ('multi', 'doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt', 'core/perf/results/multi/report/perf_linux_recv_20260324_152028_spot-multi-recheck.txt')]:
