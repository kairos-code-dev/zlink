def parse(path):
    rows = {}
    for line in Path(path).read_text(encoding='utf-8').splitlines():
        if not line.startswith('RESULT,'):
            continue
        p=line.split(',')
        if len(p) < 7 or p[5] "'!= '"'throughput':
            continue
        rows[(p[2], p[3], int(p[4]))]=float(p[6])
    return rows
