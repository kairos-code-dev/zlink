                if ((worker_->events[static_cast<size_t> (i)].revents
                     & static_cast<short> (zlink::poll_event::pollin))
                    == 0) {
                    continue;
                }

                client_slot_t *slot = static_cast<client_slot_t *> (
                  worker_->events[static_cast<size_t> (i)].user);
                if (!slot || !slot->owner)
