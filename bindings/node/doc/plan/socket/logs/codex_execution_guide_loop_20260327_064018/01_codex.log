+  }
+}
+
+class StreamSocket extends DuplexSocket {
+  constructor(ctx) {
+    super(ctx, SocketType.STREAM);
+  }
+}
+
+class SubSocket extends SubscriberSocket {
+  constructor(ctx) {
+    super(ctx, SocketType.SUB);
+  }
+}
+
+class XSubSocket extends SubscriberSocket {
+  constructor(ctx) {
+    super(ctx, SocketType.XSUB);
+  }
+}
+
+module.exports = {
