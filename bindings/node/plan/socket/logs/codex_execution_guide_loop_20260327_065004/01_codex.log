+void collect_stream_payload_unsafe(stream_js_state_t *state,
+                                   const zlink_routing_id_t *rid,
+                                   zlink_msg_t *msg,
+                                   stream_js_payload_t *payload)
+{
+    if (!state || !msg || !payload)
+        return;
+
+    if (rid && rid->size > 0)
+        payload->routing_id.assign(rid->data, rid->data + rid->size);
+
