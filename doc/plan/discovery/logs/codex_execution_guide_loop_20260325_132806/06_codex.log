+int socket_discovery_attachment_t::attach_validation (
+  discovery_t *discovery_,
+  uint16_t *local_role_out_,
+  std::string *bound_endpoint_out_)
+{
+    if (!discovery_
+        || discovery_->service_type () != discovery_protocol::service_type_socket) {
+        errno = EINVAL;
+        return -1;
