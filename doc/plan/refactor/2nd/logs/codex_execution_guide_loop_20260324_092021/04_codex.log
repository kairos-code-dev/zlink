+    const int pub_option = map_common_to_spot_pub_option (option_);
+    const int sub_option = map_common_to_spot_sub_option (option_);
+    if (socket_option < 0 || (pub_option < 0 && sub_option < 0)) {
+        errno = EINVAL;
+        return -1;
