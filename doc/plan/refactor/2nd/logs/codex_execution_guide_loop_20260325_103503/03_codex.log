+
+    scoped_lock_t lock (_sync);
+    if (_default_sub == created_sub_)
+        _default_sub = previous_default_sub_;
+
+    if (_internal_receiver && _internal_receiver != receiver_) {
+        _default_sub_fast.store (_default_sub, std::memory_order_release);
