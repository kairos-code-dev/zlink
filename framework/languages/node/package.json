{
  "name": "@zlink-systems/node-framework-workspace",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "description": "ZLink Framework Node.js/NestJS port workspace",
  "scripts": {
    "clean": "rm -rf dist packages/*/dist",
    "build": "node ../../../bindings/node/node_modules/typescript/bin/tsc -b tsconfig.build.json",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"samples/**/*.ts\"",
    "typecheck": "node ../../../bindings/node/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run_node_runtime_gate.js",
    "verify:p0": "node scripts/run_node_runtime_gate.js",
    "verify:coverage": "node scripts/run_node_coverage_gate.js",
    "verify:samples": "./samples/run_samples.sh",
    "verify:runtime-matrix": "node scripts/verify_node_runtime_matrix.js",
    "verify:abi-matrix": "node scripts/verify_node_abi_matrix.js",
    "verify:cross-language": "./cross-language/run_cross_language_smoke.sh",
    "verify:release": "npm run verify:abi-matrix && npm run verify:p0 && npm run verify:samples && npm run verify:runtime-matrix && npm run verify:cross-language"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.15.30",
    "eslint": "^10.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "6.27.0"
  }
}
