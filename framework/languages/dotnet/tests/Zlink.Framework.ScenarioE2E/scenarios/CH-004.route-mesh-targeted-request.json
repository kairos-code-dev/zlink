{
  "id": "CH-004",
  "name": "route mesh targeted request reaches only target routing id",
  "roles": {
    "registry": {
      "count": 0
    },
    "server": [
      {
        "name": "peer-b",
        "channel": "scenario-api"
      },
      {
        "name": "peer-c",
        "channel": "scenario-api"
      }
    ],
    "client": [
      {
        "name": "peer-a",
        "routingId": "peer-a"
      }
    ]
  },
  "steps": [
    {
      "waitReady": {
        "targets": [
          "server:peer-b",
          "server:peer-c"
        ]
      }
    },
    {
      "routeTargetedRequest": {
        "client": "peer-a",
        "channel": "scenario-api",
        "packetName": "ScenarioRoutePing",
        "targetRid": "peer-b",
        "nonTargetRid": "peer-c",
        "sourceRid": "peer-a",
        "missingRid": "peer-missing",
        "missingTimeoutMs": 100,
        "requestId": "ch-004-target-1",
        "value": "ping",
        "expectReply": "route:ping"
      }
    }
  ],
  "expect": {
    "reply": {
      "requestId": "ch-004-target-1",
      "value": "route:ping"
    },
    "serverEvidence": {
      "routeRequestIds": [
        "ch-004-target-1"
      ],
      "routeSourceRids": [
        "peer-a"
      ]
    }
  },
  "artifacts": {
    "logs": "logs",
    "report": "report.json",
    "evidence": "servers:/evidence"
  }
}
