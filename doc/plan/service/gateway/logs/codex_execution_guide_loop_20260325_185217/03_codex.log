ROOT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

BINDING="${ZLINK_PERF_BINDING:-}"
if [[ -z "${BINDING}" ]]; then
  echo "Error: ZLINK_PERF_BINDING is required." >&2
  exit 1
