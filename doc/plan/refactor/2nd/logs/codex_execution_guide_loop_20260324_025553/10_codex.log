+            continue;
+
+        const int remaining_ms =
+          timeout_ms_ < 0
+            ? -1
+            : static_cast<int> (deadline_ms - zlink::clock_t ().now_ms ());
+        if (timeout_ms_ >= 0 && remaining_ms <= 0)
+            break;
+
+        (void) ctx_->wait_for_socket_removal (server, remaining_ms);
+    }
