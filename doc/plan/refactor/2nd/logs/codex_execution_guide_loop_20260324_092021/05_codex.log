+int spot_sub_t::subscribe (const char *topic_)
+{
+    socket_base_t *socket = this->socket ();
+    if (!_node || !socket) {
+        errno = EFAULT;
+        return -1;
+    }
+    std::string topic;
+    if (!is_valid_topic (topic_, &topic)) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (_node->ensure_healthy () != 0)
+        return -1;
