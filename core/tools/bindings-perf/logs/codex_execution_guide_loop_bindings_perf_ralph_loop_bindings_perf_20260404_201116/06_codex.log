+            recv_worker_t &worker = _recv_workers[i];
+            if (worker.slots.empty ())
+                continue;
+            worker.events.resize (worker.slots.size ());
+            worker.thread = std::thread (&spot_client_bench_t::recv_worker_loop,
+                                         &worker);
+        }
