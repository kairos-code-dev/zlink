{
  public:
    socket_guard_t () : _sock () {}
    socket_guard_t (ctx_guard_t &ctx, zlink::socket_type type) : _sock (ctx.ctx (), type)
    {
    }

    perf_socket_t &sock () { return _sock; }
    bool valid () const { return _sock.handle () != NULL; }

  private:
    perf_socket_t _sock;
};

