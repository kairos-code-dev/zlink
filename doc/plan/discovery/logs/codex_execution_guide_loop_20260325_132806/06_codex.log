+{
+    TEST_ASSERT_NOT_NULL (parts_);
+    TEST_ASSERT_EQUAL_UINT64 (1, part_count_);
+    TEST_ASSERT_EQUAL_UINT64 (strlen (expected_), zlink_msg_size (&parts_[0]));
+    TEST_ASSERT_EQUAL_MEMORY (expected_, zlink_msg_data (&parts_[0]),
+                              strlen (expected_));
+}
