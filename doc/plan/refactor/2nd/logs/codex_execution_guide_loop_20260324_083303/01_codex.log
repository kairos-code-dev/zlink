+                                       zlink_gateway_status_t *out_)
+{
+    if (!gateway_) {
+        errno = EFAULT;
+        return -1;
+    }
+    service_public_api_scope_t admission (gateway_->public_api_guard ());
+    if (!admission.acquired ())
+        return -1;
+    return gateway_->snapshot_status (out_);
