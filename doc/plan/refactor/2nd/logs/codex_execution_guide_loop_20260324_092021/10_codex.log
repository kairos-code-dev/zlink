/bin/bash -lc "python - <<'PY'
import re
from pathlib import Path
baseline = Path('doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt')
current = Path('core/perf/results/single/report/perf_linux_callback_20260324_150030_spot-single-recheck.txt')
pat = re.compile(r'"'^RESULT,(?:baseline|current),([''^,]+),([''^,]+),('"\\d+),throughput,([0-9.]+)"'$'"')

def parse(path):
    rows = {}
    for line in path.read_text(encoding='utf-8').splitlines():
        m = pat.match(line.strip())
        if not m:
            continue
        pattern, transport, size, value = m.groups()
        rows[(pattern, transport, int(size))] = float(value)
    return rows
b = parse(baseline)
c = parse(current)
rows=[]
for k,v in sorted(c.items()):
    if k[0] "'!= '"'SPOT':
        continue
    bv = b.get(k)
    if bv is None:
        continue
    ratio = (v-bv)/bv
    rows.append((ratio,k,bv,v))
rows.sort()
for ratio,k,bv,v in rows:
    print(f\"{k[0]},{k[1]},{k[2]} baseline={bv:.1f} current={v:.1f} ratio={ratio:.4%}\")
