uint32_t zlink::xsub_t::compute_delivery_ready_count () const
{
#ifdef ZLINK_USE_RADIX_TREE
    const bool has_filters = _subscriptions.size () > 0;
#else
    const bool has_filters = _subscriptions.num_prefixes () > 0;
#endif
    if (!has_filters)
        return 0;
