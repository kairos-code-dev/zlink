            : 0.0;
        slot->latency.add(latency_us);
    }

    if (slot->send_enabled && slot->auto_send_on_recv) {
        const send_status_t send_rc = send_router_request(slot);
        if (send_rc == send_error)
            return recv_status_fatal;
    }

    return recv_status_processed;
}

