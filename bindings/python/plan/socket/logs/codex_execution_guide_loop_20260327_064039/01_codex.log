+                    xpub.set_pub_option(0x3301, (1).to_bytes(4, "little"))
+                    xpub.bind(endpoint)
+                    xsub.connect(endpoint)
+                    xsub.subscribe(b"topic")
+
+                    event = xpub.subscription_event()
+                    self.assertTrue(event["subscribed"])
+                    self.assertEqual(event["topic"], b"topic")
