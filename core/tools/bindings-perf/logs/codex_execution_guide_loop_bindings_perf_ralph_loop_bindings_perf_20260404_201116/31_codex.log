    perf_multi_metric::phase_t phase;
};

struct dealer_client_state_t
{
    dealer_client_state_t() :
        poller(NULL),
        collect_active(false),
        active_run_id(0),
        active_msg_size(0),
        active_received(0),
        fatal(false),
