+          pub->node ()->public_api_guard ());
+        if (!admission.acquired ())
+            return -1;
+    }
+    void *subject = spot_pub_;
+    if (pub->is_node_owned_default () && pub->node ())
+        subject = pub->node ();
+    return pub->set_send_ready_handler (handler_, subject, userdata_);
