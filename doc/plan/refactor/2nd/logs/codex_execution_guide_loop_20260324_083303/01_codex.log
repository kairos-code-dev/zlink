+int gateway_access_t::send_rid (gateway_t *gateway_,
+                                const zlink_routing_id_t *routing_id_,
+                                zlink_msg_t *parts_,
+                                size_t part_count_,
+                                zlink_send_flags_t flags_)
+{
+    return gateway_
+             ? gateway_->send_rid (routing_id_, parts_, part_count_, flags_)
+             : -1;
+}
