+    if (lhs_.routing_id.size != rhs_.routing_id.size)
+        return lhs_.routing_id.size < rhs_.routing_id.size;
+    if (lhs_.routing_id.size == 0)
+        return false;
+    return memcmp (lhs_.routing_id.data, rhs_.routing_id.data,
+                   lhs_.routing_id.size)
+           < 0;
