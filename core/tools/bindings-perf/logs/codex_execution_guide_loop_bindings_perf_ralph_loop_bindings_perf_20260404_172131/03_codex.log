        _phase_cfg.settle_ms = std::max (0, _settings.settle_ms);
        _phase_cfg.active_seconds = std::max (1, _settings.duration_seconds);
    }

    bool run ()
    {
        if (!setup_sockets ())
            return false;

        std::cout << "CLIENT_READY," << _msg_size << std::endl;
        perf::multi::settle ();

        if (!run_warmup ())
            return false;
        if (!run_settle ())
            return false;
        if (!run_active ())
            return false;

        if (_result.active_count == 0) {
            _failure_stage = "no_active_data";
            return false;
        }

        print_result ();
        std::cout << "CLIENT_DONE," << _msg_size << std::endl;
