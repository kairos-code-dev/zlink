{
  "id": "CH-007",
  "name": "request timeout does not poison following request",
  "roles": {
    "registry": {
      "count": 0
    },
    "server": [
      {
        "name": "api-a",
        "channel": "scenario.api"
      }
    ],
    "client": [
      {
        "name": "client-a"
      }
    ]
  },
  "steps": [
    {
      "waitReady": {
        "target": "server:api-a"
      }
    },
    {
      "clientTimeoutRequest": {
        "client": "client-a",
        "channel": "scenario.api",
        "packetName": "ScenarioProfileRequest",
        "requestId": "ch-007-timeout-1",
        "value": "slow",
        "timeoutMs": 300,
        "expectError": "timeout"
      }
    },
    {
      "concurrentTimeoutAndRequest": {
        "client": "client-a",
        "channel": "scenario.api",
        "packetName": "ScenarioProfileRequest",
        "timeoutRequestId": "ch-007-concurrent-timeout-1",
        "timeoutValue": "slow",
        "timeoutMs": 300,
        "requestId": "ch-007-concurrent-ok-1",
        "value": "concurrent-ok",
        "expectReply": "profile:concurrent-ok",
        "requestDelayMs": 100,
        "expectError": "timeout"
      }
    },
    {
      "clientRequest": {
        "client": "client-a",
        "channel": "scenario.api",
        "packetName": "ScenarioProfileRequest",
        "requestId": "ch-007-after-timeout-1",
        "value": "after-timeout",
        "expectReply": "profile:after-timeout"
      }
    },
    {
      "waitFor": {
        "milliseconds": 1200
      }
    },
    {
      "clientRequest": {
        "client": "client-a",
        "channel": "scenario.api",
        "packetName": "ScenarioProfileRequest",
        "requestId": "ch-007-after-late-reply-1",
        "value": "after-late-reply",
        "expectReply": "profile:after-late-reply"
      }
    },
    {
      "assertEvidence": {
        "target": "server:api-a",
        "requestId": "ch-007-timeout-1"
      }
    }
  ],
  "expect": {
    "reply": {
      "requestId": "ch-007-after-late-reply-1",
      "value": "profile:after-late-reply"
    },
    "serverEvidence": {
      "requestIds": [
        "ch-007-timeout-1",
        "ch-007-concurrent-timeout-1",
        "ch-007-concurrent-ok-1",
        "ch-007-after-timeout-1",
        "ch-007-after-late-reply-1"
      ]
    }
  },
  "artifacts": {
    "logs": "logs",
    "report": "report.json",
    "evidence": "server:/evidence"
  }
}
