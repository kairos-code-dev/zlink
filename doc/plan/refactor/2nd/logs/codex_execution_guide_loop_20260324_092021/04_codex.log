+        if (!admission.acquired ())
+            return -1;
+        if (pub_option >= 0) {
+            zlink::spot_pub_t *pub = node->ensure_default_pub ();
+            if (!pub || !pub->poller_socket ()) {
+                errno = EFAULT;
+                return -1;
