diff --git a/doc/internal/hot-path.ko.md b/doc/internal/hot-path.ko.md
index 7d9b2f19c17f4d40f0cd0f9f3f2235dbc8ad141d..46307bdbcd0650f23bcfe8b6a319b169f00b06fd
--- a/doc/internal/hot-path.ko.md
