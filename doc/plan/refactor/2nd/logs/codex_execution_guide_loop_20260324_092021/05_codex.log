-                                   const char *topic_,
-                                   size_t topic_len_,
-                                   zlink_msg_t *parts_,
-                                   size_t part_count_,
-                                   void *userdata_)
-{
-    spot_sub_t *self = static_cast<spot_sub_t *> (userdata_);
-    if (!self) {
-        close_parts (parts_, part_count_);
-        return;
-    }
-
-    if (may_be_ready_probe_topic (topic_, topic_len_)) {
-        std::string raw_filter;
-        std::string peer_endpoint;
