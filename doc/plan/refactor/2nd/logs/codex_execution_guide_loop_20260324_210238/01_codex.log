+int zlink::socket_lifecycle_coordinator_t::start_async_mailbox_processing (
+  mailbox_t *mailbox_,
+  io_thread_t *io_thread_,
+  mailbox_t::mailbox_handler_t handler_,
+  void *handler_arg_,
+  mailbox_t::mailbox_pre_post_t pre_post_)
+{
