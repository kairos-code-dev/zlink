+        scoped_lock_t lock (_sync);
+        had_filters = !_topics.empty () || !_patterns.empty ();
+        lock_routing_id ();
+        if (socket->setsockopt (ZLINK_INTERNAL_OPT_SUBSCRIBE, topic.data (),
+                                topic.size ())
+            != 0)
