<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ZLinkFrameworkTargetFrameworks)</TargetFrameworks>
        <AssemblyName>Zlink.HttpClient</AssemblyName>
        <RootNamespace>Zlink.HttpClient</RootNamespace>
        <Description>ZLink-style fluent HTTP client wrapping System.Net.Http for the ZLink framework.</Description>
        <Version>0.2.0</Version>
        <IsPackable>true</IsPackable>
        <!-- Consumers own their Zlink.Framework reference (the framework is never snapshot-
             pinned), so the local package declares no dependencies. -->
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Zlink.Framework/Zlink.Framework.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Zlink.HttpClient.UnitTests"/>
    </ItemGroup>
</Project>
