paths=[
('before','core/perf/results/multi/report/perf_linux_recv_20260325_033602_residual-reentry-20260325-iter-current.txt'),
('after','core/perf/results/multi/report/perf_linux_recv_20260325_034057_residual-reentry-20260325-iter-sticky.txt'),
]

def parse(path):
    rows={}
    pattern=None
    transport=None
    with open(path, encoding='utf-8') as f:
        for line in f:
            m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
            if m:
                pattern=m.group(1); transport=None; continue
            m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
            if m and 'Done' not in line:
                transport=m.group(1); continue
            if '|' not in line or pattern is None or transport is None:
                continue
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            if len(cols)<2 or cols[0] in ('Size','----------'):
                continue
            size=cols[0]
            thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
            if thr:
                rows[(pattern,transport,size)] = float(thr.group(1))
    return rows
baseline=parse(baseline_path)
parsed={name:parse(path) for name,path in paths}
keys=[k for k in baseline if k[0]=='MULTI_SPOT' and k[1] in ('tls','wss') and k[2] in ('64B','256B','65536B','262144B')]
for key in keys:
    b=baseline[key]
    vals=[]
    for name,_ in paths:
        c=parsed[name][key]
        vals.append(f\"{name}={c:.1f}({(c-b)/b:+.2%})\")
    print(f\"{key[1]} {key[2]} baseline={b:.1f} \" + ' '.join(vals))
print('worst before=', min(((parsed['before'][k]-baseline[k])/baseline[k],k) for k in keys))
print('worst after=', min(((parsed['after'][k]-baseline[k])/baseline[k],k) for k in keys))
