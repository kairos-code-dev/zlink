from pathlib import Path

def parse(path):
    rows = {}
    for line in Path(path).read_text(encoding='utf-8').splitlines():
        if not line.startswith('RESULT,'):
            continue
        parts = line.split(',')
        if len(parts) < 7 or parts[5] "'!= '"'throughput':
            continue
        rows[(parts[2], parts[3], int(parts[4]))] = float(parts[6])
    return rows
