     }
 
-    for (size_t i = 0; i < stale_servers.size (); ++i) {
-        socket_base_t *server = stale_servers[i];
-        if (!server)
-            continue;
-        if (_ctx)
-            (void) _ctx->close_socket_and_wait (server, 2000);
-        else {
-            server->stop ();
-            server->close ();
-        }
-    }
+    close_monitor_servers (NULL, stale_servers, 0);
 }
 
