+                  duration_seconds_);
+        common_env.push_back (buf);
+    }
+    {
+        char buf[32];
+        snprintf (buf, sizeof (buf), "PERF_WARMUP_SECONDS=%d",
+                  warmup_seconds_);
+        common_env.push_back (buf);
+    }
+    common_env.push_back ("PERF_SETTLE_MS=500");
+    {
+        char buf[32];
+        snprintf (buf, sizeof (buf), "PERF_CLIENTS=%d", clients_);
