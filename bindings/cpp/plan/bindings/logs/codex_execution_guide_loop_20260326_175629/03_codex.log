+inline int move_parts_to_native (std::vector<message_t> &parts_,
+                                 std::vector<zlink_msg_t> &native_)
+{
+    native_.clear ();
+    native_.resize (parts_.size ());
+
+    size_t moved = 0;
+    for (; moved < parts_.size (); ++moved) {
+        if (!parts_[moved].valid ()) {
