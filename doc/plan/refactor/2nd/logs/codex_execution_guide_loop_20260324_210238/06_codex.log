diff --git a/core/src/services/spot/spot_subject_query.cpp b/core/src/services/spot/spot_subject_query.cpp
index a36f223673718ba61e1f303805a0b4ed0c548a57..93ed3519679308f4b16edb1df360822f54a713a6
--- a/core/src/services/spot/spot_subject_query.cpp
