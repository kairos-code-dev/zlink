   112	    }
   113	
   114	    ~pending_stream_message_t ()
   115	    {
   116	        reset ();
   117	        zlink_msg_close (&payload);
   118	    }
   119	
   120	    void reset ()
   121	    {
   122	        if (has_payload) {
   123	            zlink_msg_close (&payload);
   124	            zlink_msg_init (&payload);
   125	            has_payload = false;
   126	        }
   127	        rid.size = 0;
   128	    }
   129	
   130	    bool move_from (pending_stream_message_t *other)
   131	    {
   132	        if (!other)
   133	            return false;
   134	        reset ();
   135	        rid = other->rid;
   136	        if (other->has_payload) {
   137	            if (zlink_msg_move (&payload, &other->payload) != 0) {
   138	                rid.size = 0;
   139	                return false;
   140	            }
   141	            has_payload = true;
   142	        }
   143	        other->rid.size = 0;
   144	        other->has_payload = false;
   145	        return true;
   146	    }
   147	
   148	  private:
