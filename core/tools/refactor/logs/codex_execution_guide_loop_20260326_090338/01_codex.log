+                        &metadata_limit, sizeof (metadata_limit)));
+    metadata_limit = 0;
+    TEST_ASSERT_SUCCESS_ERRNO (
+      zlink_get_option (discovery, ZLINK_OPT_DISCOVERY_METADATA_MAX_SIZE,
+                        &metadata_limit, &size));
+    TEST_ASSERT_EQUAL_UINT (91, (unsigned int) metadata_limit);
