+        if (zlink_msg_move (tmp[i].handle (), &parts_native_[i]) != 0) {
+            close_message_array (parts_native_, part_count_);
+            return -1;
+        }
+    }
+
+    std::free (parts_native_);
+    parts_.swap (tmp);
+    return 0;
