+                    &source_rid,
+                    &parts,
+                    &part_count,
+                    ZLINK_DONTWAIT)
+        != 0) {
+        return false;
+    }
+
+    if (!parts || part_count != 1 || zlink_msg_size (&parts[0]) != state.payload_size) {
+        zlink_multipart_close (parts, part_count);
+        errno = EPROTO;
+        return false;
+    }
+
+    state.awaiting_reply = false;
+    if (same_routing_id (source_rid, server_rid)
+        && perf_metric::decode_payload_header (
+          zlink_msg_data (&parts[0]), zlink_msg_size (&parts[0]), header_out)) {
+        if (matched_out)
+            *matched_out = true;
+    }
+    zlink_multipart_close (parts, part_count);
+    return true;
