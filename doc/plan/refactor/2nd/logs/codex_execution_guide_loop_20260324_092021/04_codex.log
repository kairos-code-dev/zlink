+    if (!is_valid_pubsub_filter (filter_, &raw_filter, &is_pattern)
+        || raw_filter.empty ()) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    if (zlink::spot_sub_t *sub = as_spot_sub_side_handle (handle_)) {
+        if (sub->node ()) {
+            zlink::service_public_api_scope_t admission (
