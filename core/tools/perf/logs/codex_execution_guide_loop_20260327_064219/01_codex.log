+                else
+                    *rc_out_ = -1;
+            }
+            return true;
+        }
+        msleep (10);
+    }
+
+    return false;
+}
+
+std::string capture_debug_text (process_capture_t *proc_)
+{
+    if (!proc_)
+        return std::string ();
