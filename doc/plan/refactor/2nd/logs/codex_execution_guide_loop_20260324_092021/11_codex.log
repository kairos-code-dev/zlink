exec
/bin/bash -lc "python3 - <<'PY'
import re
from pathlib import Path
baseline=Path('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt')
current=Path('core/perf/results/multi/report/perf_linux_recv_20260324_152028_spot-multi-recheck.txt')

def parse(path):
    rows={}
    pattern=None; transport=None
    with path.open(encoding='utf-8') as f:
        for line in f:
            m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
            if m:
                pattern=m.group(1); transport=None; continue
            m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
            if m and 'Done' not in line:
                transport=m.group(1); continue
            if '|' not in line or pattern is None or transport is None:
                continue
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            if len(cols) < 2 or cols[0] in ('Size','----------'):
                continue
            size=cols[0]
            thr=cols[1].replace('Kmsg/s','').replace('Mmsg/s','')
            mult=1000.0 if 'Kmsg/s' in cols[1] else 1000000.0 if 'Mmsg/s' in cols[1] else 1.0
            try:
                value=float(thr.replace(',',''))*mult
            except ValueError:
                continue
            rows[(pattern,transport,size)]=value
    return rows

b=parse(baseline)
c=parse(current)
keys=[k for k in sorted(b) if k[0]=='MULTI_SPOT']
missing=[]; regress=[]; improved=[]
for k in keys:
    if k not in c:
        missing.append(k)
        continue
    delta=(c[k]-b[k])/b[k]
    if delta < 0:
        regress.append((delta,k,b[k],c[k]))
    else:
        improved.append((delta,k,b[k],c[k]))
print('missing', len(missing))
print('regressions', len(regress))
for delta,k,bv,cv in sorted(regress)[:20]:
    print(f'{k}: {bv:.1f} -> {cv:.1f} ({delta*100:.2f}%)')
print('best improvements')
for delta,k,bv,cv in sorted(improved, reverse=True)[:10]:
    print(f'{k}: {bv:.1f} -> {cv:.1f} ({delta*100:.2f}%)')
