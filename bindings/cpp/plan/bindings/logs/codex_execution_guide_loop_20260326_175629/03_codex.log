    }

    ZLINK_CPP_NODISCARD int set_routing_id (const void *data_, size_t size_)
    {
        return zlink_set_routing_id (_spot, data_, size_);
    }

    ZLINK_CPP_NODISCARD int set_routing_id (const std::string &data_)
