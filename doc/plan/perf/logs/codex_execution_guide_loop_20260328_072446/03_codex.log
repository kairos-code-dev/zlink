diff --git a/core/tests/integration/test_pubsub_nodrop_single_subscriber.cpp b/core/tests/integration/test_pubsub_nodrop_single_subscriber.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f929fd89daa6c81395c5d364e7fbfa2b72d852fd
--- /dev/null
+++ b/core/tests/integration/test_pubsub_nodrop_single_subscriber.cpp
@@ -0,0 +1,284 @@
+/* SPDX-License-Identifier: MPL-2.0 */
+
+#include "testutil.hpp"
+#include "testutil_unity.hpp"
+
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+SETUP_TEARDOWN_TESTCONTEXT
+
+namespace
+{
+const int kPubsubSocketHwm = 32;
+const int kPubSendTimeoutMs = 0;
+const int kSubReceiveTimeoutMs = 2000;
+const int kReadyTimeoutMs = 5000;
+const int kTargetMessages = 512;
+const size_t kPayloadSize = 64;
+
+struct delivery_ready_state_t
+{
+    delivery_ready_state_t () : ready (false), error_code (0) {}
+
+    std::mutex sync;
+    std::condition_variable cv;
+    bool ready;
+    int error_code;
+};
+
+struct delivery_ready_monitor_t
+{
+    delivery_ready_monitor_t () : monitor (NULL), state (NULL) {}
+
+    void *monitor;
+    delivery_ready_state_t *state;
+};
+
+void delivery_ready_monitor_handler (const zlink_monitor_event_t *event_,
+                                     void *userdata_)
+{
+    delivery_ready_state_t *state =
+      static_cast<delivery_ready_state_t *> (userdata_);
+    if (!state || !event_)
+        return;
+
+    std::unique_lock<std::mutex> lock (state->sync);
+    switch (event_->event) {
+        case ZLINK_EVENT_PUB_DELIVERY_READY_CHANGED:
+        case ZLINK_EVENT_SUB_DELIVERY_READY_CHANGED:
+            if (event_->value > 0)
+                state->ready = true;
+            break;
+        case ZLINK_EVENT_BIND_FAILED:
+        case ZLINK_EVENT_ACCEPT_FAILED:
+        case ZLINK_EVENT_CLOSE_FAILED:
+        case ZLINK_EVENT_HANDSHAKE_FAILED_NO_DETAIL:
+        case ZLINK_EVENT_HANDSHAKE_FAILED_PROTOCOL:
+        case ZLINK_EVENT_HANDSHAKE_FAILED_AUTH:
+            if (state->error_code == 0) {
+                state->error_code =
+                  event_->value != 0 ? static_cast<int> (event_->value) : EIO;
+            }
+            break;
+        default:
+            break;
+    }
+    lock.unlock ();
+    state->cv.notify_all ();
+}
+
+bool open_delivery_ready_monitor (void *socket_,
+                                  uint64_t event_,
+                                  delivery_ready_monitor_t *out_)
+{
+    if (!socket_ || !out_)
+        return false;
+
+    delivery_ready_state_t *state = new (std::nothrow) delivery_ready_state_t;
+    if (!state)
+        return false;
+
+    zlink_socket_monitor_open_options_t opts;
+    memset (&opts, 0, sizeof (opts));
+    opts.events = event_ | ZLINK_EVENT_BIND_FAILED | ZLINK_EVENT_ACCEPT_FAILED
+                  | ZLINK_EVENT_CLOSE_FAILED
+                  | ZLINK_EVENT_HANDSHAKE_FAILED_NO_DETAIL
+                  | ZLINK_EVENT_HANDSHAKE_FAILED_PROTOCOL
+                  | ZLINK_EVENT_HANDSHAKE_FAILED_AUTH;
+    void *monitor = zlink_socket_monitor_open (socket_, &opts);
+    if (!monitor
+        || zlink_socket_monitor_handler (
+             monitor, &delivery_ready_monitor_handler, state)
+             != 0) {
+        if (monitor)
+            (void) zlink_monitor_close (&monitor);
+        delete state;
+        return false;
+    }
+
+    out_->monitor = monitor;
+    out_->state = state;
+    return true;
+}
+
+bool wait_delivery_ready (delivery_ready_monitor_t *monitor_, int timeout_ms_)
+{
+    if (!monitor_ || !monitor_->state)
+        return false;
+
+    delivery_ready_state_t *state = monitor_->state;
+    std::unique_lock<std::mutex> lock (state->sync);
+    if (state->error_code != 0)
+        return false;
+    if (state->ready)
+        return true;
+
+    const bool signaled = state->cv.wait_for (
+      lock, std::chrono::milliseconds (timeout_ms_ > 0 ? timeout_ms_ : 1),
+      [state] () { return state->error_code != 0 || state->ready; });
+    return signaled && state->error_code == 0 && state->ready;
+}
+
+void close_delivery_ready_monitor (delivery_ready_monitor_t *monitor_)
+{
+    if (!monitor_)
+        return;
+
+    void *monitor = monitor_->monitor;
+    delivery_ready_state_t *state = monitor_->state;
+    if (monitor)
+        (void) zlink_monitor_close (&monitor);
+    delete state;
+    monitor_->monitor = NULL;
+    monitor_->state = NULL;
+}
+
+void configure_pubsub_hwm (void *socket_)
+{
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_set_option (
+      socket_, ZLINK_OPT_SNDHWM, &kPubsubSocketHwm, sizeof (kPubsubSocketHwm)));
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_set_option (
+      socket_, ZLINK_OPT_RCVHWM, &kPubsubSocketHwm, sizeof (kPubsubSocketHwm)));
+}
+
+std::string make_payload (int seq_)
+{
+    char prefix[32];
+    const int len =
+      std::snprintf (prefix, sizeof (prefix), "payload-%06d", seq_);
+    TEST_ASSERT_TRUE (len > 0);
+
+    std::string payload (prefix, static_cast<size_t> (len));
+    if (payload.size () < kPayloadSize)
+        payload.append (kPayloadSize - payload.size (), '#');
+    return payload;
+}
+
+std::string make_warmup_payload ()
+{
+    std::string payload ("warmup");
+    if (payload.size () < kPayloadSize)
+        payload.append (kPayloadSize - payload.size (), '!');
+    return payload;
+}
+
+int publish_payload (void *pub_, const std::string &payload_)
+{
+    zlink_msg_t part;
+    TEST_ASSERT_SUCCESS_ERRNO (
+      zlink_msg_init_size (&part, payload_.size ()));
+    memcpy (zlink_msg_data (&part), payload_.data (), payload_.size ());
+    return zlink_publish (pub_, NULL, &part, 1, 0);
+}
+
+void recv_payload_expect_body (void *sub_, const std::string &payload_)
+{
+    zlink_msg_t *parts = NULL;
+    size_t part_count = 0;
+
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_recv (sub_, NULL, &parts, &part_count, 0));
+    TEST_ASSERT_EQUAL_UINT64 (1, part_count);
+    TEST_ASSERT_NOT_NULL (parts);
+    TEST_ASSERT_EQUAL_UINT64 (payload_.size (), zlink_msg_size (&parts[0]));
+    TEST_ASSERT_EQUAL_MEMORY (payload_.data (), zlink_msg_data (&parts[0]),
+                              payload_.size ());
+    zlink_multipart_close (parts, part_count);
+}
+
+void run_pubsub_nodrop_transport (const char *endpoint_,
+                                  bool bind_loopback_)
+{
+    void *pub = test_context_socket (ZLINK_SOCKET_PUB);
+    void *sub = test_context_socket (ZLINK_SOCKET_SUB);
+
+    configure_pubsub_hwm (pub);
+    configure_pubsub_hwm (sub);
+
+    const int nodrop = 1;
+    TEST_ASSERT_SUCCESS_ERRNO (
+      zlink_set_pub_option (pub, ZLINK_PUB_OPT_NODROP, &nodrop, sizeof (nodrop)));
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_set_option (
+      pub, ZLINK_OPT_SNDTIMEO, &kPubSendTimeoutMs, sizeof (kPubSendTimeoutMs)));
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_set_option (
+      sub, ZLINK_OPT_RCVTIMEO, &kSubReceiveTimeoutMs,
+      sizeof (kSubReceiveTimeoutMs)));
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_set_subscription (sub, ""));
+
+    delivery_ready_monitor_t pub_monitor;
+    delivery_ready_monitor_t sub_monitor;
+    TEST_ASSERT_TRUE (open_delivery_ready_monitor (
+      pub, ZLINK_EVENT_PUB_DELIVERY_READY_CHANGED, &pub_monitor));
+    TEST_ASSERT_TRUE (open_delivery_ready_monitor (
+      sub, ZLINK_EVENT_SUB_DELIVERY_READY_CHANGED, &sub_monitor));
+
+    char endpoint[MAX_SOCKET_STRING];
+    if (bind_loopback_) {
+        bind_loopback_ipv4 (pub, endpoint, sizeof (endpoint));
+    } else {
+        TEST_ASSERT_SUCCESS_ERRNO (zlink_bind (pub, endpoint_));
+        std::snprintf (endpoint, sizeof (endpoint), "%s", endpoint_);
+    }
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_connect (sub, endpoint));
+
+    TEST_ASSERT_TRUE (wait_delivery_ready (&pub_monitor, kReadyTimeoutMs));
+    TEST_ASSERT_TRUE (wait_delivery_ready (&sub_monitor, kReadyTimeoutMs));
+
+    const std::string warmup_payload = make_warmup_payload ();
+    TEST_ASSERT_SUCCESS_ERRNO (publish_payload (pub, warmup_payload));
+    recv_payload_expect_body (sub, warmup_payload);
+
+    int sent = 0;
+    int received = 0;
+    while (sent < kTargetMessages) {
+        const std::string payload = make_payload (sent);
+        const int rc = publish_payload (pub, payload);
+        if (rc == 0) {
+            ++sent;
+            continue;
+        }
+
+        TEST_ASSERT_EQUAL_INT (EAGAIN, errno);
+        recv_payload_expect_body (sub, make_payload (received));
+        ++received;
+    }
+
+    while (received < sent) {
+        recv_payload_expect_body (sub, make_payload (received));
+        ++received;
+    }
+
+    TEST_ASSERT_EQUAL_INT (kTargetMessages, sent);
+    TEST_ASSERT_EQUAL_INT (kTargetMessages, received);
+
+    close_delivery_ready_monitor (&sub_monitor);
+    close_delivery_ready_monitor (&pub_monitor);
+    test_context_socket_close (sub);
+    test_context_socket_close (pub);
+}
+} // namespace
+
+void test_pubsub_nodrop_single_subscriber_tcp ()
+{
+    TEST_ASSERT_SUCCESS_ERRNO (
+      zlink_ctx_set (get_test_context (), ZLINK_IO_THREADS, 1));
+    run_pubsub_nodrop_transport (NULL, true);
+}
+
+void test_pubsub_nodrop_single_subscriber_inproc ()
+{
+    run_pubsub_nodrop_transport ("inproc://test_pubsub_nodrop_single_subscriber",
+                                 false);
+}
+
+int main ()
+{
+    setup_test_environment ();
+    UNITY_BEGIN ();
+    RUN_TEST (test_pubsub_nodrop_single_subscriber_tcp);
+    RUN_TEST (test_pubsub_nodrop_single_subscriber_inproc);
+    return UNITY_END ();
+}

