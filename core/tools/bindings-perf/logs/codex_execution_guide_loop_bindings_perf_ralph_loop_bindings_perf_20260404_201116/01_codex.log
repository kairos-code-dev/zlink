+        || line_.compare (0, sizeof (prefix) - 1, prefix) != 0) {
+        return false;
+    }
+
+    const char *value = line_.c_str () + (sizeof (prefix) - 1);
+    char *size_end = NULL;
+    const unsigned long long parsed_size = std::strtoull (value, &size_end, 10);
+    if (!size_end || *size_end != ',' || parsed_size == 0)
+        return false;
+
+    char *count_end = NULL;
+    const unsigned long long parsed_count =
+      std::strtoull (size_end + 1, &count_end, 10);
+    if (!count_end || *count_end != '\0' || parsed_count == 0)
+        return false;
+
+    *msg_size_out_ = static_cast<size_t> (parsed_size);
+    *ready_count_out_ = static_cast<size_t> (parsed_count);
+    return true;
+}
