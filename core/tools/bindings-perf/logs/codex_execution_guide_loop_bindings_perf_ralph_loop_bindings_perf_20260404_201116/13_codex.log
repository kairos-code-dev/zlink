        }

        const int sent = state.sock->send (
          _payload.data (), _payload.size (), zlink::send_flag::dontwait);
        if (sent == static_cast<int> (_payload.size ())) {
            state.awaiting_reply = true;
            state.send_pending = false;
            return set_pollout (state, false);
        }

