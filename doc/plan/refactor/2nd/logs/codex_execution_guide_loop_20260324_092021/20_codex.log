cur=pathlib.Path('core/perf/results/multi/report/perf_linux_recv_20260324_190508_spot-multi-20260324f.txt')

def parse(path):
    rows={}
    pattern=None; transport=None
    for line in path.read_text().splitlines():
        m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
        if m:
            pattern=m.group(1); transport=None; continue
        m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
        if m and 'Done' not in line:
            transport=m.group(1); continue
        if 'RESULT,current,' in line:
            parts=line.split(',')
            if len(parts)>=7:
                _,_,pat,tr,size,metric,val=parts[:7]
                if metric=='throughput':
                    rows[(pat,tr,size+'B' if not size.endswith('B') else size)] = float(val)
            continue
        if '|' not in line or pattern is None or transport is None:
            continue
        cols=[c.strip() for c in line.strip().strip('|').split('|')]
        if len(cols) < 2 or cols[0] in ('Size','----------'):
            continue
        thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
        if thr:
            rows[(pattern,transport,cols[0])] = float(thr.group(1))*1000
    return rows
b=parse(base); c=parse(cur)
