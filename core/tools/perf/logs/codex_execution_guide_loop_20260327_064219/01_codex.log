+void cleanup_child (process_capture_t *proc_)
+{
+    if (!proc_ || proc_->pid <= 0)
+        return;
+
+    int status = 0;
+    const pid_t waited = waitpid (proc_->pid, &status, WNOHANG);
+    if (waited == 0) {
+        kill (proc_->pid, SIGKILL);
+        waitpid (proc_->pid, &status, 0);
+    }
+    proc_->pid = -1;
+    close_process_capture (proc_);
+}
