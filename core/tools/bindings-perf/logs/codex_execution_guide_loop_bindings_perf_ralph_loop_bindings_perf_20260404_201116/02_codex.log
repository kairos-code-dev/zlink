   614	
   615	    bool setup_slots ()
   616	    {
   617	        const uint64_t active_duration_us =
   618	          static_cast<uint64_t> (std::max (1, _settings.duration_seconds))
   619	          * 1000000ULL;
   620	
   621	        for (size_t i = 0; i < _settings.clients; ++i) {
   622	            std::unique_ptr<client_slot_t> slot (new client_slot_t ());
   623	            slot->node.reset (new zlink::service::spot_node_t (_ctx.ctx ()));
   624	            if (!slot->node->valid ())
   625	            {
   626	                debug_log ("slot node invalid");
   627	                return false;
   628	            }
   629	
   630	            slot->spot.reset (new zlink::service::spot_t (*slot->node));
   631	            if (!slot->spot->valid ())
   632	            {
   633	                debug_log ("slot spot invalid");
   634	                return false;
   635	            }
   636	
   637	            if (!configure_spot_client_tls (*slot->node, _transport))
   638	            {
   639	                debug_log ("configure tls failed");
   640	                return false;
   641	            }
   642	            if (slot->node->connect_peer (_server_endpoint) != 0) {
   643	                debug_log ("connect peer failed");
   644	                return false;
   645	            }
   646	
   647	            (void) slot->spot->set (zlink::socket_options::rcvhwm, _settings.rcvhwm);
   648	            (void) slot->spot->set (zlink::socket_options::rcvtimeo,
   649	                                    _settings.rcvtimeo_ms);
   650	
   651	            if (_callback_mode
   652	                && !slot->callback.attach (
   653	                  *slot->spot, &_active_start_us, _msg_size, active_duration_us)) {
   654	                debug_log ("callback attach failed");
   655	                return false;
   656	            }
   657	
   658	            if (slot->spot->set_subscription (k_topic) != 0)
   659	            {
   660	                debug_log ("subscribe failed");
   661	                return false;
   662	            }
   663	
   664	            _slots.push_back (std::move (slot));
   665	        }
   666	
   667	        return !_slots.empty ();
   668	    }
