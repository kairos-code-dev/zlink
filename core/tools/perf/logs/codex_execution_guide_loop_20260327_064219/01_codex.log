+int main (int argc, char **argv)
+{
+    g_self_path = argc > 0 ? argv[0] : NULL;
+    UNITY_BEGIN ();
+    RUN_TEST (test_multi_dealer_dealer_process_tls_large_sequence);
+    return UNITY_END ();
+}
