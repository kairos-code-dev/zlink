    bool drain_recv (client_slot_t &slot_, bool sync_only_, bool *progressed_out_)
    {
        for (;;) {
            const zlink::maybe_t<zlink::subscribed_t> maybe_received =
              slot_.spot->try_subscribe ();
            if (!maybe_received)
                return true;

            const zlink::subscribed_t &received = *maybe_received;
            const std::vector<zlink::message_t> &parts = received.parts;
            const std::string &topic = received.topic;

            if (progressed_out_)
                *progressed_out_ = true;

            if (topic != k_topic || parts.size () != 1)
                continue;

            perf_metric::header_t header;
            if (!perf_metric::decode_payload_header (
                  parts[0].data (), parts[0].size (), &header)
                || header.msg_size != static_cast<uint32_t> (_msg_size)) {
                continue;
            }

            slot_.synced.store (true, std::memory_order_release);
            if (sync_only_)
                continue;

            if (header.phase != static_cast<uint32_t> (perf_metric::phase_active))
                continue;

            const uint64_t received_ts_us = perf_metric::now_us ();
            uint64_t start = _active_start_us.load (std::memory_order_acquire);
            bool notify_phase = false;
            if (start == 0) {
                (void) _active_start_us.compare_exchange_strong (
                  start, received_ts_us, std::memory_order_acq_rel);
                start = _active_start_us.load (std::memory_order_acquire);
                notify_phase = (start != 0);
            }
            if (received_ts_us < start)
                continue;

            const uint64_t duration_us =
              static_cast<uint64_t> (std::max (1, _settings.duration_seconds))
              * 1000000ULL;
            if (received_ts_us > start + duration_us)
                continue;

            recv_thread_metrics_t *metrics = bind_recv_thread_metrics ();
            if (!metrics)
                continue;

            ++metrics->active_received;
            if (should_sample_spot_latency (++metrics->sample_index)) {
                const double latency_us = received_ts_us >= header.sent_ts_us
                                            ? static_cast<double> (
                                                received_ts_us
                                                - header.sent_ts_us)
                                            : 0.0;
                metrics->latency.add (latency_us);
            }

            if (notify_phase)
                _phase_cv.notify_all ();
        }
    }

    struct recv_thread_metrics_t
    {
        recv_thread_metrics_t ()
            : owner (NULL),
              registered (false),
              epoch (0),
              active_received (0),
              sample_index (0),
              latency ()
        {
        }

        spot_client_bench_t *owner;
        bool registered;
        uint64_t epoch;
        unsigned long long active_received;
        unsigned long long sample_index;
        perf::multi::bench_latency_sampler_t latency;
    };

    struct recv_worker_t
    {
        zlink::poller_t poller;
        std::vector<client_slot_t *> slots;
        std::vector<zlink::poll_event_t> events;
        std::thread thread;
    };

    recv_thread_metrics_t *bind_recv_thread_metrics ()
    {
        static thread_local recv_thread_metrics_t metrics;
        if (!metrics.registered || metrics.owner != this) {
            metrics.owner = this;
            metrics.registered = true;
            std::lock_guard<std::mutex> lock (_recv_metrics_mutex);
            if (std::find (_recv_thread_metrics.begin (),
                           _recv_thread_metrics.end (),
                           &metrics)
                == _recv_thread_metrics.end ()) {
                _recv_thread_metrics.push_back (&metrics);
            }
        }

        const uint64_t epoch =
          _recv_metrics_epoch.load (std::memory_order_acquire);
        if (metrics.epoch != epoch) {
            metrics.epoch = epoch;
            metrics.active_received = 0;
            metrics.sample_index = 0;
            metrics.latency = perf::multi::bench_latency_sampler_t ();
        }
        return &metrics;
    }

    void collect_recv_thread_metrics ()
    {
        perf::multi::bench_latency_sampler_t merged_latency;
        unsigned long long active_received = 0;
        const uint64_t epoch =
          _recv_metrics_epoch.load (std::memory_order_acquire);
        {
            std::lock_guard<std::mutex> lock (_recv_metrics_mutex);
            for (size_t i = 0; i < _recv_thread_metrics.size (); ++i) {
                recv_thread_metrics_t *metrics = _recv_thread_metrics[i];
                if (!metrics || metrics->owner != this || metrics->epoch != epoch)
                    continue;
                active_received += metrics->active_received;
                merged_latency.merge_from (metrics->latency);
            }
        }
        _active_count = active_received;
        _latency = merged_latency.snapshot ();
    }

