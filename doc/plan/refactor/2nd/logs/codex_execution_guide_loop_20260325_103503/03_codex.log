+{
+    if (published_default_pub_out_)
+        *published_default_pub_out_ = pub_;
+
+    scoped_lock_t lock (_sync);
+    if (_default_pub && _default_pub != pub_) {
+        if (published_default_pub_out_)
+            *published_default_pub_out_ = _default_pub;
+        return;
+    }
