+        const uint64_t epoch =
+          _recv_metrics_epoch.load (std::memory_order_acquire);
+        {
+            std::lock_guard<std::mutex> lock (_recv_metrics_mutex);
+            for (size_t i = 0; i < _recv_thread_metrics.size (); ++i) {
+                recv_thread_metrics_t *metrics = _recv_thread_metrics[i];
+                if (!metrics || metrics->owner != this || metrics->epoch != epoch)
+                    continue;
+                active_received += metrics->active_received;
+                merged_latency.merge_from (metrics->latency);
+            }
+        }
+        _active_count = active_received;
+        _latency = merged_latency.snapshot ();
