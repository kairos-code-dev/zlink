import re
baseline='doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt'
current='core/perf/results/multi/report/perf_linux_recv_20260325_025128_residual-reentry-current.txt'

def parse(path):
    rows={}; pat=None; tr=None
    with open(path, encoding='utf-8') as f:
        for line in f:
            m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
            if m:
                pat=m.group(1); tr=None; continue
            m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
            if m and 'Done' not in line:
                tr=m.group(1); continue
            if '|' not in line or pat is None or tr is None:
                continue
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            if len(cols)<2 or cols[0] in ('Size','----------'):
                continue
            thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
            if thr:
                rows[(pat,tr,cols[0])]=float(thr.group(1))
    return rows
b=parse(baseline); c=parse(current)
