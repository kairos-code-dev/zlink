+
+#if defined IFNAMSIZ
+#define BINDDEVSIZ IFNAMSIZ
+#else
+#define BINDDEVSIZ 16
+#endif
+
+int zlink::options_setsockopt_transport_network (options_t *self_,
+                                                 int option_,
+                                                 const void *optval_,
+                                                 size_t optvallen_,
+                                                 bool is_int_,
+                                                 int value_)
+{
+    switch (option_) {
+        case ZLINK_INTERNAL_OPT_SNDBUF:
+            if (is_int_ && value_ >= -1) {
+                self_->sndbuf = value_;
+                return 0;
+            }
+            break;
+
+        case ZLINK_INTERNAL_OPT_RCVBUF:
+            if (is_int_ && value_ >= -1) {
+                self_->rcvbuf = value_;
+                return 0;
+            }
+            break;
+
+        case ZLINK_INTERNAL_OPT_TOS:
+            if (is_int_ && value_ >= 0) {
+                self_->tos = value_;
+                return 0;
+            }
+            break;
+
+        case ZLINK_INTERNAL_OPT_LINGER:
