{
  "id": "CH-001",
  "name": "request-response across server process",
  "roles": {
    "registry": {
      "count": 0
    },
    "server": [
      {
        "name": "api-a",
        "channel": "scenario-api"
      }
    ],
    "client": [
      {
        "name": "client-a"
      }
    ]
  },
  "steps": [
    {
      "waitReady": {
        "target": "server:api-a"
      }
    },
    {
      "clientRequest": {
        "client": "client-a",
        "channel": "scenario-api",
        "packetName": "ScenarioProfileRequest",
        "requestId": "ch-001-request-1",
        "value": "alice",
        "expectReply": "profile:alice"
      }
    },
    {
      "assertEvidence": {
        "target": "server:api-a",
        "requestId": "ch-001-request-1"
      }
    }
  ],
  "expect": {
    "reply": {
      "requestId": "ch-001-request-1",
      "value": "profile:alice"
    },
    "serverEvidence": {
      "requestIds": [
        "ch-001-request-1"
      ]
    }
  },
  "artifacts": {
    "logs": "logs",
    "report": "report.json",
    "evidence": "server:/evidence"
  }
}
