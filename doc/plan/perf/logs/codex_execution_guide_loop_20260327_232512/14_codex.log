+    memset (&sub_monitor_opts, 0, sizeof (sub_monitor_opts));
+    sub_monitor_opts.events = ZLINK_EVENT_SUB_DELIVERY_READY_CHANGED;
+    void *sub_monitor = zlink_socket_monitor_open (sub, &sub_monitor_opts);
