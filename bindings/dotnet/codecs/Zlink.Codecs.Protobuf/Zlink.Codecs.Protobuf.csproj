<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>6.0.0</Version>
    <AssemblyName>Systems.Zlink.Codecs.Protobuf</AssemblyName>
    <PackageId>Systems.Zlink.Codecs.Protobuf</PackageId>
    <RootNamespace>Systems.Zlink.Codecs.Protobuf</RootNamespace>
    <Authors>ulalax</Authors>
    <Description>Protobuf codec extensions for zlink .NET bindings</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zlink\Zlink.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.29.1" />
  </ItemGroup>
</Project>
