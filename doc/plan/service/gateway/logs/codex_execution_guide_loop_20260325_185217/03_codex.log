-                StampHeader(payload.AsSpan(0, sizeof(long)), TimestampUs());
-                try
-                {
-                    gateway.Send(service, payload.AsSpan(), SendFlags.None);
-                }
-                catch
-                {
-                    sendFailed = true;
-                    break;
-                }
-            }
-        }
-
-        Volatile.Write(ref senderDone, 1);
-        recvThread.Join();
-
-        latencySamples = samples;
-        receivedOut = received;
