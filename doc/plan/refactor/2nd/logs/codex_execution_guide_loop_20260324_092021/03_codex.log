+}
+
+zlink::spot_pub_t *as_spot_pub_side_handle (void *handle_);
+zlink::spot_sub_t *as_spot_sub_side_handle (void *handle_);
+zlink::spot_node_t *as_spot_node_handle (void *handle_);
