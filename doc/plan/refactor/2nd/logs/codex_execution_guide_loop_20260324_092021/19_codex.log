from pathlib import Path
import re
base=Path('doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt')
cur=Path('core/perf/results/single/report/perf_linux_callback_20260324_180028_spot-single-20260324d.txt')
pat=re.compile(r'"'^(SPOT)'"\\s+(\\w+)\\s+(\\d+)\\s+.*?Throughput=([0-9.]+)',re.M)

def parse(p):
    d={}
    for line in p.read_text().splitlines():
        m=pat.search(line)
        if m:
            d[(m.group(1),m.group(2),int(m.group(3)))] = float(m.group(4))
    return d
b=parse(base); c=parse(cur)
rows=[]
for k,v in b.items():
    if k in c and c[k] < v:
        rows.append(((c[k]-v)/v,k,v,c[k]))
rows.sort()
for rel,k,v,cv in rows[:20]:
