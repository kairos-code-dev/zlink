+        spot_handle_t *spot = static_cast<spot_handle_t *> (handle_);
+        zlink::service_public_api_scope_t admission (spot->public_api);
+        if (!admission.acquired ())
+            return -1;
+        zlink::spot_sub_t *sub = ensure_spot_sub (spot);
+        if (!sub) {
+            errno = ENOTSUP;
+            return -1;
