+    TEST_ASSERT_EQUAL_STRING (
+      "protocol-metadata",
+      zlink::option_owner_name (
+        zlink::option_owner_of (ZLINK_INTERNAL_OPT_HEARTBEAT_TTL)));
+    TEST_ASSERT_EQUAL_STRING (
+      "service-specific",
+      zlink::option_owner_name (
+        zlink::option_owner_of (ZLINK_INTERNAL_OPT_TOPICS_COUNT)));
+}
