+    service_public_api_scope_t admission (_public_api);
+    if (!admission.acquired ())
+        return -1;
+    return _handle_defaults.set_pub_option (option_, optval_, optvallen_);
+}
+
+int spot_node_t::set_sub_option (int option_,
