+            seen = &seen_a;
+        else if (phase == 'B')
+            seen = &seen_b;
+        TEST_ASSERT_NOT_NULL (seen);
+        TEST_ASSERT_FALSE ((*seen)[static_cast<size_t> (seq)]);
