+    const int rc = zlink_send_rid (router_, rid_, &msg, 1, flags_);
+    if (rc != 0) {
+        const int err = errno;
+        zlink_msg_close (&msg);
+        errno = err;
+        return -1;
+    }
+    return 0;
+}
