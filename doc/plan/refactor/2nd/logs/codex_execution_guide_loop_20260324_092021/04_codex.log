-    }
-
-    pipe_t *out = pipe_->get_peer ();
-    if (!out) {
-        errno = EHOSTUNREACH;
-        return -1;
-    }
-
-    for (size_t i = 0; i < part_count_; ++i) {
-        msg_t *part = reinterpret_cast<msg_t *> (&parts_[i]);
-        const bool has_more = i + 1 < part_count_;
-        if (has_more)
-            part->set_flags (msg_t::more);
