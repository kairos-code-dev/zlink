+{
+    socket_handle_t handle = as_socket_handle (s_);
+    if (!handle.socket)
+        return -1;
+
+    zlink::discovery_t *discovery =
+      zlink::discovery_access_t::from_handle (discovery_);
+    return discovery ? handle.socket->attach_discovery (discovery) : -1;
