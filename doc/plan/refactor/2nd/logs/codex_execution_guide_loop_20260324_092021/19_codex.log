cur=Path('core/perf/results/single/report/perf_linux_callback_20260324_181439_spot-single-20260324e.txt')

def parse(p):
    d={}
    for line in p.read_text().splitlines():
        if line.startswith('RESULT,'):
            _,_,pattern,transport,size,metric,value=line.split(',')
            if metric=='throughput':
                d[(pattern,transport,int(size))]=float(value)
    return d
b=parse(base); c=parse(cur)
rows=[]
for k,v in b.items():
    if k[0]"'!='"'SPOT':
        continue
    if k not in c:
        rows.append((-9,k,v,float('nan')))
    elif c[k] < v:
        rows.append(((c[k]-v)/v,k,v,c[k]))
rows.sort()
for rel,k,v,cv in rows:
    print(f'{k[0]} {k[1]} {k[2]} baseline={v:.1f} current={cv:.1f} rel={rel:.2%}')
print('count', len(rows))
