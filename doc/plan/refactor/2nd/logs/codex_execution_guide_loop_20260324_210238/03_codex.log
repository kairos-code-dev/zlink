+
+void zlink::socket_lifecycle_coordinator_t::inc_mailbox_ref ()
+{
+    mailbox_refcnt.add (1);
+}
+
+bool zlink::socket_lifecycle_coordinator_t::dec_mailbox_ref ()
+{
