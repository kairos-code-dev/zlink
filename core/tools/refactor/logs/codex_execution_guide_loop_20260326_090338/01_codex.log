+    TEST_ASSERT_NOT_NULL (monitor);
+    close_monitor_if_open (&monitor);
+
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_registry_destroy (&registry));
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_discovery_destroy (&discovery));
