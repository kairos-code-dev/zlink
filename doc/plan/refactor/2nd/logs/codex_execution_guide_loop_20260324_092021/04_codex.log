+    if (is_registered_spot_node_handle (handle_))
+        return static_cast<zlink::spot_node_t *> (handle_)->set_pub_option (
+          ZLINK_SPOT_PUB_OPT_NODROP, optval_, optvallen_);
+
+    errno = EFAULT;
+    return -1;
