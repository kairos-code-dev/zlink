    message_t tmp;
    if (zlink_msg_move (tmp.handle (), &native_parts[0]) != 0) {
        close_message_array (native_parts, native_part_count);
        return -1;
    }
    close_message_array (native_parts, native_part_count);
    part_ = std::move (tmp);
    return 0;
}

