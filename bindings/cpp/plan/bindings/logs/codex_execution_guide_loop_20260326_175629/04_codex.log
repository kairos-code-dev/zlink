+    std::string payload;
+};
+
+void subscribe_callback (const zlink_routing_id_t *,
+                         const char *topic_,
+                         size_t topic_len_,
+                         zlink_msg_t *parts_,
+                         size_t part_count_,
+                         void *userdata_)
