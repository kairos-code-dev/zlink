+void test_socket_lifecycle_coordinator_fast_public_api_entry_round_trips_state ()
+{
+    zlink::socket_lifecycle_coordinator_t coordinator;
+    bool fast_path = false;
+
+    TEST_ASSERT_TRUE (
+      coordinator.enter_public_api_with_uncontended_fast_path (&fast_path));
+    TEST_ASSERT_TRUE (fast_path);
+    TEST_ASSERT_EQUAL_UINT32 (
+      1u, coordinator.public_api_state.load (std::memory_order_acquire));
+
+    coordinator.leave_public_api_with_uncontended_fast_path (fast_path);
+    TEST_ASSERT_EQUAL_UINT32 (
+      0u, coordinator.public_api_state.load (std::memory_order_acquire));
+}
+
+void test_socket_lifecycle_coordinator_fast_public_api_exit_falls_back_when_shared ()
+{
+    zlink::socket_lifecycle_coordinator_t coordinator;
+    bool first_fast_path = false;
+    bool second_fast_path = true;
+
+    TEST_ASSERT_TRUE (
+      coordinator.enter_public_api_with_uncontended_fast_path (
+        &first_fast_path));
+    TEST_ASSERT_TRUE (first_fast_path);
+    TEST_ASSERT_TRUE (
+      coordinator.enter_public_api_with_uncontended_fast_path (
+        &second_fast_path));
+    TEST_ASSERT_FALSE (second_fast_path);
+    TEST_ASSERT_EQUAL_UINT32 (
+      2u, coordinator.public_api_state.load (std::memory_order_acquire));
+
+    coordinator.leave_public_api_with_uncontended_fast_path (first_fast_path);
+    TEST_ASSERT_EQUAL_UINT32 (
+      1u, coordinator.public_api_state.load (std::memory_order_acquire));
+    coordinator.leave_public_api_with_uncontended_fast_path (second_fast_path);
+    TEST_ASSERT_EQUAL_UINT32 (
+      0u, coordinator.public_api_state.load (std::memory_order_acquire));
+}
+
+void test_socket_lifecycle_coordinator_fast_public_api_entry_rejects_closed_state ()
+{
