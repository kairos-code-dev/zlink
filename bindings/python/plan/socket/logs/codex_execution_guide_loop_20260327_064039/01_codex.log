+        if rc != 0:
+            _raise_last_error()
+
+    def connect(self, endpoint: str):
+        rc = lib().zlink_connect(self._handle, endpoint.encode())
+        if rc != 0:
+            _raise_last_error()
+
+    def unbind(self, endpoint: str):
