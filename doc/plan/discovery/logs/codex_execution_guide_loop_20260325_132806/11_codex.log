+            erase_spot_mode_state (it->second);
+            zlink::destroy_spot_handle_for_testing (it->second);
+            g_spot_handles.erase (it);
+        }
+        g_sub_probes.erase (*node_p_);
+        g_node_probes.erase (*node_p_);
+    }
+
+    return zlink_spot_node_destroy (node_p_);
+}
