    44	    long wait_ms = settings.client_poll_timeout_ms > 0 ? settings.client_poll_timeout_ms : 100;
    45	    const long remain_ms = std::chrono::duration_cast<std::chrono::milliseconds> (
    46	                             deadline - std::chrono::steady_clock::now ())
    47	                             .count ();
    48	    if (remain_ms < wait_ms)
    49	        wait_ms = remain_ms;
    50	    if (wait_ms < 1)
    51	        wait_ms = 1;
    52	    return wait_ms;
    53	}
    54	
    55	bool run_phase (zlink::socket_t &publisher,
    56	                zlink::poller_t &poller,
    57	                std::vector<zlink::poll_event_t> &events,
    58	                std::vector<char> &payload,
    59	                size_t msg_size,
    60	                uint32_t run_id,
    61	                uint64_t &seq,
    62	                perf_metric::phase_t phase,
    63	                std::chrono::steady_clock::duration duration,
    64	                bool send_active,
    65	                const perf::multi::multi_bench_settings_t &settings)
    66	{
    67	    if (duration <= std::chrono::steady_clock::duration::zero ())
    68	        return true;
    69	
    70	    if (!send_active) {
    71	        std::this_thread::sleep_for (
    72	          std::chrono::duration_cast<std::chrono::milliseconds> (duration));
    73	        return true;
    74	    }
    75	
    76	    bool pending = false;
    77	    const auto deadline = std::chrono::steady_clock::now () + duration;
    78	    while (std::chrono::steady_clock::now () < deadline) {
    79	        if (!pending) {
    80	            if (!perf_metric::stamp_payload (payload.data (),
    81	                                             payload.size (),
    82	                                             run_id,
    83	                                             phase,
    84	                                             msg_size,
    85	                                             seq++,
    86	                                             perf_metric::now_us ())) {
    87	                return false;
    88	            }
    89	        }
    90	
    91	        zlink_msg_t payload_part;
    92	        if (zlink_msg_init_size (&payload_part, payload.size ()) != 0)
    93	            return false;
    94	        if (!payload.empty ()) {
    95	            std::memcpy (
    96	              zlink_msg_data (&payload_part), payload.data (), payload.size ());
    97	        }
    98	
    99	        const int sent =
   100	          zlink_publish (publisher.handle (), k_topic, &payload_part, 1, ZLINK_DONTWAIT);
   101	        if (sent == 0) {
   102	            pending = false;
   103	            if (poller.modify (publisher, static_cast<zlink::poll_event> (0)) != 0)
   104	                return false;
   105	            continue;
   106	        }
   107	
   108	        (void) zlink_msg_close (&payload_part);
   109	        if (errno == EAGAIN) {
   110	            pending = true;
   111	            if (poller.modify (publisher, zlink::poll_event::pollout) != 0)
   112	                return false;
   113	        } else {
   114	            return false;
   115	        }
   116	
   117	        const int poll_rc =
   118	          poller.wait_all (events, compute_wait_ms (settings, deadline));
   119	        if (poll_rc < 0) {
   120	            if (errno == EINTR || errno == EAGAIN)
   121	                continue;
   122	            return false;
   123	        }
   124	        if (poll_rc == 0)
   125	            continue;
   126	    }
   127	
   128	    return true;
   129	}
   130	
   131	} // namespace
   132	
   133	bool perf_pubsub_server (const std::string &transport, size_t msg_size)
   134	{
   135	    perf::multi::set_perf_pattern_env ("PUBSUB");
   136	
   137	    if (!perf::multi::is_supported_transport (transport)) {
   138	        std::cout << "UNSUPPORTED,MULTI_PUBSUB," << transport << std::endl;
   139	        return true;
   140	    }
   141	
   142	    const perf::multi::multi_bench_settings_t settings =
   143	      perf::multi::resolve_multi_bench_settings ();
   144	
   145	    perf::multi::ctx_guard_t ctx;
   146	    perf::multi::socket_guard_t publisher (ctx, zlink::socket_type::pub);
   147	    if (!publisher.valid ())
   148	        return false;
   149	
   150	    perf::multi::apply_benchmark_socket_options (
   151	      publisher.sock (), settings, transport);
   152	    if (!perf::multi::setup_tls_server (publisher.sock (), transport))
   153	        return false;
   154	
   155	    const std::string endpoint = perf::multi::bind_and_resolve_endpoint (
   156	      publisher.sock (), transport, "cpp_multi_pubsub", settings.server_bind_port);
   157	    if (endpoint.empty ())
   158	        return false;
   159	
   160	    const bench_multi_cpu_sample_t resource_probe_start =
   161	      perf::multi::start_resource_probe ();
   162	    perf::multi::print_ready (endpoint);
   163	
   164	    if (!wait_for_start_signal (msg_size)) {
   165	        std::cerr << "PUBSUB_SERVER_FAIL,stage=start_signal,transport="
   166	                  << transport << ",size=" << msg_size << std::endl;
   167	        return false;
   168	    }
   169	
   170	    std::vector<char> payload (
   171	      std::max<size_t> (msg_size, perf_metric::header_size ()), 'p');
   172	    const uint32_t run_id = 1;
   173	    uint64_t seq = 1;
   174	    zlink::poller_t poller;
   175	    std::vector<zlink::poll_event_t> events;
   176	    events.reserve (1);
   177	    (void) poller.add (publisher.sock (), zlink::poll_event::pollout);
   178	    (void) poller.modify (publisher.sock (), static_cast<zlink::poll_event> (0));
   179	
   180	    if (!run_phase (publisher.sock (),
   181	                    poller,
   182	                    events,
   183	                    payload,
   184	                    msg_size,
   185	                    run_id,
   186	                    seq,
   187	                    perf_metric::phase_warmup,
   188	                    std::chrono::seconds (std::max (0, settings.warmup_seconds)),
   189	                    true,
   190	                    settings))
   191	        return false;
   192	    if (!run_phase (publisher.sock (),
   193	                    poller,
   194	                    events,
   195	                    payload,
   196	                    msg_size,
   197	                    run_id,
   198	                    seq,
   199	                    perf_metric::phase_drain,
   200	                    std::chrono::milliseconds (std::max (0, settings.settle_ms)),
   201	                    false,
   202	                    settings))
   203	        return false;
   204	    if (!run_phase (publisher.sock (),
   205	                    poller,
   206	                    events,
   207	                    payload,
   208	                    msg_size,
   209	                    run_id,
   210	                    seq,
   211	                    perf_metric::phase_active,
   212	                    std::chrono::seconds (std::max (1, settings.duration_seconds)),
   213	                    true,
   214	                    settings))
   215	        return false;
   216	
   217	    const bench_multi_resource_metrics_t resource_metrics =
   218	      perf::multi::finish_resource_probe (resource_probe_start);
   219	    perf::multi::print_server_resource_metrics (
   220	      "current",
   221	      "MULTI_PUBSUB",
   222	      transport,
   223	      msg_size,
   224	      resource_metrics);
   225	    perf::multi::print_server_queue_metrics (
   226	      "current",
   227	      "MULTI_PUBSUB",
   228	      transport,
   229	      msg_size,
   230	      perf::multi::server_queue_stats_t ());
   231	
   232	    return true;
   233	}
   234	
   235	int main (int argc, char **argv)
   236	{
   237	    if (argc < 3) {
   238	        std::cerr << "usage: <transport> <size>" << std::endl;
   239	        return 1;
   240	    }
   241	
   242	    const std::string transport = argv[1];
   243	    const size_t size = static_cast<size_t> (std::strtoull (argv[2], NULL, 10));
   244	    if (size == 0)
   245	        return 1;
   246	
   247	    return perf_pubsub_server (transport, size) ? 0 : 1;
   248	}

