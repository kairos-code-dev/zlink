-            PerfMultiCommon.resolveSndHwm(PATTERN));
-        gateway.setOption(SocketOptions.RCVHWM,
-            PerfMultiCommon.resolveRcvHwm(PATTERN));
-        gateway.setOption(SocketOptions.SNDTIMEO,
-            PerfMultiCommon.resolveSndTimeoutMs());
