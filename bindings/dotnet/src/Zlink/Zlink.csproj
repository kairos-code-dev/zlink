<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>9.0.7</Version>
        <AssemblyName>Systems.Zlink</AssemblyName>
        <PackageId>Systems.Zlink</PackageId>
        <RootNamespace>Systems.Zlink</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>ulalax</Authors>
        <Description>zlink .NET bindings - high-performance async messaging library</Description>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\native\linux-x64\*.*" Exclude="..\..\native\linux-x64\libzlink_c.*">
            <Pack>true</Pack>
            <PackagePath>runtimes\linux-x64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\linux-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Include="..\..\native\linux-arm64\*.*" Exclude="..\..\native\linux-arm64\libzlink_c.*">
            <Pack>true</Pack>
            <PackagePath>runtimes\linux-arm64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\linux-arm64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Include="..\..\native\osx-x64\*.*" Exclude="..\..\native\osx-x64\libzlink_c.*">
            <Pack>true</Pack>
            <PackagePath>runtimes\osx-x64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\osx-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Include="..\..\native\osx-arm64\*.*" Exclude="..\..\native\osx-arm64\libzlink_c.*">
            <Pack>true</Pack>
            <PackagePath>runtimes\osx-arm64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\osx-arm64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Include="..\..\native\win-x64\*.*" Exclude="..\..\native\win-x64\zlink_c.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes\win-x64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Include="..\..\native\win-arm64\*.*" Exclude="..\..\native\win-arm64\zlink_c.dll">
            <Pack>true</Pack>
            <PackagePath>runtimes\win-arm64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\win-arm64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <None Update="..\..\native\win-*\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <None Update="..\..\native\linux-*\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <None Update="..\..\native\osx-*\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
