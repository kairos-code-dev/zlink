int zlink::xpub_t::xsend (msg_t *msg_)
{
    const bool msg_more = (msg_->flags () & msg_t::more) != 0;

    if (_send_all_data && !_manual && !options.invert_matching) {
        int rc = -1;
        if (_lossy || _dist.check_hwm ()) {
            if (_dist.send_to_all (msg_) == 0) {
                _more_send = msg_more;
                rc = 0;
            }
        } else
            errno = EAGAIN;
        return rc;
