+{
+    if (!parts_)
+        return;
+
+    for (size_t i = start_index_; i < part_count_; ++i) {
+        zlink::msg_t *msg = &parts_[i];
+        if (!msg->check ())
+            continue;
+
+        const int close_rc = msg->close ();
+        errno_assert (close_rc == 0);
+        const int init_rc = msg->init ();
+        errno_assert (init_rc == 0);
+    }
