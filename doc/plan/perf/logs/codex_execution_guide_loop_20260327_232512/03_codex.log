+struct publish_start_gate_t
+{
+    publish_start_gate_t () : ready (0), go (false) {}
+
+    std::mutex sync;
+    std::condition_variable cv;
+    std::atomic<int> ready;
+    bool go;
+};
+
+struct publisher_probe_t
+{
+    publisher_probe_t () :
+        gate (NULL),
+        socket (NULL),
+        phase ('?'),
+        count (0),
+        failed (false),
+        publish_errno (0)
+    {
+    }
+
+    publish_start_gate_t *gate;
+    void *socket;
+    char phase;
+    int count;
