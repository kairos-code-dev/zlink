+        zlink::spot_node_t *node = static_cast<zlink::spot_node_t *> (handle_);
+        zlink::service_public_api_scope_t admission (node->public_api_guard ());
+        if (!admission.acquired ())
+            return -1;
+        node->snapshot_subscription_subjects (out_);
+        return 0;
+    }
+
+    errno = EFAULT;
+    return -1;
