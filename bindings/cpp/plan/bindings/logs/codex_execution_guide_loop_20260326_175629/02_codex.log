+        if (rc == 0) {
+            const size_t bounded = size <= buffer.size () ? size : buffer.size ();
+            size_t out_size = bounded;
+            if (out_size > 0 && buffer[out_size - 1] == '\0')
+                --out_size;
+            value_.assign (buffer.data (), out_size);
+            return 0;
+        }
+
+        if (errno != EINVAL || cap == max_cap)
+            return -1;
+
+        cap *= 2u;
+        if (cap > max_cap)
+            cap = max_cap;
+    }
