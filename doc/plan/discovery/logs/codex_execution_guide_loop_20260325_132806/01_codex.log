+int main ()
+{
+    UNITY_BEGIN ();
+    RUN_TEST (test_discovery_protocol_accepts_socket_family_and_roles);
+    RUN_TEST (test_discovery_protocol_derives_socket_roles_and_matching);
+    RUN_TEST (test_discovery_new_accepts_socket_family);
+    return UNITY_END ();
+}

