+        std::unique_lock<std::mutex> lock (probe_->gate->sync);
+        probe_->gate->ready.fetch_add (1, std::memory_order_acq_rel);
+        probe_->gate->cv.notify_all ();
+        probe_->gate->cv.wait (lock, [&] () { return probe_->gate->go; });
+    }
+
