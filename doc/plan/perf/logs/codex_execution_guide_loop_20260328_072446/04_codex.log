+zlink::pipe_write_status_t
+zlink::pipe_t::write_check_hwm_once (const msg_t *msg_)
+{
+    scoped_fast_lock_t lock (_out_sync);
+    if (unlikely (!_out_active || _state != active))
+        return pipe_write_inactive;
+
+    if (unlikely (!check_hwm_unlocked ()))
+        return pipe_write_hwm_full;
+
+    const bool more = (msg_->flags () & msg_t::more) != 0;
+    const bool is_routing_id = msg_->is_routing_id ();
+    _out_pipe->write (*msg_, more);
+    if (!more && !is_routing_id)
+        _msgs_written++;
+
+    return pipe_write_ready;
+}
+
+zlink::pipe_write_status_t
+zlink::pipe_t::write_and_flush_check_hwm_once (const msg_t *msg_)
+{
+    scoped_fast_lock_t lock (_out_sync);
+    if (unlikely (!_out_active || _state != active))
+        return pipe_write_inactive;
+
+    if (unlikely (!check_hwm_unlocked ()))
+        return pipe_write_hwm_full;
+
+    const bool more = (msg_->flags () & msg_t::more) != 0;
+    const bool is_routing_id = msg_->is_routing_id ();
+    _out_pipe->write (*msg_, more);
+    if (!more && !is_routing_id)
+        _msgs_written++;
+
+    if (!more && _state != term_ack_sent && _out_pipe && !_out_pipe->flush ())
