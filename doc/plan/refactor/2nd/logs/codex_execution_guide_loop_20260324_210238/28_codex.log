+bool spot_data_plane_protocol_t::decode_mesh_xsub_monitor_connection_change (
+  const zlink_monitor_event_t &raw_, bool *connected_out_)
+{
+    if (!connected_out_)
+        return false;
+
+    if (raw_.event == ZLINK_EVENT_CONNECTION_READY_CHANGED) {
+        *connected_out_ = raw_.value != 0;
+        return true;
+    }
+
+    if (raw_.event == ZLINK_EVENT_DISCONNECTED) {
+        *connected_out_ = false;
+        return true;
+    }
+
+    return false;
+}
+
 void spot_data_plane_protocol_t::clear_mesh_xsub_connected_endpoints (
   spot_runtime_t *runtime_)
 {
