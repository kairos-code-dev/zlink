/bin/bash -lc "python - <<'PY'
import re
from pathlib import Path
base=Path('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt')
prev=Path('core/perf/results/multi/report/perf_linux_recv_20260324_163452_spot-multi-postfix4.txt')
cur=Path('core/perf/results/multi/report/perf_linux_recv_20260324_165337_spot-multi-unbind-cleanup.txt')

def parse(path):
    rows={}
    pattern=None; transport=None
    for line in path.read_text(encoding='utf-8').splitlines():
        m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
        if m:
            pattern=m.group(1); transport=None; continue
        m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
        if m and 'Done' not in line:
            transport=m.group(1); continue
        if '|' not in line or pattern is None or transport is None:
            continue
        cols=[c.strip() for c in line.strip().strip('|').split('|')]
        if len(cols)<2 or cols[0] in ('Size','----------'):
            continue
        size=cols[0].rstrip('B')
        thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
        if thr:
            rows[(pattern,transport,size)] = float(thr.group(1))
    return rows
b=parse(base); p=parse(prev); c=parse(cur)
