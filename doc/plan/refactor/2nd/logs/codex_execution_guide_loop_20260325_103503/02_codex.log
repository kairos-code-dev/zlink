+      &state, "wss://127.0.0.1:9001"));
+    TEST_ASSERT_TRUE (state.connected_endpoints.empty ());
+    TEST_ASSERT_EQUAL_UINT (0, state.connected_ready_peer_count.load ());
+    TEST_ASSERT_EQUAL_UINT64 (2, state.version.load ());
+}
