def send_with_retry(sock, data, flags, timeout_ms):
    deadline = time.time() + (timeout_ms / 1000.0)
    last = None
    while time.time() < deadline:
        try:
            sock.send(data, flags)
            return
        except zlink.ZlinkError as exc:
            last = exc
            time.sleep(0.01)
    if last:
        raise last
    raise RuntimeError("timeout")


