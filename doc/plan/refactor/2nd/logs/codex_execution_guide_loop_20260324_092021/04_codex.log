-{
-    if (!pipe_ || !rid_)
-        return false;
-
-    const pipe_t *routing_pipe = pipe_;
-    if (routing_pipe->get_peer ())
-        routing_pipe = routing_pipe->get_peer ();
-
-    const blob_t &routing_id = routing_pipe->get_routing_id ();
-    if (routing_id.size () != rid_->size)
