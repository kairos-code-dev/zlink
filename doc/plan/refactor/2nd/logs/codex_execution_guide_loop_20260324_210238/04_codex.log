-        return ZLINK_SPOT_ROLE_PUB;
-    if (want_sub)
-        return ZLINK_SPOT_ROLE_SUB;
-
-    if (as_spot_pub_side_handle (target_))
-        return ZLINK_SPOT_ROLE_PUB;
-    if (as_spot_sub_side_handle (target_))
-        return ZLINK_SPOT_ROLE_SUB;
