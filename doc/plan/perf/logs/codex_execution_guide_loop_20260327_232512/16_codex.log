+int zlink::socket_base_t::xsend_routed_data (
+  const unsigned char *routing_id_data_,
+  size_t routing_id_size_,
+  msg_t *msg_)
+{
+    if ((!routing_id_data_ && routing_id_size_ > 0) || routing_id_size_ == 0
+        || routing_id_size_ > sizeof (zlink_routing_id_t::data)) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    zlink_routing_id_t routing_id;
+    routing_id.size = static_cast<uint8_t> (routing_id_size_);
+    if (routing_id_size_ > 0)
+        memcpy (routing_id.data, routing_id_data_, routing_id_size_);
+    return xsend_routed (&routing_id, msg_);
+}
