+
+    const std::string &service_name = discovery_->service_name ();
+    if (service_name.empty ()) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    return discovery_->update_service_weight (
+      service_type_, service_name.c_str (), endpoint_, weight_, service_role_);
+}
+}
+}
+
+#endif
