+void test_typed_service_handle_dispatch_domains ()
+{
+    void *ctx = new_ctx ();
+    void *discovery =
+      zlink_discovery_new (ctx, ZLINK_SERVICE_TYPE_SPOT, "svc-alpha");
+    void *registry = zlink_registry_new (ctx);
+    TEST_ASSERT_NOT_NULL (discovery);
+    TEST_ASSERT_NOT_NULL (registry);
+
