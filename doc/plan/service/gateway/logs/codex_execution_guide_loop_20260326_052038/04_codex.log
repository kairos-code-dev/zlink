+int discovery_t::get_option (int option_, void *optval_, size_t *optvallen_) const
+{
+    if (option_ != ZLINK_OPT_DISCOVERY_METADATA_MAX_SIZE) {
+        errno = ENOTSUP;
+        return -1;
