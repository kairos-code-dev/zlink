+        default_percent = 75;
+    else if (transport == "ws")
+        default_percent = 85;
+
+    return resolve_multi_int_env("PERF_MULTI_SPOT_PHASE_QUORUM_PERCENT",
+                                 default_percent,
+                                 1);
