+        return false;
+
+    scoped_lock_t lock (state_->sync);
+    bool changed =
+      sync_monitor_connected_endpoint (&state_->connected_endpoints, raw_);
+    if (raw_.event == ZLINK_EVENT_DISCONNECTED
