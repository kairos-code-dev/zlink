<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>10.5.0</Version>
        <ZLinkLinuxX64NativeRoot Condition="'$(ZLinkLinuxX64NativeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\native\linux-x64</ZLinkLinuxX64NativeRoot>
        <AssemblyName>Systems.Zlink</AssemblyName>
        <PackageId>Systems.Zlink</PackageId>
        <RootNamespace>Systems.Zlink</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Authors>ulalax</Authors>
        <Description>zlink .NET bindings - high-performance async messaging library</Description>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(ZLinkLinuxX64NativeRoot)\*.*" Exclude="$(ZLinkLinuxX64NativeRoot)\libzlink_c.*">
            <Pack>true</Pack>
            <PackagePath>runtimes\linux-x64\native\%(Filename)%(Extension)</PackagePath>
            <Link>runtimes\linux-x64\native\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <None Update="..\..\native\win-*\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <None Update="..\..\native\linux-*\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <None Update="..\..\native\osx-*\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
