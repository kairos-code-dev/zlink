+bool try_extract_router_target_rid_view (const zlink_msg_t *part_,
+                                         const void **data_out_,
+                                         size_t *size_out_)
+{
+    if (!part_ || !data_out_ || !size_out_)
+        return false;
+
+    zlink::msg_t *msg =
+      reinterpret_cast<zlink::msg_t *> (const_cast<zlink_msg_t *> (part_));
+    if (!msg->check ())
+        return false;
+
+    const size_t size = msg->size ();
+    if (size == 0 || size > sizeof (zlink_routing_id_t ().data))
+        return false;
+
+    *data_out_ = msg->data ();
+    *size_out_ = size;
+    return true;
+}
