-        return 0;
-    }
-
-    {
-        scoped_lock_t lock (_sync);
-        _active_direct_handler.store (NULL, std::memory_order_release);
-        _handler_state.store (handler_none, std::memory_order_release);
-    }
-    return -1;
-}
