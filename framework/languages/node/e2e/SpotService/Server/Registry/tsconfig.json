{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": "../../.."
  },
  "include": ["**/*.ts", "../../Shared/**/*.ts", "../Play/Infrastructure/**/*.ts", "../Play/Support/**/*.ts"]
}
