diff --git a/doc/plan/service/gateway/socket-metadata-sharing-plan.ko.md b/doc/plan/service/gateway/socket-metadata-sharing-plan.ko.md
index b24c1a8c93418ef763bb888b55a6734cc719b5a8..515c35815b79b1f03cab3c0345976f2c99d06d20
