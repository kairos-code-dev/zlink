+                               zlink_subscribe_handler_fn handler_,
+                               void *userdata_);
+int spot_node_install_recv_handler (zlink::spot_node_t *node_,
+                                    zlink_subscribe_handler_fn handler_,
+                                    void *userdata_);
+int spot_install_send_ready_handler (spot_handle_t *spot_,
+                                     zlink_send_ready_handler_fn handler_,
