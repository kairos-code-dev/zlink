+static int start_spot_sub_dispatch (zlink::socket_base_t *socket_,
+                                    zlink::spot_sub_direct_handler_fn handler_,
+                                    void *userdata_)
+{
+    if (!socket_) {
+        errno = EFAULT;
+        return -1;
+    }
+
+    const int type = socket_->socket_type ();
+    if (type == ZLINK_CORE_SOCKET_SUB || type == ZLINK_CORE_SOCKET_XSUB) {
+        zlink::xsub_t *xsub = static_cast<zlink::xsub_t *> (socket_);
+        return xsub->sub_dispatch_start (handler_, userdata_);
+    }
+
+    return socket_->sub_dispatch_start (handler_, userdata_);
+}
