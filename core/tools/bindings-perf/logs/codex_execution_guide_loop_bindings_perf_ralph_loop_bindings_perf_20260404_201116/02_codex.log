   264	bool parse_ready_count_command (const std::string &line_,
   265	                                size_t *msg_size_out_,
   266	                                size_t *ready_count_out_)
   267	{
   268	    static const char prefix[] = "READY_COUNT,";
   269	    if (!msg_size_out_ || !ready_count_out_
   270	        || line_.compare (0, sizeof (prefix) - 1, prefix) != 0) {
   271	        return false;
   272	    }
   273	
   274	    const char *value = line_.c_str () + (sizeof (prefix) - 1);
   275	    char *size_end = NULL;
   276	    const unsigned long long parsed_size = std::strtoull (value, &size_end, 10);
   277	    if (!size_end || *size_end != ',' || parsed_size == 0)
   278	        return false;
   279	
   280	    char *count_end = NULL;
   281	    const unsigned long long parsed_count =
   282	      std::strtoull (size_end + 1, &count_end, 10);
   283	    if (!count_end || *count_end != '\0' || parsed_count == 0)
   284	        return false;
   285	
   286	    *msg_size_out_ = static_cast<size_t> (parsed_size);
   287	    *ready_count_out_ = static_cast<size_t> (parsed_count);
   288	    return true;
   289	}
