+{
+    if (!socket_)
+        return;
+    if (!node_ || !node_->_ctx) {
+        socket_->stop ();
+        socket_->close ();
+        socket_ = NULL;
+        return;
+    }
+    (void) node_->_lifecycle.close_socket (socket_, 2000);
+}
