+    zlink::spot_pub_t *default_pub = node->ensure_default_pub ();
+    TEST_ASSERT_NOT_NULL (default_pub);
+    TEST_ASSERT_EQUAL_PTR (default_pub, node->ensure_default_pub ());
+
+    const int sub_rcvhwm = 678;
