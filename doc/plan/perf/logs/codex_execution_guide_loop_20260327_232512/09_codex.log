+    void *ctx = zlink_ctx_new ();
+    TEST_ASSERT_NOT_NULL (ctx);
+
+    void *sub = zlink_socket (ctx, ZLINK_SOCKET_SUB);
+    void *pub = zlink_socket (ctx, ZLINK_SOCKET_PUB);
+    TEST_ASSERT_NOT_NULL (sub);
