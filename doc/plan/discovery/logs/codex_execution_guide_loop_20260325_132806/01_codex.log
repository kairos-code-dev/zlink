+                              fixed_service_role_for_type (
+                                service_type_socket));
+
+    TEST_ASSERT_TRUE (is_valid_service_role_for_type (
+      service_type_gateway_receiver, service_role_gateway));
+    TEST_ASSERT_FALSE (is_valid_service_role_for_type (
