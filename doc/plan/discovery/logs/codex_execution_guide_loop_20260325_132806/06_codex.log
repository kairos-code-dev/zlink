+                            endpoint_type_t local_type_) :
+        endpoint (endpoint_),
+        pipe (pipe_),
+        local_type (local_type_)
+    {
+    }
+
+    own_t *endpoint;
+    pipe_t *pipe;
+    endpoint_type_t local_type;
+};
