+class _SocketHandle:
+    def __init__(self, handle, own):
+        self.handle = handle
+        self.own = own
+
+    def close(self):
+        if not self.handle:
+            return
+        handle = self.handle
+        self.handle = None
+        if not self.own:
+            return
+        rc = lib().zlink_close(handle)
+        if rc != 0:
+            _raise_last_error()
