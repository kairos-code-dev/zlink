-    private static void ConnectRegistryWithRetry(Action connect)
-    {
-        Exception? last = null;
-        if (WaitUntil(() =>
-            {
-                try
-                {
-                    connect();
-                    return true;
-                }
-                catch (ZlinkException ex) when (IsWouldBlock(ex.Errno)
-                                                || IsInterrupted(ex.Errno))
-                {
-                    last = ex;
-                    return false;
-                }
-            }, 5000, 20))
-        {
-            return;
-        }
-
-        if (last != null)
-            throw last;
-        throw new TimeoutException("registry connect timeout");
-    }
