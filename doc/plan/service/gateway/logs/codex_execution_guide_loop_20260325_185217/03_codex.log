-
-            if (activeHardStopTicks > 0
-                && Stopwatch.GetTimestamp() >= activeHardStopTicks)
-                break;
-
-            int pollTimeoutMs = pendingReplyCount > 0 ? 0 : 2;
-            if (!WaitForEvents(poller, events, pollTimeoutMs))
-            {
-                long nowTicks = Stopwatch.GetTimestamp();
