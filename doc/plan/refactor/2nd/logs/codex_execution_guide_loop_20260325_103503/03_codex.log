+
+    _internal_receiver = receiver_;
+    _internal_receiver_fast.store (receiver_, std::memory_order_release);
+    _default_sub_fast.store (_default_sub, std::memory_order_release);
+    if (installed_out_)
+        *installed_out_ = true;
+    return receiver_;
+}
