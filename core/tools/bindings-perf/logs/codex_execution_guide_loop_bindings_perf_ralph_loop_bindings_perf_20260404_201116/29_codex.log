struct socket_state_t
{
    zlink::socket_t *sock;
    std::vector<char> request_buffer;
    size_t payload_size;
    zlink::message_t reply;
    bool awaiting_reply;
    bool send_pending;
    bool pollout_enabled;

    socket_state_t ()
        : sock (NULL),
          request_buffer (),
          payload_size (0),
