+    if (proc_->stdout_thread.joinable ())
+        proc_->stdout_thread.join ();
+    if (proc_->stderr_thread.joinable ())
+        proc_->stderr_thread.join ();
+    if (proc_->stdout_file) {
+        fclose (proc_->stdout_file);
