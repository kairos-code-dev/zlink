+int spot_subject_recv (void *subject_,
+                       zlink_routing_id_t *source_rid_out_,
+                       zlink_msg_t **parts_out_,
+                       size_t *part_count_out_,
+                       char *topic_id_out_,
+                       size_t *topic_id_len_out_,
+                       zlink_send_flags_t flags_)
+{
+    if (validate_recv_flags (flags_) != 0)
+        return -1;
