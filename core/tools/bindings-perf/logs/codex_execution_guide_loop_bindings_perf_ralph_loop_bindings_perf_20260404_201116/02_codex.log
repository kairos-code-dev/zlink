   331	bool wait_for_ready_counts (zlink::service::spot_t &spot_,
   332	                            size_t msg_size_,
   333	                            size_t expected_ready_count_,
   334	                            int timeout_ms_)
   335	{
   336	    if (expected_ready_count_ == 0)
   337	        return true;
   338	
   339	    size_t ready_count = 0;
   340	    const auto deadline = std::chrono::steady_clock::now ()
   341	                          + std::chrono::milliseconds (
   342	                            std::max (1, timeout_ms_));
   343	    while (std::chrono::steady_clock::now () < deadline) {
   344	        const zlink::maybe_t<zlink::subscribed_t> maybe_received =
   345	          spot_.try_subscribe ();
   346	        if (!maybe_received) {
   347	            std::this_thread::yield ();
   348	            continue;
   349	        }
   350	
   351	        const zlink::subscribed_t &received = *maybe_received;
   352	        if (received.topic != k_control_topic || received.parts.size () != 1)
   353	            continue;
   354	
   355	        const std::string payload (
   356	          static_cast<const char *> (received.parts[0].data ()),
   357	          received.parts[0].size ());
   358	        debug_log ("control recv payload=" + payload);
   359	        size_t ready_size = 0;
   360	        size_t increment = 0;
   361	        if (!parse_ready_count_command (payload, &ready_size, &increment)
   362	            || ready_size != msg_size_) {
   363	            continue;
   364	        }
   365	
   366	        ready_count += increment;
   367	        debug_log ("ready count=" + std::to_string (ready_count) + "/"
   368	                   + std::to_string (expected_ready_count_));
   369	        if (ready_count >= expected_ready_count_)
   370	            return true;
   371	    }
   372	
   373	    errno = ETIMEDOUT;
   374	    return false;
   375	}
