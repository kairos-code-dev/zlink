diff --git a/bindings/cpp/perf/multi/src/perf_router_router_client.cpp b/bindings/cpp/perf/multi/src/perf_router_router_client.cpp
index 4f1596f816c1995649b246fc71641526eefc4337..bce14e59d33f37b69008c7a269cd35c502657e78
--- a/bindings/cpp/perf/multi/src/perf_router_router_client.cpp
+++ b/bindings/cpp/perf/multi/src/perf_router_router_client.cpp
@@ -48,7 +48,7 @@
 struct socket_state_t
 {
     zlink::socket_t *sock;
-    zlink::message_t request;
+    std::vector<char> request_buffer;
     size_t payload_size;
     zlink::message_t reply;
     bool awaiting_reply;
@@ -57,7 +57,7 @@
 
     socket_state_t ()
         : sock (NULL),
-          request (),
+          request_buffer (),
           payload_size (0),
           reply (),
           awaiting_reply (false),
@@ -153,9 +153,7 @@
             socket_state_t &slot = _socket_states.back ();
             slot.payload_size =
               std::max<size_t> (_msg_size, perf_metric::header_size ());
-            if (slot.request.init (slot.payload_size) != 0)
-                return false;
-            std::memset (slot.request.data (), k_payload_fill, slot.payload_size);
+            slot.request_buffer.assign (slot.payload_size, k_payload_fill);
             (void) _poller.add (sock, zlink::poll_event::pollin, &_socket_states.back ());
         }
 
@@ -205,35 +203,46 @@
 
     bool try_send_request (socket_state_t &state, perf_metric::phase_t phase)
     {
-        if (!state.sock || !state.request.valid ())
+        if (!state.sock || state.request_buffer.empty ())
             return false;
 
-        if (!state.send_pending) {
-            const uint64_t sent_ts = perf_metric::now_us ();
-            if (!perf_metric::stamp_payload (state.request.data (),
-                                             state.payload_size,
-                                             _run_id,
-                                             phase,
-                                             _msg_size,
-                                             _seq++,
-                                             sent_ts)) {
-                return false;
-            }
+        const uint64_t sent_ts = perf_metric::now_us ();
+        if (!perf_metric::stamp_payload (&state.request_buffer[0],
+                                         state.payload_size,
+                                         _run_id,
+                                         phase,
+                                         _msg_size,
+                                         _seq++,
+                                         sent_ts)) {
+            return false;
+        }
+
+        zlink_msg_t request;
+        if (zlink_msg_init_data (&request,
+                                 &state.request_buffer[0],
+                                 state.request_buffer.size (),
+                                 NULL,
+                                 NULL)
+            != 0) {
+            return false;
         }
-        const int payload_sent =
-          state.sock->send (_server_rid, state.request, zlink::send_flag::dontwait);
+
+        const int payload_sent = zlink_send_rid (
+          state.sock->handle (), &_server_rid, &request, 1, ZLINK_DONTWAIT);
         if (payload_sent == 0) {
-            if (state.request.init (state.payload_size) != 0)
-                return false;
-            std::memset (state.request.data (), k_payload_fill, state.payload_size);
             state.awaiting_reply = true;
             state.send_pending = false;
             return set_pollout (state, false);
         }
-        if (payload_sent < 0 && errno == EAGAIN) {
+
+        const int err = errno;
+        (void) zlink_msg_close (&request);
+        if (payload_sent < 0 && err == EAGAIN) {
             state.send_pending = true;
+            errno = err;
             return set_pollout (state, true);
         }
+        errno = err;
         return false;
     }
 
