    if (!spot.valid ())
        return false;

    zlink::service::spot_node_t control_node (ctx.ctx ());
    if (!control_node.valid ())
        return false;

    zlink::service::spot_t control_spot (control_node);
    if (!control_spot.valid ())
        return false;

    if (!configure_spot_server_tls (node, transport_))
