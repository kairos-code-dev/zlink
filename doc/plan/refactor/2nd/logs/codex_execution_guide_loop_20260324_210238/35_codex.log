+    TEST_ASSERT_TRUE (runtime.connected_peer_endpoints.count (
+                        "wss://127.0.0.1:9000")
+                      == 1);
+    TEST_ASSERT_EQUAL_UINT64 (1, runtime.connected_peer_version.load ());
+}
 }
 
