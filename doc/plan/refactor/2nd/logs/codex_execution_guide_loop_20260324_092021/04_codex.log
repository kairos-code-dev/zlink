+            errno = EINVAL;
+            return -1;
+        }
+        zlink::socket_base_t *socket = pub->poller_socket ();
+        if (!socket) {
+            errno = EFAULT;
+            return -1;
+        }
+        return socket->getsockopt (socket_option, optval_, optvallen_);
+    }
+
+    if (zlink::spot_sub_t *sub = as_spot_sub_side_handle (handle_)) {
+        if (sub_option < 0) {
+            errno = EINVAL;
