+        topic_buf = ctypes.create_string_buffer(256)
+        topic_len = ctypes.c_size_t(len(topic_buf))
+        rc = lib().zlink_subscribe(
+            self._handle,
+            ctypes.byref(routing_id),
+            ctypes.byref(parts),
+            ctypes.byref(part_count),
