+          });
+        TEST_ASSERT_TRUE (ready);
+        gate.go = true;
+    }
+    gate.cv.notify_all ();
+
+    std::vector<bool> seen_a (per_publisher, false);
+    std::vector<bool> seen_b (per_publisher, false);
+
+    for (int i = 0; i < per_publisher * 2; ++i) {
