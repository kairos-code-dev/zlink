    }

    int recv (void *data_,
              size_t size_,
              recv_flag flags_ = recv_flag::none)
    {
        if (!data_) {
            errno = EINVAL;
            return -1;
        }

        message_t part;
        const int rc = recv (part, flags_);
        if (rc != 0)
            return -1;
        if (part.size () != size_) {
            errno = EMSGSIZE;
            return -1;
        }

        if (size_ > 0)
            std::memcpy (data_, part.data (), size_);
        return static_cast<int> (size_);
    }


