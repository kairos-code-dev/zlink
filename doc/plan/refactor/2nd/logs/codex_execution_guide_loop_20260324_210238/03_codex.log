+
+void zlink::socket_lifecycle_coordinator_t::mark_destroy_pending ()
+{
+    destroy_pending = true;
+}
+
+void zlink::socket_lifecycle_coordinator_t::clear_destroy_pending ()
+{
+    destroy_pending = false;
