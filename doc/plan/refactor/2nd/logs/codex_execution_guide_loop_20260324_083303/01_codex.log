+                                                 int option_,
+                                                 const void *optval_,
+                                                 size_t optvallen_,
+                                                 bool is_int_,
+                                                 int value_)
+{
+    switch (option_) {
+        case ZLINK_INTERNAL_OPT_SNDBUF:
+            if (is_int_ && value_ >= -1) {
+                self_->sndbuf = value_;
+                return 0;
+            }
+            break;
+
+        case ZLINK_INTERNAL_OPT_RCVBUF:
