+    if (second_colon == std::string::npos || second_colon == first_colon + 1)
+        return false;
+
+    int seq = -1;
+    std::istringstream seq_stream (
+      payload_.substr (first_colon + 1, second_colon - first_colon - 1));
+    seq_stream >> seq;
+    if (!seq_stream || !seq_stream.eof ())
+        return false;
+
+    *phase_out_ = payload_[0];
+    *seq_out_ = seq;
+    return true;
