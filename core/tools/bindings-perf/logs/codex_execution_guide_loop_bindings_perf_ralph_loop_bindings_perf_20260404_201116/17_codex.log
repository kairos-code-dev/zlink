            debug_log ("invalid ready payload");
            return false;
        }
        if (_control_endpoint.empty ()) {
            debug_log ("missing control endpoint");
            errno = EINVAL;
            return false;
        }
        if (!setup_control_plane ())
            return false;
        debug_log ("parsed ready payload");
        if (!setup_slots ())
            return false;
        debug_log ("setup slots complete");
