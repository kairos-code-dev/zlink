   670	    bool wait_for_control_start (int timeout_ms_)
   671	    {
   672	        const auto deadline = std::chrono::steady_clock::now ()
   673	                              + std::chrono::milliseconds (
   674	                                std::max (1, timeout_ms_));
   675	        while (std::chrono::steady_clock::now () < deadline) {
   676	            const zlink::maybe_t<zlink::subscribed_t> maybe_received =
   677	              _control_spot->try_subscribe ();
   678	            if (!maybe_received) {
   679	                std::this_thread::yield ();
   680	                continue;
   681	            }
   682	
   683	            const zlink::subscribed_t &received = *maybe_received;
   684	            if (received.topic != k_control_topic || received.parts.size () != 1)
   685	                continue;
   686	
   687	            const std::string payload (
   688	              static_cast<const char *> (received.parts[0].data ()),
   689	              received.parts[0].size ());
   690	            size_t start_size = 0;
   691	            if (parse_control_start (payload, &start_size)
   692	                && start_size == _msg_size) {
   693	                return true;
   694	            }
   695	        }
   696	
   697	        errno = ETIMEDOUT;
   698	        debug_log ("control start timed out");
   699	        return false;
   700	    }
   701	
   702	    bool wait_sync ()
   703	    {
   704	        const int timeout_ms =
   705	          resolve_spot_phase_timeout_ms (_settings, _msg_size);
   706	        return _callback_mode ? wait_callback_sync (timeout_ms)
   707	                              : wait_recv_sync (timeout_ms);
   708	    }
   709	
   710	    bool wait_callback_sync (int timeout_ms_)
   711	    {
   712	        const auto deadline = std::chrono::steady_clock::now ()
   713	                              + std::chrono::milliseconds (timeout_ms_);
   714	        const size_t required = resolve_sync_quorum ();
   715	        while (std::chrono::steady_clock::now () < deadline) {
   716	            size_t synced = 0;
   717	            for (size_t i = 0; i < _slots.size (); ++i) {
   718	                if (_slots[i]->callback.failed ())
   719	                    return false;
   720	                if (_slots[i]->callback.synced ())
   721	                    ++synced;
   722	            }
   723	            if (synced >= required)
   724	                return true;
   725	        }
   726	
   727	        errno = ETIMEDOUT;
   728	        debug_log ("callback sync timed out");
   729	        return false;
   730	    }
   731	
   732	    bool wait_recv_sync (int timeout_ms_)
   733	    {
   734	        const auto deadline = std::chrono::steady_clock::now ()
   735	                              + std::chrono::milliseconds (timeout_ms_);
   736	        const size_t required = resolve_sync_quorum ();
   737	        while (std::chrono::steady_clock::now () < deadline) {
   738	            bool progressed = false;
   739	            for (size_t i = 0; i < _slots.size (); ++i) {
   740	                if (!drain_recv (*_slots[i], true, &progressed))
   741	                    return false;
   742	            }
   743	
   744	            size_t synced = 0;
   745	            for (size_t i = 0; i < _slots.size (); ++i) {
   746	                if (_slots[i]->synced)
   747	                    ++synced;
   748	            }
   749	            if (synced >= required)
   750	                return true;
   751	            if (!progressed)
   752	                std::this_thread::yield ();
   753	        }
   754	
   755	        errno = ETIMEDOUT;
   756	        debug_log ("recv sync timed out");
   757	        return false;
   758	    }
   759	
   760	    size_t resolve_sync_quorum () const
   761	    {
   762	        if (_slots.empty ())
   763	            return 1;
   764	
   765	        const int percent = std::max (
   766	          1,
   767	          perf::multi::parse_positive_env (
   768	            "PERF_MULTI_SPOT_PHASE_QUORUM_PERCENT", 90));
   769	        const size_t bounded_percent =
   770	          static_cast<size_t> (std::min (percent, 100));
   771	        const size_t required = static_cast<size_t> (
   772	          (static_cast<unsigned long long> (_slots.size ()) * bounded_percent
   773	           + 99ULL)
   774	          / 100ULL);
   775	        return std::max<size_t> (1, required);
   776	    }
   777	
   778	    bool run_active ()
   779	    {
   780	        return _callback_mode ? run_callback_active () : run_recv_active ();
   781	    }
   782	
   783	    bool run_callback_active ()
   784	    {
   785	        const auto start_deadline = std::chrono::steady_clock::now ()
   786	                                    + std::chrono::milliseconds (
   787	                                      resolve_spot_phase_timeout_ms (
   788	                                        _settings, _msg_size));
   789	        while (std::chrono::steady_clock::now () < start_deadline) {
   790	            if (_active_start_us.load (std::memory_order_acquire) != 0)
   791	                break;
   792	            for (size_t i = 0; i < _slots.size (); ++i) {
   793	                if (_slots[i]->callback.failed ())
   794	                    return false;
   795	            }
   796	        }
   797	
   798	        const uint64_t active_start_us =
   799	          _active_start_us.load (std::memory_order_acquire);
   800	        if (active_start_us == 0) {
   801	            errno = ETIMEDOUT;
   802	            debug_log ("callback active start timed out");
   803	            return false;
   804	        }
   805	
   806	        const uint64_t deadline_us =
   807	          active_start_us
   808	          + static_cast<uint64_t> (std::max (1, _settings.duration_seconds))
   809	              * 1000000ULL;
   810	        while (perf_metric::now_us () <= deadline_us) {
   811	            for (size_t i = 0; i < _slots.size (); ++i) {
   812	                if (_slots[i]->callback.failed ())
   813	                    return false;
   814	            }
   815	        }
   816	
   817	        perf::multi::bench_latency_sampler_t merged;
   818	        unsigned long long active_count = 0;
   819	        for (size_t i = 0; i < _slots.size (); ++i) {
   820	            _slots[i]->callback.stop ();
   821	            active_count += _slots[i]->callback.active_count ();
   822	            merged.merge_from (_slots[i]->callback.latency ());
   823	        }
   824	
   825	        _active_count = active_count;
   826	        _latency = merged.snapshot ();
   827	        return _active_count > 0;
   828	    }
   829	
   830	    bool run_recv_active ()
   831	    {
   832	        const uint64_t active_duration_us =
   833	          static_cast<uint64_t> (std::max (1, _settings.duration_seconds))
   834	          * 1000000ULL;
   835	        while (true) {
   836	            const uint64_t start = _active_start_us.load (std::memory_order_acquire);
   837	            if (start != 0 && perf_metric::now_us () > start + active_duration_us)
   838	                break;
   839	
   840	            bool progressed = false;
   841	            for (size_t i = 0; i < _slots.size (); ++i) {
   842	                if (!drain_recv (*_slots[i], false, &progressed))
   843	                    return false;
   844	            }
   845	            if (!progressed)
   846	                std::this_thread::yield ();
   847	        }
   848	
   849	        return _active_count > 0;
   850	    }
   851	
   852	    bool drain_recv (client_slot_t &slot_, bool sync_only_, bool *progressed_out_)
   853	    {
   854	        for (;;) {
   855	            const zlink::maybe_t<zlink::subscribed_t> maybe_received =
   856	              slot_.spot->try_subscribe ();
   857	            if (!maybe_received)
   858	                return true;
   859	
   860	            const zlink::subscribed_t &received = *maybe_received;
   861	            const std::vector<zlink::message_t> &parts = received.parts;
   862	            const std::string &topic = received.topic;
   863	
   864	            if (progressed_out_)
   865	                *progressed_out_ = true;
   866	
   867	            if (topic != k_topic || parts.size () != 1)
   868	                continue;
   869	
   870	            perf_metric::header_t header;
   871	            if (!perf_metric::decode_payload_header (
   872	                  parts[0].data (), parts[0].size (), &header)
   873	                || header.msg_size != static_cast<uint32_t> (_msg_size)) {
   874	                continue;
   875	            }
   876	
   877	            slot_.synced = true;
   878	            if (sync_only_)
   879	                continue;
   880	
   881	            if (header.phase != static_cast<uint32_t> (perf_metric::phase_active))
   882	                continue;
   883	
   884	            const uint64_t received_ts_us = perf_metric::now_us ();
   885	            uint64_t start = _active_start_us.load (std::memory_order_acquire);
   886	            if (start == 0) {
   887	                (void) _active_start_us.compare_exchange_strong (
   888	                  start, received_ts_us, std::memory_order_acq_rel);
   889	                start = _active_start_us.load (std::memory_order_acquire);
   890	            }
   891	            if (received_ts_us < start)
   892	                continue;
   893	
   894	            const uint64_t duration_us =
   895	              static_cast<uint64_t> (std::max (1, _settings.duration_seconds))
   896	              * 1000000ULL;
   897	            if (received_ts_us > start + duration_us)
   898	                continue;
   899	
   900	            ++_active_count;
   901	            const double latency_us = received_ts_us >= header.sent_ts_us
   902	                                        ? static_cast<double> (
   903	                                            received_ts_us - header.sent_ts_us)
   904	                                        : 0.0;
   905	            _latency_sampler.add (latency_us);
   906	        }
   907	    }
   908	
   909	    void print_result ()
   910	    {
   911	        if (!_callback_mode)
   912	            _latency = _latency_sampler.snapshot ();
   913	
   914	        const double throughput =
   915	          static_cast<double> (_active_count)
   916	          / static_cast<double> (std::max (1, _settings.duration_seconds));
   917	        const double bandwidth =
   918	          throughput * static_cast<double> (_msg_size) / 1000000.0;
   919	
   920	        perf::multi::print_result ("current",
   921	                                   k_pattern,
   922	                                   _transport,
   923	                                   _msg_size,
   924	                                   throughput,
   925	                                   bandwidth,
   926	                                   _latency.mean_us,
   927	                                   _latency.p95_us,
   928	                                   _latency.p99_us);
   929	        perf::multi::print_client_resource_metrics (
   930	          "current", k_pattern, _transport, _msg_size, _resource_metrics);
   931	    }
   932	
   933	    const std::string _transport;
   934	    const size_t _msg_size;
   935	    const std::string _ready_payload;
   936	    const std::string _control_endpoint;
   937	    const perf::multi::multi_bench_settings_t _settings;
   938	    const bool _callback_mode;
   939	    perf::multi::ctx_guard_t _ctx;
   940	    std::unique_ptr<zlink::service::spot_node_t> _control_node;
   941	    std::unique_ptr<zlink::service::spot_t> _control_spot;
   942	    std::vector<std::unique_ptr<client_slot_t> > _slots;
   943	    zlink::poller_t _poller;
   944	    std::vector<zlink::poll_event_t> _poll_events;
   945	    std::string _server_endpoint;
   946	    std::string _registry_pub_endpoint;
   947	    std::string _registry_router_endpoint;
   948	    std::atomic<uint64_t> _active_start_us;
   949	    unsigned long long _active_count;
