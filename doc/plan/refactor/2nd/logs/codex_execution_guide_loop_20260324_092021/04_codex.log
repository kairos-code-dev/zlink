+        zlink::service_public_api_scope_t admission (spot->public_api);
+        if (!admission.acquired ())
+            return -1;
+        zlink::spot_pub_t *pub = ensure_spot_pub (spot);
+        return pub ? pub->routing_id (out_) : -1;
