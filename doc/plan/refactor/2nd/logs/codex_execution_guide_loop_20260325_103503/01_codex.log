+}
+
+inline bool publish_mesh_pub_budget_hint (spot_mesh_peer_state_t *state_,
+                                          const std::string &endpoint_,
+                                          uint32_t ready_count_)
+{
+    if (!state_)
+        return false;
+
+    const uint32_t previous =
