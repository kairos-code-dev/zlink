+static int append_frame (std::vector<zlink_msg_t *> *frames_, zlink_msg_t *src_)
+{
+    if (!frames_ || !src_) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    zlink_msg_t *dst =
+      static_cast<zlink_msg_t *> (malloc (sizeof (zlink_msg_t)));
+    if (!dst) {
+        errno = ENOMEM;
+        return -1;
+    }
+    memset (dst, 0, sizeof (zlink_msg_t));
+
+    msg_t *dst_msg = reinterpret_cast<msg_t *> (dst);
+    if (dst_msg->init () != 0
+        || dst_msg->move (*reinterpret_cast<msg_t *> (src_)) != 0) {
+        zlink_msg_close (dst);
+        free (dst);
+        errno = EFAULT;
+        return -1;
+    }
+
+    frames_->push_back (dst);
+    return 0;
