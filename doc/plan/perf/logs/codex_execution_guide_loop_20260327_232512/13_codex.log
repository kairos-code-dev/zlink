+    return check_hwm_unlocked ();
+}
+
+bool zlink::pipe_t::check_hwm_unlocked () const
+{
     const bool full =
       _hwm > 0 && _msgs_written - _peers_msgs_read >= uint64_t (_hwm);
     return !full;
