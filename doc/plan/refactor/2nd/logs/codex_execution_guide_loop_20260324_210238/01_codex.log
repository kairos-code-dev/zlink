+        if (public_api_state.compare_exchange_weak (
+              old, desired, std::memory_order_acq_rel,
+              std::memory_order_acquire)) {
+            if (from_self_callback_)
+                close_deferred.store (true, std::memory_order_release);
+            return true;
+        }
+    }
