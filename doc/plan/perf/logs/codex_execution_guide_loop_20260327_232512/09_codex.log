+    socket_public_send_scope_t send_scope (lifecycle, needs_public_api_sync);
+    if (!send_scope.acquired ())
         return -1;
+
+    if (unlikely (_ctx_terminated)) {
+        errno = ETERM;
+        return -1;
     }
 
     int rc = process_commands (0, true);
     if (unlikely (rc != 0))
         return -1;
 
+    bool started = false;
