struct callback_client_state_t;

struct callback_thread_metrics_t
{
    callback_thread_metrics_t ()
        : owner (NULL),
          registered (false),
          epoch (0),
          active_received (0),
          sample_index (0),
          latency ()
    {
    }

    callback_client_state_t *owner;
    bool registered;
    uint64_t epoch;
    unsigned long long active_received;
    unsigned long long sample_index;
    perf::multi::bench_latency_sampler_t latency;
};

struct callback_client_state_t
{
    callback_client_state_t ()
        : active_start_us (NULL),
          expected_msg_size (0),
          active_duration_us (0),
          collect_active (false),
          fatal (false),
          metrics_epoch (1),
          thread_metrics_mutex (),
          thread_metrics ()
    {
    }

    std::atomic<uint64_t> *active_start_us;
    std::atomic<size_t> expected_msg_size;
    std::atomic<uint64_t> active_duration_us;
    std::atomic<bool> collect_active;
    std::atomic<bool> fatal;
    std::atomic<uint64_t> metrics_epoch;
    std::mutex phase_mutex;
    std::condition_variable phase_cv;
    std::mutex thread_metrics_mutex;
    std::vector<callback_thread_metrics_t *> thread_metrics;
};

static thread_local callback_thread_metrics_t g_callback_thread_metrics;

void reset_callback_thread_metrics (callback_thread_metrics_t *metrics_,
                                    uint64_t epoch_)
{
    if (!metrics_)
        return;

    metrics_->epoch = epoch_;
    metrics_->active_received = 0;
    metrics_->sample_index = 0;
    metrics_->latency = perf::multi::bench_latency_sampler_t ();
}

callback_thread_metrics_t *bind_callback_thread_metrics (
  callback_client_state_t *state_)
{
    if (!state_)
        return NULL;

    callback_thread_metrics_t &metrics = g_callback_thread_metrics;
    if (!metrics.registered || metrics.owner != state_) {
        metrics.owner = state_;
        metrics.registered = true;
        std::lock_guard<std::mutex> lock (state_->thread_metrics_mutex);
        if (std::find (state_->thread_metrics.begin (),
                       state_->thread_metrics.end (),
                       &metrics)
            == state_->thread_metrics.end ()) {
            state_->thread_metrics.push_back (&metrics);
        }
    }

    const uint64_t epoch = state_->metrics_epoch.load (std::memory_order_acquire);
    if (metrics.epoch != epoch)
        reset_callback_thread_metrics (&metrics, epoch);
    return &metrics;
}

