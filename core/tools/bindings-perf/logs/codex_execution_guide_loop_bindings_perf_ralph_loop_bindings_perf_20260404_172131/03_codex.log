 succeeded in 0ms:
        std::cerr << "usage: <transport> <size>" << std::endl;
        return 1;
    }

    const std::string transport = argv[1];
    const size_t size = static_cast<size_t> (std::strtoull (argv[2], NULL, 10));
    if (size == 0)
        return 1;

    {
        std::lock_guard<std::mutex> lock (g_start_gate.mutex);
        g_start_gate.requested = false;
        g_start_gate.msg_size = 0;
    }

    {
        std::lock_guard<std::mutex> lock (g_control_connect_gate.mutex);
        g_control_connect_gate.requested = false;
        g_control_connect_gate.endpoint.clear ();
    }

    std::thread stdin_watcher ([]() {
        std::string line;
        while (std::getline (std::cin, line)) {
            std::string control_peer_endpoint;
            size_t start_size = 0;
            if (parse_connect_control_command (line, &control_peer_endpoint)) {
                std::lock_guard<std::mutex> lock (g_control_connect_gate.mutex);
                g_control_connect_gate.requested = true;
                g_control_connect_gate.endpoint = control_peer_endpoint;
                g_control_connect_gate.cv.notify_all ();
                continue;
            }
            if (parse_start_command (line, &start_size)) {
                std::lock_guard<std::mutex> lock (g_start_gate.mutex);
                g_start_gate.requested = true;
                g_start_gate.msg_size = start_size;
                g_start_gate.cv.notify_all ();
                continue;
            }
            if (line == "STOP" || line == "QUIT") {
                {
                    std::lock_guard<std::mutex> lock (g_control_connect_gate.mutex);
                    g_control_connect_gate.requested = false;
                    g_control_connect_gate.endpoint.clear ();
                }
                {
                    std::lock_guard<std::mutex> lock (g_start_gate.mutex);
                    g_start_gate.requested = false;
                    g_start_gate.msg_size = 0;
                    g_start_gate.cv.notify_all ();
                }
                g_control_connect_gate.cv.notify_all ();
                return;
            }
        }
    });
    stdin_watcher.detach ();

    return perf_spot_server (transport, size) ? 0 : 1;
}

