+            text += proc_->stdout_lines[i];
+    }
+    return text;
+}
+
+std::string capture_case_debug_text (process_capture_t *server_,
+                                     process_capture_t *client_)
+{
+    std::string text;
+    const std::string server_text = capture_debug_text (server_);
