+        return -1;
+    if (size_ > 0 && buf_)
+        memcpy (zlink_msg_data (&msg), buf_, size_);
+
+    const int rc = zlink_send_rid (router_, rid_, &msg, 1, flags_);
+    if (rc != 0) {
+        const int err = errno;
+        zlink_msg_close (&msg);
+        errno = err;
+        return -1;
+    }
+    return 0;
