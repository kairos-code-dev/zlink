+bool zlink::dist_t::has_single_matching_pipe () const
+{
+    return _matching == 1 && _active == 1 && _eligible == 1;
+}
+
+bool zlink::dist_t::try_send_to_matching_single_pipe (msg_t *msg_)
+{
+    if (!has_single_matching_pipe ())
+        return false;
+
+    pipe_t *pipe = _pipes[0];
+    const bool msg_more = (msg_->flags () & msg_t::more) != 0;
+    const bool ok = msg_more ? pipe->write (msg_) : pipe->write_and_flush (msg_);
+    if (!ok)
+        return false;
+
+    if (!msg_more)
+        _active = _eligible;
+    _more = msg_more;
+
+    const int rc = msg_->init ();
+    errno_assert (rc == 0);
+    return true;
+}
+
 void zlink::dist_t::distribute (msg_t *msg_)
