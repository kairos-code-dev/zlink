bool same_routing_id (const zlink_routing_id_t &lhs, const zlink_routing_id_t &rhs)
{
    return lhs.size == rhs.size
           && std::memcmp (lhs.data, rhs.data, lhs.size) == 0;
}

struct phase_config_t
{
    int warmup_seconds;
    int settle_ms;
    int active_seconds;
