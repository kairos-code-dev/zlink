+                        continue;
+                    }
+                    if (validated[slot_index])
+                        break;
+
+                    validated[slot_index] = true;
+                    --remaining;
+                    if (!set_pollout (*state, false))
+                        return false;
+                    break;
+                }
+            }
+        }
+
+        return remaining == 0;
+    }
