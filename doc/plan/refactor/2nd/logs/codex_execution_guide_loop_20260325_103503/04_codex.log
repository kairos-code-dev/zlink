-            return -1;
-        }
-
-        scoped_lock_t lock (_sync);
-        bootstrap_state_t &stored = _bootstrap_states[registry_endpoint_];
-        stored.request_sent = true;
-        stored.request_started_ms = zlink::clock_t ().now_ms ();
