    tp_w = 18
    bw_w = 14
    lat_w = 13
    lat95_w = 13
    lat99_w = 13
    cpu_w = 7
    mem_w = 8
    sndq_w = 9
    rcvq_w = 9
    rcvend_w = 9
    if is_multi:
        return (
            f"|{'-' * (size_w + 2)}|{'-' * (tp_w + 2)}|{'-' * (bw_w + 2)}|"
            f"{'-' * (lat_w + 2)}|{'-' * (lat95_w + 2)}|{'-' * (lat99_w + 2)}|"
            f"{'-' * (cpu_w + 2)}|{'-' * (mem_w + 2)}|"
            f"{'-' * (sndq_w + 2)}|{'-' * (rcvq_w + 2)}|{'-' * (rcvend_w + 2)}|"
        )
    return (
        f"|{'-' * (size_w + 2)}|{'-' * (tp_w + 2)}|{'-' * (bw_w + 2)}|"

