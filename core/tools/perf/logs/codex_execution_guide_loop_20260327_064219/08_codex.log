+// When the same burst must feed both mesh_pub and fanout, keep the batch
+// smaller so one dual-forward cycle cannot stretch local delivery tail latency.
+static const size_t ingress_dual_forward_batch_bytes_limit = 14 * 1024 * 1024;
 }
 
