+            return ZLINK_INTERNAL_OPT_SNDHWM;
+        case ZLINK_OPT_RCVHWM:
+            return ZLINK_INTERNAL_OPT_RCVHWM;
+        case ZLINK_OPT_LINGER:
+            return ZLINK_INTERNAL_OPT_LINGER;
