+{
+    if (zlink::spot_pub_t *pub = as_spot_pub_side_handle (handle_))
+        return pub->set_routing_id (data_, size_);
+    if (zlink::spot_sub_t *sub = as_spot_sub_side_handle (handle_))
+        return sub->set_routing_id (data_, size_);
