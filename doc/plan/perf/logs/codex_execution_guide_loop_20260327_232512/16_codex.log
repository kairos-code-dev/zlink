+int zlink::socket_base_t::send_routed_data (const void *routing_id_data_,
+                                            size_t routing_id_size_,
+                                            msg_t *msg_,
+                                            int flags_)
+{
+    socket_lifecycle_coordinator_t &lifecycle = lifecycle_coordinator ();
+    socket_public_send_scope_t send_scope (lifecycle, true);
+    if (!send_scope.acquired ())
+        return -1;
+
+    return send_routed_data_scoped (routing_id_data_, routing_id_size_, msg_,
+                                    flags_, send_scope);
+}
+
