+
+    spot_handle_t *spot = new (std::nothrow) spot_handle_t ();
+    if (!spot) {
+        errno = ENOMEM;
+        return NULL;
+    }
+    spot->node = node;
+    register_spot_mode_state (spot);
+    g_default_spot_handles[node_] = spot;
+    return spot;
+}
+
+static void *default_sub_handle (void *node_)
+{
