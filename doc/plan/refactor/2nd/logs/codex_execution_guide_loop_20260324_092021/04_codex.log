+          zlink::spot_node_access_t::ensure_internal_receiver (node);
+        if (!receiver)
+            return -1;
+        return is_pattern ? receiver->subscribe_pattern (filter_)
+                          : receiver->subscribe (filter_);
+    }
+
+    errno = EFAULT;
+    return -1;
+}
