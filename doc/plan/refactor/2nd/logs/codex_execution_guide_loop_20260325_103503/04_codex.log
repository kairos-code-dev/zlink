+/* SPDX-License-Identifier: MPL-2.0 */
+
+#ifndef __ZLINK_DISCOVERY_RUNTIME_INTERNAL_HPP_INCLUDED__
+#define __ZLINK_DISCOVERY_RUNTIME_INTERNAL_HPP_INCLUDED__
+
