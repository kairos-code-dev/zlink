+void capture_pair_message (const zlink_routing_id_t *,
+                           zlink_msg_t *parts_,
+                           size_t part_count_,
+                           void *userdata_)
+{
+    recv_handler_probe_t *probe =
+      static_cast<recv_handler_probe_t *> (userdata_);
+    if (!probe) {
+        zlink_multipart_close (parts_, part_count_);
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock (probe->mutex);
+        if (part_count_ > 0) {
+            probe->payload_size = zlink_msg_size (&parts_[0]);
+            const size_t copy_size =
+              probe->payload_size < sizeof (probe->payload)
+                ? probe->payload_size
+                : sizeof (probe->payload);
+            memcpy (probe->payload, zlink_msg_data (&parts_[0]), copy_size);
+        } else {
+            probe->payload_size = 0;
+        }
+        ++probe->calls;
+    }
+    probe->cv.notify_all ();
+    zlink_multipart_close (parts_, part_count_);
+}
