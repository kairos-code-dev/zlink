-        return -1;
-    }
-
-    uint16_t msg_id = 0;
-    uint32_t heartbeat_interval_ms = 0;
-    uint32_t registry_id = 0;
-    uint32_t feature_flags = 0;
-    std::string pub_endpoint;
-    std::string uplink_endpoint;
-    bool ok = false;
