/bin/bash -lc "python - <<'PY'
import re
from pathlib import Path
base=Path('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt')
cur=Path('core/perf/results/multi/report/perf_linux_recv_20260324_161254_spot-multi-postfix2.txt')

def parse(path):
    rows={}
    pat=None; tr=None
    for line in path.read_text(encoding='utf-8').splitlines():
        m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
        if m:
            pat=m.group(1); tr=None; continue
        if pat "'!= '"'MULTI_SPOT':
            continue
        m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
        if m and 'Done' not in line:
            tr=m.group(1); continue
        if '|' not in line or tr is None:
            continue
        cols=[c.strip() for c in line.strip().strip('|').split('|')]
        if len(cols) < 2 or cols[0] in ('Size','----------'):
            continue
        size=cols[0]
        if not size.endswith('B'):
            continue
        size=int(size[:-1])
        cell=cols[1]
        m=re.match(r'([0-9.]+)\\s+([KM]?)msg/s', cell)
        if not m:
            continue
        value=float(m.group(1))
        unit=m.group(2)
        mult=1_000.0 if unit=='K' else 1_000_000.0 if unit=='M' else 1.0
        rows[(tr,size)] = value*mult
    return rows
b=parse(base); c=parse(cur)
reg=[]
missing=[]
for k,v in sorted(b.items()):
    if k not in c:
        missing.append(k)
        continue
    dv=(c[k]-v)/v
    if dv < 0:
        reg.append((dv,k,v,c[k]))
reg.sort()
print('missing', len(missing))
for k in missing:
    print('MISSING', k)
print('regressions', len(reg))
for dv,k,bv,cv in reg:
    print(f'{k[0]} {k[1]} base={bv:.1f} cur={cv:.1f} delta={dv*100:.2f}%')
