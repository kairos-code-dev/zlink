+std::vector<size_t> resolve_msg_sizes (size_t fallback_size_)
+{
+    std::vector<size_t> out;
+    const char *raw = std::getenv ("PERF_MSG_SIZES");
+    if (!raw || !*raw) {
+        out.push_back (fallback_size_);
+        return out;
+    }
+
+    const std::string csv (raw);
+    size_t start = 0;
+    while (start < csv.size ()) {
