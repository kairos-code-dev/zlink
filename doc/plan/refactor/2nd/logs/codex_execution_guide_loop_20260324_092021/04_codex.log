+int spot_subject_get_common_option (void *handle_,
+                                    zlink_option_t option_,
+                                    void *optval_,
+                                    size_t *optvallen_)
+{
+    const int socket_option = map_common_to_socket_option (option_);
+    const int pub_option = map_common_to_spot_pub_option (option_);
