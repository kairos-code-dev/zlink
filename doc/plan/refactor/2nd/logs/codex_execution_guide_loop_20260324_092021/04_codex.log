+        case ZLINK_OPT_SNDTIMEO:
+            return ZLINK_SPOT_PUB_OPT_SNDTIMEO;
+        case ZLINK_OPT_LINGER:
+            return ZLINK_SPOT_PUB_OPT_LINGER;
+        case ZLINK_OPT_SNDBUF:
+            return ZLINK_SPOT_PUB_OPT_SNDBUF;
+        case ZLINK_OPT_RCVBUF:
