+bool recv_expected_reply (socket_state_t &state,
+                          const zlink_routing_id_t &server_rid,
+                          perf_metric::header_t *header_out,
+                          bool *matched_out)
+{
+    if (matched_out)
+        *matched_out = false;
+    if (!state.sock || !header_out)
+        return false;
+
+    zlink_routing_id_t source_rid = zlink::empty_routing_id ();
+    zlink_msg_t *parts = NULL;
+    size_t part_count = 0;
+    if (zlink_recv (state.sock->handle (),
+                    &source_rid,
+                    &parts,
+                    &part_count,
+                    ZLINK_DONTWAIT)
+        != 0) {
+        return false;
+    }
+
+    if (!parts || part_count != 1 || zlink_msg_size (&parts[0]) != state.payload_size) {
+        zlink_multipart_close (parts, part_count);
+        errno = EPROTO;
+        return false;
+    }
+
+    state.awaiting_reply = false;
+    if (same_routing_id (source_rid, server_rid)
+        && perf_metric::decode_payload_header (
+          zlink_msg_data (&parts[0]), zlink_msg_size (&parts[0]), header_out)) {
+        if (matched_out)
+            *matched_out = true;
+    }
+    zlink_multipart_close (parts, part_count);
+    return true;
+}
