+                   && ((event_->detail_flags & ZLINK_EVENT_DETAIL_SUBJECT) == 0
+                       || std::strcmp(event_->subject, k_topic) == 0)) {
+            probe->ready_count = event_->value;
+        }
+    }
+    probe->cv.notify_all();
