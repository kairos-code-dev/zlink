<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>6.0.0</Version>
    <AssemblyName>Systems.Zlink.Codecs.Json</AssemblyName>
    <PackageId>Systems.Zlink.Codecs.Json</PackageId>
    <RootNamespace>Systems.Zlink.Codecs.Json</RootNamespace>
    <Authors>ulalax</Authors>
    <Description>JSON codec extensions for zlink .NET bindings</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zlink\Zlink.csproj" />
  </ItemGroup>
</Project>
