+        if (!admission.acquired ())
+            return -1;
+        if (!optval_ || optvallen_ != sizeof (size_t)) {
+            errno = EINVAL;
+            return -1;
+        }
+        const size_t value = *static_cast<const size_t *> (optval_);
+        if (value == 0) {
