+    if (!server_text.empty ()) {
+        text += "server:\n";
+        text += server_text;
+    }
+    if (!client_text.empty ()) {
+        if (!text.empty ())
+            text += '\n';
+        text += "client:\n";
+        text += client_text;
+    }
+
+    return text;
+}
+
+void destroy_process_capture (process_capture_t *proc_)
+{
+    if (!proc_)
+        return;
+    cleanup_child (proc_);
+    delete proc_;
+}
