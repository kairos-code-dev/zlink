void test_spot_subscribe_handler ()
{
    zlink::context_t ctx;
    zlink::service::spot_t spot (ctx);
    assert (spot.valid ());

    subscribe_callback_state_t state;
    state.ready = false;
    assert (spot.subscribe ("topic:alpha") == 0);
    assert (spot.subscribe_handler (&subscribe_callback, &state) == 0);

    zlink::message_t outbound = zlink_cpp_contract::make_message ("spot-body");
    assert (spot.publish ("topic:alpha", outbound) == 0);

    std::unique_lock<std::mutex> lock (state.mutex);
    assert (zlink_cpp_contract::wait_until (state.cv, lock, state.ready, 2000));
