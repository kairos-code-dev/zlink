-    private static bool IsGatewaySendBlocked(int errno)
-    {
-        return IsWouldBlock(errno) || IsInterrupted(errno)
-               || errno == (int)ErrorCode.Efsm || errno == 2
-               || errno == (int)ErrorCode.ENotConn
-               || errno == (int)ErrorCode.EHostUnreach;
-    }
