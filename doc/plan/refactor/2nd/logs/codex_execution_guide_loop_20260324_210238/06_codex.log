+void spot_data_plane_t::close_socket_ptr (spot_node_t *node_,
+                                          socket_base_t *&socket_)
+{
+    if (!socket_)
+        return;
+    if (!node_ || !node_->_ctx) {
+        socket_->stop ();
+        socket_->close ();
+        socket_ = NULL;
+        return;
+    }
+    (void) node_->_lifecycle.close_socket (socket_, 2000);
+}
