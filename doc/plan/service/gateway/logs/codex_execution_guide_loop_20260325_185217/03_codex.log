-    private struct GatewayClientPhaseState
-    {
-        internal GatewayClientPhaseState(int latencySampleCap)
-        {
-            Seq = 1;
-            SampleSeen = 0;
-            Rng = 0xA341316Cu;
-            LatencySampleCap = latencySampleCap;
