reg=[]
for k,b in base.items():
    if k not in cur:
        continue
    c=cur[k]
    rel=(c-b)/b
    if rel < 0:
        reg.append((rel,k,b,c))
reg.sort()
print('regressions', len([r for r in reg if r[1][0]=='SPOT']))
for rel,k,b,c in [r for r in reg if r[1][0]=='SPOT'][:20]:
    print(f'{k}: base={b:.1f} cur={c:.1f} rel={rel:.2%}')
