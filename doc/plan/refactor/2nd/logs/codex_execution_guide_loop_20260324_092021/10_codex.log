+void zlink::asio_ws_engine_t::schedule_terminate_completion ()
+{
+    if (!_io_context) {
+        _callback_guard.reset ();
+        delete this;
+        return;
+    }
+
+    boost::asio::post (*_io_context, [this] () {
+        if (_read_pending || _write_pending) {
+            schedule_terminate_completion ();
+            return;
+        }
+
+        _callback_guard.reset ();
+        delete this;
+    });
+}
