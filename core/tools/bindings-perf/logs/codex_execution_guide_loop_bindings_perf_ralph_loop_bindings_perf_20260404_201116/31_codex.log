                        if (err == EINTR)
                            continue;
                        return false;
                    }
                    if (state->reply.size () != state->payload_size) {
                        errno = EPROTO;
                        return false;
                    }

                    state->awaiting_reply = false;
                    if (!same_routing_id (source_rid, _server_rid))
                        continue;

                    perf_metric::header_t header;
                    if (!perf_metric::decode_payload_header (
                          state->reply.data (), state->reply.size (), &header)) {
                        continue;
                    }
                    if (!perf_metric::is_expected (header, _run_id, phase, _msg_size))
                        continue;

                    ++count;
                    state->awaiting_reply = false;
                    if (lat_out && phase == perf_metric::phase_active) {
                        const uint64_t now_us = perf_metric::now_us ();
