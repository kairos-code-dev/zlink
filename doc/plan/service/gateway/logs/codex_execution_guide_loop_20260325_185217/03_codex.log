-            return false;
-
-        if (!active)
-            return received >= warmupCount;
-
-        return received > 0 && latencySamples.Count > 0;
-    }
-
-    private static bool IsInterrupted(int errno)
-    {
-        ErrorCode code = ZlinkException.MapErrorCode(errno);
