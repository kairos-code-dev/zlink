+        errno = EINVAL;
+        return -1;
+    }
+
+    async_mailbox_active.store (true, std::memory_order_release);
+    mailbox_->set_io_context (&io_thread_->get_io_context (), handler_,
+                              handler_arg_, pre_post_);
+    mailbox_->schedule_if_needed ();
+    return 0;
