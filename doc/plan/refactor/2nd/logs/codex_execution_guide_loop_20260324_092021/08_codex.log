import re
from pathlib import Path

def parse(path):
    rows = {}
    pattern = None
    transport = None
    for line in Path(path).read_text(encoding='utf-8').splitlines():
        m = re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
        if m:
            pattern = m.group(1)
            transport = None
            continue
        m = re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
        if m and 'Done' not in line:
            transport = m.group(1)
            continue
        if '|' not in line or pattern is None or transport is None:
            continue
        cols = [c.strip() for c in line.strip().strip('|').split('|')]
        if len(cols) < 2 or cols[0] in ('Size', '----------'):
            continue
        size = cols[0].replace('B','')
        tp = cols[1].replace('Kmsg/s','').replace('Kops/s','').replace('msg/s','').replace('ops/s','').replace(',','').strip()
        if not tp:
            continue
        try:
            value = float(tp)
        except ValueError:
            continue
        if any(x in cols[1] for x in ('Kmsg/s','Kops/s')):
            value *= 1000.0
        rows[(pattern, transport, size)] = value
    return rows

def compare(base_path, cur_path, label):
    base = parse(base_path)
    cur = parse(cur_path)
    missing = sorted(set(base) - set(cur))
    reg = []
    for key, b in base.items():
        c = cur.get(key)
        if c is None:
            continue
        if c < b:
            reg.append(((c - b) / b, key, b, c, label))
    reg.sort(key=lambda x: (x[0], -int(x[1][2]), x[1][0]))
    return base, cur, missing, reg

single = compare('doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt', 'core/perf/results/single/report/perf_linux_callback_20260324_120711_final-single.txt', 'single')
multi = compare('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt', 'core/perf/results/multi/report/perf_linux_recv_20260324_123623_final-multi.txt', 'multi')
for label, data in [('single', single), ('multi', multi)]:
    base, cur, missing, reg = data
    passed = sum(1 for k, b in base.items() if k in cur and cur[k] >= b)
    print(f'[{label}] baseline_rows={len(base)} current_rows={len(cur)} missing={len(missing)} pass={passed} regressions={len(reg)}')
    for delta, key, b, c, _ in reg[:10]:
        pattern, transport, size = key
        print(f'  {pattern:20s} {transport:6s} {size:>6s}B baseline={b:.1f} current={c:.1f} delta={delta:.4%}')
combined = single[3] + multi[3]
combined.sort(key=lambda x: (x[0], -int(x[1][2]), x[1][0]))
print('[combined worst 20]')
for delta, key, b, c, label in combined[:20]:
    pattern, transport, size = key
    print(f'  {label:6s} {pattern:20s} {transport:6s} {size:>6s}B baseline={b:.1f} current={c:.1f} delta={delta:.4%}')
