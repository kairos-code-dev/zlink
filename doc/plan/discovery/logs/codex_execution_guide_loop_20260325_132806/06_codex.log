+    TEST_ASSERT_EQUAL_INT (-1, zlink_disconnect (dealer, "tcp://127.0.0.1:39001"));
+    TEST_ASSERT_EQUAL_INT (EFSM, zlink_errno ());
+    TEST_ASSERT_EQUAL_INT (-1, zlink_unbind (dealer, "tcp://127.0.0.1:39001"));
+    TEST_ASSERT_EQUAL_INT (EFSM, zlink_errno ());
