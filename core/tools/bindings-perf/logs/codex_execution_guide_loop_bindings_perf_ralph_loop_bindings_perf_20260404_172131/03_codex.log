class pubsub_client_bench_t
{
  public:
    pubsub_client_bench_t (const std::string &transport,
                           size_t msg_size,
                           const std::string &endpoint,
                           const perf::multi::multi_bench_settings_t &settings)
        : _transport (transport),
          _msg_size (msg_size),
