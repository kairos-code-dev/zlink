+const StreamDispatchMode = Object.freeze({ NONE: 0, LEN32BE: 1 });
+
+module.exports = {
+  SocketType,
+  SocketOption,
+  SendFlag,
+  ReceiveFlag,
+  StreamDispatchMode
+};
