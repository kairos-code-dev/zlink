+        return service_role_dealer;
+    if (socket_type_ == ZLINK_CORE_SOCKET_PUB)
+        return service_role_pub;
+    if (socket_type_ == ZLINK_CORE_SOCKET_SUB)
+        return service_role_sub;
+    return service_role_invalid;
+}
