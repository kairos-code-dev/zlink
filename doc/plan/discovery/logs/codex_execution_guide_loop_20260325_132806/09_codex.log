diff --git a/doc/plan/discovery/raw-socket-service-discovery-spec.ko.md b/doc/plan/discovery/raw-socket-service-discovery-spec.ko.md
index 399ff25aeff05c6d23b7f980546dc50b2992892d..8a77bbfac2e045c781c15fd7fc37638f1795e850
--- a/doc/plan/discovery/raw-socket-service-discovery-spec.ko.md
