+static void *default_pub_handle (void *node_)
+{
+    zlink::spot_node_t *node = zlink::spot_node_access_t::from_handle (node_);
+    if (!node)
+        return node_;
+
+    std::lock_guard<std::mutex> lock (g_default_handle_mutex);
+    std::map<void *, void *>::iterator it = g_default_pub_handles.find (node_);
+    if (it != g_default_pub_handles.end ())
+        return it->second;
+
+    void *pub = node->create_spot_pub ();
+    if (pub)
+        g_default_pub_handles[node_] = pub;
+    return pub;
+}
+
+static void *default_sub_handle (void *node_)
+{
+    zlink::spot_node_t *node = zlink::spot_node_access_t::from_handle (node_);
+    if (!node)
+        return node_;
+
+    std::lock_guard<std::mutex> lock (g_default_handle_mutex);
+    std::map<void *, void *>::iterator it = g_default_sub_handles.find (node_);
+    if (it != g_default_sub_handles.end ())
+        return it->second;
+
+    void *sub = node->create_spot_sub ();
+    if (sub)
+        g_default_sub_handles[node_] = sub;
