+    raw.value = 2;
+    TEST_ASSERT_TRUE (zlink::monitor_event_keeps_peer_ready (raw));
+
+    raw.value = 0;
+    TEST_ASSERT_FALSE (zlink::monitor_event_keeps_peer_ready (raw));
+
+    raw.event = ZLINK_EVENT_DISCONNECTED;
+    raw.value = 7;
+    TEST_ASSERT_FALSE (zlink::monitor_event_keeps_peer_ready (raw));
+}
 }
 
