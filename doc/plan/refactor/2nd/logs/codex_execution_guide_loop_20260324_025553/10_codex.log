diff --git a/core/src/services/common/service_monitor.cpp b/core/src/services/common/service_monitor.cpp
index 0085714da65a54e30610c96a14ff4d174ca5e357..f140b3f1d3d02cf0e17467aa5e2cbd63725d813c
