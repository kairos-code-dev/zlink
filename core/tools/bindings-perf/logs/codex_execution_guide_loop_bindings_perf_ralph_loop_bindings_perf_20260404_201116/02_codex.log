   291	bool publish_control_message (zlink::service::spot_t &spot_,
   292	                              const std::string &payload_,
   293	                              int timeout_ms_)
   294	{
   295	    const auto deadline = std::chrono::steady_clock::now ()
   296	                          + std::chrono::milliseconds (
   297	                            std::max (1, timeout_ms_));
   298	    while (std::chrono::steady_clock::now () < deadline) {
   299	        zlink::message_t outbound =
   300	          zlink::message_t::from_bytes (payload_.data (), payload_.size ());
   301	        if (!outbound.valid ()) {
   302	            errno = EINVAL;
   303	            return false;
   304	        }
   305	
   306	        const zlink::send_result_t result =
   307	          spot_.try_publish (k_control_topic, outbound);
   308	        if (result == zlink::send_result_t::sent)
   309	            return true;
   310	        if (result != zlink::send_result_t::backpressured
   311	            && result != zlink::send_result_t::not_ready) {
   312	            errno = EFAULT;
   313	            return false;
   314	        }
   315	
   316	        std::this_thread::yield ();
   317	    }
   318	
   319	    errno = ETIMEDOUT;
   320	    return false;
   321	}
