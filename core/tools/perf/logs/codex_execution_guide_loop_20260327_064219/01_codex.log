+    std::lock_guard<std::mutex> lock (proc_->sync);
+    std::string text;
+    if (!proc_->stderr_text.empty ()) {
+        text += "stderr:\n";
+        text += proc_->stderr_text;
+    }
+    if (!proc_->stdout_lines.empty ()) {
+        if (!text.empty ())
+            text += '\n';
+        text += "stdout:\n";
+        for (size_t i = 0; i < proc_->stdout_lines.size (); ++i)
+            text += proc_->stdout_lines[i];
+    }
+    return text;
+}
