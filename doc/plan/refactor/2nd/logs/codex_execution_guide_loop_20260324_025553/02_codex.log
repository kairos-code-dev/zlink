+      lock, std::chrono::milliseconds (timeout_ms_),
+      [probe_, expected_event_type_, expected_value_, endpoint_prefix_]() {
+          return pop_probe_service_event_value_locked (
+            probe_, expected_event_type_, expected_value_, endpoint_prefix_);
+      });
