      zlink_subscribe(state->control_sub,
                      &parts,
                      &part_count,
                      ZLINK_DONTWAIT,
                      topic,
                      &topic_len);
    if (rc != 0) {
        const int err = zlink_errno() != 0 ? zlink_errno() : errno;

