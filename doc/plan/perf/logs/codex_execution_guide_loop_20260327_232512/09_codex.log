+    msleep (SETTLE_TIME);
+
+    zlink_msg_t part;
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_msg_init_size (&part, 7));
+    memcpy (zlink_msg_data (&part), "payload", 7);
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_publish (pub, NULL, &part, 1, 0));
+
+    zlink_msg_t *parts = NULL;
+    size_t part_count = 0;
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_recv (sub, NULL, &parts, &part_count, 0));
+    TEST_ASSERT_EQUAL_UINT64 (1, part_count);
+    TEST_ASSERT_NOT_NULL (parts);
+    TEST_ASSERT_EQUAL_UINT64 (7, zlink_msg_size (&parts[0]));
+    TEST_ASSERT_EQUAL_MEMORY ("payload", zlink_msg_data (&parts[0]), 7);
+    zlink_multipart_close (parts, part_count);
+
+    close_zero_linger (sub);
+    close_zero_linger (pub);
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_ctx_term (ctx));
+}
