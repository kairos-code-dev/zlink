+        TEST_ASSERT_TRUE (seen_a[static_cast<size_t> (i)]);
+        TEST_ASSERT_TRUE (seen_b[static_cast<size_t> (i)]);
+    }
+
+    close_delivery_ready_monitor (&sub_monitor);
+    close_delivery_ready_monitor (&pub_monitor);
