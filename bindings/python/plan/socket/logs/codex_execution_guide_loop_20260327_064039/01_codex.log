+        self._socket_type = socket_type
+        self._pending_send_parts = []
+        self._legacy_recv_queue = []
+        self._recv_handler = None
+        self._recv_handler_cb = None
+        self._subscribe_handler = None
+        self._subscribe_handler_cb = None
