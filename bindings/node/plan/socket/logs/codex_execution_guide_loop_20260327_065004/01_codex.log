+
+        std::vector<unsigned char> packet;
+        if (frame_size > 0) {
+            packet.assign(pending.begin() + 4, pending.begin() + 4 + frame_size);
+        }
+        payload->packets.push_back(packet);
+        pending.erase(pending.begin(), pending.begin() + 4 + frame_size);
+    }
