-        Gateway? gateway = null;
-
-        try
-        {
-            string suffix =
-                $"{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}-{Guid.NewGuid()}";
-            string regPub = EndpointFor("tcp", $"gw-pub-{suffix}");
-            string regRouter = EndpointFor("tcp", $"gw-router-{suffix}");
-            string service = "svc";
-
-            registry = new Registry(ctx);
