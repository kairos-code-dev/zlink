class base_socket_t : public socket_handle_t
{
  public:
    bool valid () const noexcept { return socket_handle_t::valid (); }

    ZLINK_CPP_NODISCARD int bind (const std::string &endpoint_)
    {
        return zlink_bind (handle (), endpoint_.c_str ());
    }

