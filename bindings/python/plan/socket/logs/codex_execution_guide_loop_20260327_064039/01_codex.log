+    def on_topic_message(self, handler):
+        if handler is None:
+            raise ValueError("handler must not be None")
+
+        def _callback(routing_id_ptr, topic_ptr, topic_len, parts_ptr, part_count, _):
+            routing_id = None
+            if routing_id_ptr:
+                routing_id = _routing_id_bytes(routing_id_ptr.contents)
+            topic = b""
