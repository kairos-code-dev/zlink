int zlink::socket_close_ops_t::request_close (socket_base_t *&socket_)
{
    if (!socket_)
        return 0;

    socket_base_t *socket = socket_;
    if (socket->socket_msg_dispatch_active ())
        (void) socket->socket_msg_dispatch_stop ();
    socket->stop ();
    socket->close ();
    socket_ = NULL;
