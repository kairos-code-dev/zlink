+    if (!admission.acquired ())
+        return -1;
+    if (!optvallen_) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (!optval_) {
+        *optvallen_ = sizeof (size_t);
+        return 0;
+    }
+    if (*optvallen_ < sizeof (size_t)) {
+        *optvallen_ = sizeof (size_t);
+        errno = ENOBUFS;
+        return -1;
+    }
+    scoped_lock_t lock (const_cast<mutex_t &> (_sync));
+    *static_cast<size_t *> (optval_) = _metadata_max_size;
+    *optvallen_ = sizeof (size_t);
+    return 0;
+}
