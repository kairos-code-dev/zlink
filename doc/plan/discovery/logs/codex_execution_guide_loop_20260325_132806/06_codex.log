+    out_->clear ();
+    const socket_base_t::endpoints_t &endpoints = _socket->endpoint_runtime ().endpoints;
+    for (socket_base_t::endpoints_t::const_iterator it = endpoints.begin ();
+         it != endpoints.end (); ++it) {
