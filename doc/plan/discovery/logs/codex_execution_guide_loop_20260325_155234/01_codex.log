+        if (zlink_bind (socket_, endpoint_out_) == 0) {
+            *port_seed_ += 1;
+            return;
+        }
+        if (errno != EADDRINUSE)
+            break;
+        *port_seed_ += 1;
+    }
+    TEST_FAIL_MESSAGE ("raw socket bind with port seed failed");
+}
