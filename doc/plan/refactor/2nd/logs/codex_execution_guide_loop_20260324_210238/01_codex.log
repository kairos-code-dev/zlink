+{
+    const uint32_t depth =
+      callback_api_depth.fetch_sub (1, std::memory_order_acq_rel) - 1;
+    leave_public_api ();
+    return depth == 0
+           && close_deferred.load (std::memory_order_acquire)
+           && public_close_requested ();
+}
