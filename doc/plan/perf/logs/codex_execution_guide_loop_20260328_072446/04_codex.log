inline unsigned long long wallclock_now_us ()
{
    const auto now =
      std::chrono::time_point_cast<std::chrono::microseconds> (
        std::chrono::system_clock::now ());
    return static_cast<unsigned long long> (now.time_since_epoch ().count ());
}

