reg.sort(key=lambda x: (999 if x[0] is None else x[0]))
print('regressions', len(reg))
for rel,k,bv,cv in reg[:20]:
    if rel is None:
        print('MISSING',k)
    else:
        print(k, 'baseline', round(bv,1), 'current', round(cv,1), 'rel', round(rel,4))
