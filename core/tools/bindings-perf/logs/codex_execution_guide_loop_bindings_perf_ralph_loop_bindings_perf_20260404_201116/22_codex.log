    {
        if (!_node)
            _last_error = errno != 0 ? errno : EFAULT;
    }

    ~spot_node_t () { (void) close (); }

    spot_node_t (spot_node_t &&other) noexcept
        : _node (other._node), _last_error (other._last_error)
