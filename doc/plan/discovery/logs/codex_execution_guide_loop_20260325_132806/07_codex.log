+
+- 2026-03-25: `core/include/zlink.h`,
+  `core/src/api/service_gateway_api.cpp`,
+  `core/src/api/service_spot_node_api.cpp`,
+  `core/src/services/gateway/`,
+  `core/src/services/spot/`,
