+    TEST_ASSERT_EQUAL_INT (
+      zlink::options_owner_core_socket,
+      zlink::option_owner_of (ZLINK_INTERNAL_OPT_HEARTBEAT_TIMEOUT));
+
+    TEST_ASSERT_EQUAL_INT (
+      zlink::options_owner_transport_network,
