+    if (lhs_.service_role != rhs_.service_role)
+        return lhs_.service_role < rhs_.service_role;
+    const int endpoint_cmp = strcmp (lhs_.endpoint, rhs_.endpoint);
+    if (endpoint_cmp != 0)
