+/* SPDX-License-Identifier: MPL-2.0 */
+#ifndef ZLINK_CPP_SERVICE_MONITOR_HPP_INCLUDED
+#define ZLINK_CPP_SERVICE_MONITOR_HPP_INCLUDED
