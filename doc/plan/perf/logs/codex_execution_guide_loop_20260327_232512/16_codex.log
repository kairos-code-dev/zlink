+static int send_frames_once_routed_data (zlink::socket_base_t *socket_,
+                                         const void *routing_id_data_,
+                                         size_t routing_id_size_,
+                                         zlink_msg_t *parts_,
+                                         size_t part_count_,
+                                         int flags_,
+                                         zlink::socket_public_send_scope_t &scope_)
+{
+    if (!socket_ || !routing_id_data_ || routing_id_size_ == 0 || !parts_
+        || part_count_ == 0) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    const bool more = part_count_ > 1;
+    if (socket_->send_routed_data_scoped (
+          routing_id_data_, routing_id_size_,
+          reinterpret_cast<zlink::msg_t *> (&parts_[0]),
+          (more ? ZLINK_SNDMORE : 0) | flags_, scope_)
+        != 0) {
+        const int err = errno;
+        consume_frames_from (parts_, 0, part_count_);
+        errno = err;
+        return -1;
+    }
+
+    if (!more) {
+        errno = 0;
+        return 0;
+    }
+
+    return send_frames_once (socket_, parts_ + 1, part_count_ - 1, flags_, true,
+                             scope_);
 }
 
