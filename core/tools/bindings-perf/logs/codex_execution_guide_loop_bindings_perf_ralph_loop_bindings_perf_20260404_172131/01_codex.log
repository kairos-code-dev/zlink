+bool publish_control_ready_count (zlink::service::spot_t &control_spot_,
+                                  size_t msg_size_,
+                                  size_t ready_count_,
+                                  int timeout_ms_)
+{
+    if (msg_size_ == 0 || ready_count_ == 0) {
+        errno = EINVAL;
+        return false;
