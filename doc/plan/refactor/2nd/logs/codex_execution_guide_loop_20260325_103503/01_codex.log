+    if (!state_->connected_endpoints.empty ()) {
+        state_->connected_endpoints.clear ();
+        state_->connected_ready_peer_count.store (0,
+                                                  std::memory_order_release);
+        state_->version.fetch_add (1, std::memory_order_acq_rel);
