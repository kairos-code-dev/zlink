+        state_->connected_ready_peer_count.store (ready_peer_count,
+                                                  std::memory_order_release);
+        changed = true;
+    }
+
+    if (changed)
+        state_->version.fetch_add (1, std::memory_order_acq_rel);
+    return changed;
