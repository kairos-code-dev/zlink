/bin/bash -lc "python - <<'PY'
import re
baseline='doc/plan/refactor/2nd/perf_linux_callback_20260323_082648.txt'
current='core/perf/results/single/report/perf_linux_callback_20260324_171622_codex-spot-single.txt'

def parse(path):
    rows={}; pattern=None; transport=None
    with open(path, encoding='utf-8') as f:
        for line in f:
            m=re.match(r'## PATTERN:\\s+([A-Z0-9_]+)', line)
            if m:
                pattern=m.group(1); transport=None; continue
            m=re.match(r'\\s*Testing\\s+([a-z0-9]+)\\b', line)
            if m and 'Done' not in line:
                transport=m.group(1); continue
            if 'RESULT,current,' in line:
                cols=line.strip().split(',')
                if len(cols)>=7 and cols[0]=='RESULT' and cols[1]=='current' and cols[5]=='throughput':
                    rows[(cols[2], cols[3], cols[4]+'B' if not cols[4].endswith('B') else cols[4])] = float(cols[6])
                continue
            if '|' not in line or pattern is None or transport is None:
                continue
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            if len(cols)<2 or cols[0] in ('Size','----------'):
                continue
            size=cols[0]
            thr=re.search(r'([0-9]+(?:\\.[0-9]+)?)', cols[1])
            if thr:
                rows[(pattern, transport, size)] = float(thr.group(1))
    return rows
base=parse(baseline); cur=parse(current)
reg=[]
for key,b in base.items():
    if key[0]"'!='"'SPOT':
        continue
    c=cur.get(key)
    if c is None:
        print('MISSING', key)
        continue
    rel=(c-b)/b
    reg.append((rel,key,b,c))
reg.sort(key=lambda x:x[0])
print('single worst 12:')
for rel,key,b,c in reg[:12]:
    print(f'{key[0]},{key[1]},{key[2]},baseline={b:.1f},current={c:.1f},rel={rel:.4f}')
print('below baseline:', sum(1 for rel,*_ in reg if rel<0))
