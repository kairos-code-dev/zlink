+    static void flush_pending_inproc_locked (ctx_t &ctx_);
+    static bool begin_shutdown_locked (ctx_t &ctx_, bool allow_fork_cleanup_);
+    static int wait_for_reaper_done (ctx_t &ctx_);
+};
+}
+
+#endif
