+
+    TEST_ASSERT_SUCCESS_ERRNO (
+      zlink_bind (receiver, "inproc://pair_inproc_recv_handler_public_send"));
+    TEST_ASSERT_SUCCESS_ERRNO (
+      zlink_connect (sender, "inproc://pair_inproc_recv_handler_public_send"));
+
+    const char payload[] = "ping";
+    TEST_ASSERT_EQUAL_INT (
+      static_cast<int> (sizeof (payload) - 1),
+      zlink_send (sender, payload, sizeof (payload) - 1, 0));
+
+    {
+        std::unique_lock<std::mutex> lock (probe.mutex);
+        const bool delivered = probe.cv.wait_for (
+          lock, std::chrono::seconds (2), [&probe] () { return probe.calls == 1; });
+        TEST_ASSERT_TRUE (delivered);
+        TEST_ASSERT_EQUAL_UINT64 (sizeof (payload) - 1, probe.payload_size);
+        TEST_ASSERT_EQUAL_MEMORY (payload, probe.payload, sizeof (payload) - 1);
+    }
+
+    close_zero_linger (sender);
+    close_zero_linger (receiver);
+    TEST_ASSERT_SUCCESS_ERRNO (zlink_ctx_term (ctx));
