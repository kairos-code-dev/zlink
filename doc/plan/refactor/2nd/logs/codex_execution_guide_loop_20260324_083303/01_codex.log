+void test_option_owner_map_matches_domains ()
+{
+    TEST_ASSERT_EQUAL_INT (
+      zlink::options_owner_core_socket,
+      zlink::option_owner_of (ZLINK_INTERNAL_OPT_SNDHWM));
+    TEST_ASSERT_EQUAL_INT (
