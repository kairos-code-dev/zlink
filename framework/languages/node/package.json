{
  "name": "@zlink-systems/node-framework-workspace",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "description": "ZLink Framework Node.js/NestJS port workspace",
  "scripts": {
    "clean": "rm -rf dist packages/*/dist",
    "build": "node ../../../bindings/node/node_modules/typescript/bin/tsc -b tsconfig.build.json",
    "typecheck": "node ../../../bindings/node/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.js",
    "verify:p0": "npm run build && npm run typecheck && node --test test/**/*.test.js",
    "verify:runtime-matrix": "node scripts/verify_node_runtime_matrix.js",
    "verify:cross-language": "./cross-language/run_cross_language_smoke.sh"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
