+#if defined(__has_cpp_attribute)
+#if __has_cpp_attribute(deprecated)
+#define ZLINK_CPP_DEPRECATED(msg_) [[deprecated(msg_)]]
+#else
+#define ZLINK_CPP_DEPRECATED(msg_)
