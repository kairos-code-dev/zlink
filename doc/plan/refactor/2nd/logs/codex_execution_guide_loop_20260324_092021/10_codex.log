            if (err != EAGAIN && err != ETIMEDOUT && err != EFSM && err != ETERM
                && err != EPIPE && err != ENOTSOCK) {
                errno = err;
                return -1;
            }
        }
    }
    stop_sockets ();
    if (data_plane_thread.get_started ())
        data_plane_thread.stop ();
    return 0;
}

