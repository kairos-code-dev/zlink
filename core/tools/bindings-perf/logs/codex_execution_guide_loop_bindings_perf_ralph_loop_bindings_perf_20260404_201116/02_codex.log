  1223	        event.header_ok = perf_single_metric::decode_payload_header (
  1224	          zlink_msg_data (&parts_[0]), zlink_msg_size (&parts_[0]), &event.header);
  1225	    }
  1226	
  1227	    if (event.active && self->_queue_probe)
  1228	        self->_queue_probe->sample_recv_if_due ();
  1229	
  1230	    if (!self->push_event (event))
  1231	        self->_failed.store (true, std::memory_order_release);
  1232	
  1233	    zlink_multipart_close (parts_, part_count_);
  1234	}
  1235	
  1236	bool subscribe_callback_receiver_t::push_event (const event_t &event_)
  1237	{
  1238	    std::lock_guard<std::mutex> lock (_queue_mutex);
  1239	    if (_stop_worker || _queue_count >= _queue.size ())
  1240	        return false;
  1241	
  1242	    _queue[_queue_tail] = event_;
  1243	    _queue_tail = (_queue_tail + 1) % _queue.size ();
  1244	    ++_queue_count;
  1245	    _queue_cv.notify_one ();
  1246	    return true;
  1247	}
  1248	
  1249	void subscribe_callback_receiver_t::worker_loop ()
  1250	{
  1251	    for (;;) {
  1252	        event_t event;
  1253	        {
  1254	            std::unique_lock<std::mutex> lock (_queue_mutex);
  1255	            while (_queue_count == 0 && !_stop_worker)
  1256	                _queue_cv.wait (lock);
  1257	            if (_queue_count == 0 && _stop_worker)
  1258	                break;
  1259	
  1260	            event = _queue[_queue_head];
  1261	            _queue_head = (_queue_head + 1) % _queue.size ();
  1262	            --_queue_count;
  1263	        }
  1264	
  1265	        std::lock_guard<std::mutex> lock (_result_mutex);
  1266	        if (event.token != _result_token || event.topic != _expected_topic)
  1267	            continue;
  1268	        if (!event.header_ok
  1269	            || !perf_single_metric::is_expected (
  1270	              event.header, event.run_id, event.phase, event.msg_size)) {
  1271	            continue;
  1272	        }
  1273	
  1274	        ++_received_count;
  1275	        if (event.active) {
  1276	            const uint64_t now = perf_single_metric::now_us ();
  1277	            const double latency_us =
  1278	              now >= event.header.sent_ts_us
  1279	                ? static_cast<double> (now - event.header.sent_ts_us)
  1280	                : 0.0;
  1281	            _latency_builder.add (latency_us);
  1282	        }
  1283	        _result_cv.notify_all ();
  1284	    }
  1285	}
