-    case socket_option::linger:
-        return ZLINK_SPOT_PUB_OPT_LINGER;
-    case socket_option::xpub_nodrop:
-        return ZLINK_SPOT_PUB_OPT_NODROP;
-    case socket_option::sndbuf:
