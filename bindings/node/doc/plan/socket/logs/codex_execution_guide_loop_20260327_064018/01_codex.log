+  const existing = (process.env.PATH || '').split(';').filter(Boolean);
+  for (const entry of entries) {
+    if (!entry || !fs.existsSync(entry)) continue;
+    if (!existing.includes(entry)) existing.unshift(entry);
+  }
+  process.env.PATH = existing.join(';');
+}
