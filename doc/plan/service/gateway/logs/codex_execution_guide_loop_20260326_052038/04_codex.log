+    if (!admission.acquired ())
+        return -1;
+    std::vector<unsigned char> metadata;
+    {
+        scoped_lock_t lock (const_cast<mutex_t &> (_sync));
+        metadata = _local_metadata;
+    }
+    return init_msg_from_blob_local (metadata, metadata_out_);
+}
