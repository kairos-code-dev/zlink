diff --git a/doc/plan/discovery/discovery-service-execution-guide.ko.md b/doc/plan/discovery/discovery-service-execution-guide.ko.md
index 507b558fcaef920360f82d1d632194c8b43b21f5..b0c2160795e226d3b31544d963114ae51aef3914
--- a/doc/plan/discovery/discovery-service-execution-guide.ko.md
