            continue
        size = cols[0].replace('B','')
        tp = cols[1].replace('Kmsg/s','').replace(',','').strip()
        value = float(tp) * (1000.0 if 'Kmsg/s' in cols[1] else 1.0)
        rows[(transport,size)] = value
    return rows
