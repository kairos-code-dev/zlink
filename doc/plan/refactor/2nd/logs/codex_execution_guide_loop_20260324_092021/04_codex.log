-    if (!socket_)
-        return;
-    if (override_id_ && !override_id_->empty ()) {
-        // Explicit routing id must take precedence over any auto-generated id.
-        zlink::discovery::set_socket_routing_id (socket_, override_id_, NULL);
-        return;
-    }
