diff --git a/bindings/cpp/samples/spot/spot_callback.cpp b/bindings/cpp/samples/spot/spot_callback.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0dfc733ca4ff676aad159833a24c6a021ea11790
