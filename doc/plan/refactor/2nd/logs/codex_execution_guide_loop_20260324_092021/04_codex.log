+    std::sort (subjects.begin (), subjects.end (), spot_subject_less_t ());
+    if (index_ >= subjects.size ()) {
+        errno = ENOENT;
+        return -1;
+    }
+    return copy_subscription_subject (subjects[index_], filter_out_,
+                                      filter_len_inout_, is_pattern_out_);
+}
