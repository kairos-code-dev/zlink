-            part->reset_flags (msg_t::more);
-        if (!out->write_no_hwm_check (part)) {
-            if (i > 0)
-                out->rollback ();
-            errno = EAGAIN;
-            return -1;
-        }
-        const int init_rc = part->init ();
-        errno_assert (init_rc == 0);
-    }
-
-    out->flush ();
-    return 0;
-}
