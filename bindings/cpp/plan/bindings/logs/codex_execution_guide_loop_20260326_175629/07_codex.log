static const zlink_member_peer_entry_t *find_member_peer (
  const std::vector<zlink_member_peer_entry_t> &entries_,
  const char *endpoint_)
{
    for (size_t i = 0; i < entries_.size (); ++i) {
        if (strcmp (entries_[i].endpoint, endpoint_) == 0)
            return &entries_[i];
    }
    return NULL;
}

