+  std::vector<spot_pub_t *> *pubs_out_,
+  std::vector<spot_sub_t *> *subs_out_)
+{
+    if (!pubs_out_ || !subs_out_)
+        return;
+
+    pubs_out_->clear ();
+    subs_out_->clear ();
+
+    scoped_lock_t lock (_sync);
+    pubs_out_->assign (pubs_.begin (), pubs_.end ());
