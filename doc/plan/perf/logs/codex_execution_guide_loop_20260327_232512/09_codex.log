+}
+
+int zlink::socket_base_t::send_publish_transaction (const char *topic_,
+                                                    msg_t *parts_,
+                                                    size_t part_count_,
+                                                    int flags_)
+{
+    socket_lifecycle_coordinator_t &lifecycle = lifecycle_coordinator ();
+    const bool needs_public_api_sync =
+      options.type != ZLINK_CORE_SOCKET_PAIR;
+    socket_public_send_scope_t send_scope (lifecycle, needs_public_api_sync);
+    if (!send_scope.acquired ())
         return -1;
+
+    if (unlikely (_ctx_terminated)) {
+        errno = ETERM;
+        return -1;
     }
 
     int rc = process_commands (0, true);
     if (unlikely (rc != 0))
         return -1;
 
+    bool started = false;
+    if (topic_) {
+        msg_t topic_msg;
+        const size_t topic_size = strlen (topic_);
+        if (topic_msg.init_size (topic_size) != 0)
+            return -1;
+
+        if (topic_size > 0)
+            memcpy (topic_msg.data (), topic_, topic_size);
+
+        const bool has_payload = part_count_ > 0;
+        rc = send_frame_with_scope (
+          &topic_msg, (has_payload ? ZLINK_SNDMORE : 0) | flags_, send_scope);
+        const int close_rc = topic_msg.close ();
+        errno_assert (close_rc == 0);
+        if (rc != 0)
+            return -1;
+
+        if (!has_payload) {
+            errno = 0;
+            return 0;
+        }
+        started = true;
+    }
+
+    for (size_t i = 0; i < part_count_; ++i) {
+        const bool more = i + 1 < part_count_;
+        rc = send_frame_with_scope (&parts_[i],
+                                    (more ? ZLINK_SNDMORE : 0) | flags_,
+                                    send_scope);
+        if (rc != 0) {
+            const int err = errno;
+            if (started)
+                (void) xrollback ();
+            consume_unsent_frames (parts_, i, part_count_);
+            errno = err;
+            return -1;
+        }
+        started = more;
+    }
+
+    errno = 0;
+    return 0;
+}
