+static int relocate_frame (zlink_msg_t *src_, zlink_msg_t *dst_)
+{
+    if (!src_ || !dst_) {
+        errno = EFAULT;
+        return -1;
+    }
+
+    msg_t *src = reinterpret_cast<msg_t *> (src_);
+    if (!src->check ()) {
+        errno = EFAULT;
+        return -1;
+    }
+
+    *reinterpret_cast<msg_t *> (dst_) = *src;
+    if (src->init () != 0) {
+        zlink_msg_close (dst_);
+        errno = EFAULT;
+        return -1;
+    }
+
+    return 0;
+}
+
+static int append_frame (std::vector<zlink_msg_t> *frames_, zlink_msg_t *src_)
+{
+    if (!frames_ || !src_) {
+        errno = EFAULT;
+        return -1;
+    }
+
+    const size_t previous_size = frames_->size ();
+    frames_->resize (previous_size + 1);
+    if (relocate_frame (src_, &(*frames_)[previous_size]) != 0) {
+        frames_->resize (previous_size);
+        return -1;
+    }
+
+    return 0;
+}
