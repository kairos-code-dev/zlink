<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ZLinkFrameworkTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Zlink.Framework/Zlink.Framework.csproj" />
    <ProjectReference Include="../../src/Zlink.Framework.AspNetCore/Zlink.Framework.AspNetCore.csproj" />
    <ProjectReference Include="../../../../../bindings/dotnet/src/Zlink/Zlink.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Configuration/Registration/Channels.cs" />
    <Compile Include="Configuration/Registration/HandlerExposure.cs" />
    <Compile Include="Configuration/Registration/NodesAndServices.cs" />
    <Compile Include="Configuration/Registration/RegistryAndMonitoring.cs" />
    <Compile Include="Configuration/Registration/RegistryRoutes.cs" />
    <Compile Include="Configuration/Registration/Support.cs" />
    <Compile Include="Contracts/ScaffoldSmokeTests.cs" />
    <Compile Include="Contracts/SpotContractTests.cs" />
    <Compile Include="Documentation/Regression.cs" />
    <Compile Include="Runtime/BackendAdapterFactoryTests.cs" />
    <Compile Include="Runtime/BackendMonitorWrapperTests.cs" />
    <Compile Include="Runtime/HandlerResultAwaiterTests.cs" />
    <Compile Include="Runtime/SerialExecutorTests.cs" />
    <Compile Include="Runtime/ZLinkAsyncSubmitterTests.cs" />
    <Compile Include="Samples/Regression.cs" />
    <Compile Include="../Common/FrameworkGlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../Common/FrameworkTestEnvironment.cs" Link="Common/FrameworkTestEnvironment.cs" />
  </ItemGroup>
</Project>
