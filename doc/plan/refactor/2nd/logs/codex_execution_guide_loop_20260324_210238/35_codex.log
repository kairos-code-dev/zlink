-
-bool spot_data_plane_protocol_t::decode_mesh_xsub_monitor_connection_change (
-  const zlink_monitor_event_t &raw_, bool *connected_out_)
-{
-    if (!connected_out_)
-        return false;
-
-    if (raw_.event == ZLINK_EVENT_CONNECTION_READY_CHANGED) {
-        *connected_out_ = raw_.value != 0;
-        return true;
+    } else if (raw_.event == ZLINK_EVENT_CONNECTION_READY_CHANGED) {
+        const uint32_t ready_count = static_cast<uint32_t> (
+          runtime_->connected_peer_endpoints.size ());
+        if (raw_.value == 0)
+            changed =
+              runtime_->connected_peer_endpoints.erase (raw_.remote_addr) != 0;
+        else if (ready_count < raw_.value)
+            changed =
+              runtime_->connected_peer_endpoints.insert (raw_.remote_addr)
+                .second;
+        else if (ready_count > raw_.value)
+            changed =
+              runtime_->connected_peer_endpoints.erase (raw_.remote_addr) != 0;
+        else
+            changed = false;
     }
 
-    if (raw_.event == ZLINK_EVENT_DISCONNECTED) {
-        *connected_out_ = false;
-        return true;
-    }
+    if (!changed)
+        return;
 
-    return false;
+    runtime_->connected_peer_version.fetch_add (1,
+                                                std::memory_order_acq_rel);
+    if (runtime_->owner)
+        spot_node_access_t::wake_control_task (runtime_->owner);
 }
 
