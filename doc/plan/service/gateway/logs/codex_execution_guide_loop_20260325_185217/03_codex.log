-        if (string.IsNullOrWhiteSpace(endpoint))
-            return false;
-        string[] parts = endpoint.Split('|', 3, StringSplitOptions.TrimEntries);
-        if (parts.Length != 3)
-            return false;
-
-        serverEndpoint = parts[0];
-        registryPub = parts[1];
-        registryRouter = parts[2];
