   102	struct pending_stream_message_t
   103	{
   104	    zlink_routing_id_t rid;
   105	    zlink_msg_t payload;
   106	    bool has_payload;
   107	
   108	    pending_stream_message_t () : has_payload (false)
   109	    {
   110	        rid.size = 0;
