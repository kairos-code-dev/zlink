                  std::chrono::duration_cast<std::chrono::microseconds> (t1 - t0)
                    .count ());
                lat_out->add (us);
            }
            return true;
        }

        if (sent < 0 && errno == EAGAIN) {
            state.pending = true;
            return set_pollout (state, true);
        }

        debug_log ("send failed errno=" + std::to_string (errno));
        return false;
    }

