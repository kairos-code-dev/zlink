<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Systems.Zlink.Codecs.Protobuf</AssemblyName>
    <PackageId>Systems.Zlink.Codecs.Protobuf</PackageId>
    <RootNamespace>Systems.Zlink.Codecs.Protobuf</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Protobuf codec extension for Systems.Zlink</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Zlink/Zlink.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.29.*" />
  </ItemGroup>
</Project>
