+bool direct_public_recv_busy (zlink::socket_base_t *socket_, int type_)
+{
+    if (!socket_)
+        return true;
+
+    switch (type_) {
+        case ZLINK_CORE_SOCKET_SUB:
+        case ZLINK_CORE_SOCKET_XSUB:
+            if (socket_->sub_dispatch_active ()) {
+                errno = EBUSY;
+                return true;
+            }
+            return false;
+
+        case ZLINK_CORE_SOCKET_XPUB:
+            if (socket_->xpub_dispatch_active ()) {
+                errno = EBUSY;
+                return true;
+            }
+            return false;
+
+        case ZLINK_CORE_SOCKET_STREAM:
+            if (socket_->stream_dispatch_active ()) {
+                errno = EBUSY;
+                return true;
+            }
+            return false;
+
+        default:
+            if (socket_->socket_msg_dispatch_active ()) {
+                errno = EBUSY;
+                return true;
+            }
+            return false;
+    }
+}
