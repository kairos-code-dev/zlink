        if (!configure_spot_control_tls (*_control_node, _transport))
            return false;
        const int base_port = 45500 + static_cast<int> (perf_metric::now_us () % 1000) * 4;
        const std::string local_control_endpoint =
          bind_spot_endpoint (*_control_node, _transport, base_port);
        if (local_control_endpoint.empty ())
            return false;
        if (_control_node->connect_peer (_control_endpoint) != 0)
