+/* SPDX-License-Identifier: MPL-2.0 */
+
+#ifndef __ZLINK_SERVICES_DISCOVERY_DISCOVERY_OWNED_SERVICE_HPP_INCLUDED__
+#define __ZLINK_SERVICES_DISCOVERY_DISCOVERY_OWNED_SERVICE_HPP_INCLUDED__
+
