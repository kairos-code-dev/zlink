+struct process_capture_t
+{
+    process_capture_t () :
+        pid (-1),
+        stdout_file (NULL),
+        stderr_file (NULL),
+        stdout_done (false),
+        stderr_done (false)
+    {
+    }
+
+    pid_t pid;
+    FILE *stdout_file;
+    FILE *stderr_file;
+    std::thread stdout_thread;
+    std::thread stderr_thread;
+    std::mutex sync;
