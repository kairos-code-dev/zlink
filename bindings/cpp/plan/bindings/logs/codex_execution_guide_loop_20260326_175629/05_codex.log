/* SPDX-License-Identifier: MPL-2.0 */

#include "support.hpp"

#include <cstdlib>

namespace {

struct pair_callback_state_t
{
    std::mutex mutex;
    std::condition_variable cv;
    bool ready;
    std::string payload;
