diff --git a/bindings/cpp/tests/contract/test_cpp_contract_options.cpp b/bindings/cpp/tests/contract/test_cpp_contract_options.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f030a4901dc9ba6c0c70096d4e0c594ede51e215
--- /dev/null
