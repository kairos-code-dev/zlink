+            const std::string token =
+              raw_sizes.substr (start, comma == std::string::npos
+                                         ? std::string::npos
+                                         : comma - start);
+            if (!token.empty ())
+                msg_sizes.push_back (token);
+            if (comma == std::string::npos)
