+    @classmethod
+    def _resolve_socket_type(cls, sock_type=None):
+        resolved = cls._socket_type_value if sock_type is None else sock_type
+        if resolved is None:
+            raise TypeError("sock_type is required")
+        return _native_socket_type(resolved)
