-        scoped_lock_t lock (_sync);
-        for (std::map<std::string, socket_base_t *>::const_iterator it =
-               _report_dealers.begin ();
-             it != _report_dealers.end (); ++it) {
-            if (it->second)
-                dealers.push_back (it->second);
-        }
-    }
-    if (dealers.empty ())
-        return;
-
-    scoped_lock_t uplink_lock (_uplink_sync);
