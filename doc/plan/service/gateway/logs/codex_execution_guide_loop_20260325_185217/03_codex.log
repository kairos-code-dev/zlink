-    private static void EnqueuePendingReply(PendingGatewayReply[] pendingReplies,
-        ref int pendingReplyCount, Gateway.PreparedService service,
-        ReadOnlySpan<byte> payload)
-    {
-        if (pendingReplyCount >= pendingReplies.Length)
