/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
base = Path('doc/plan/refactor/2nd/perf_linux_recv_20260323_094627.txt')
cur = Path('core/perf/results/multi/report/perf_linux_recv_20260324_231537_residual-reentry-20260324a.txt')

def parse_base(p):
    data={}
    pattern=None; transport=None
    for line in p.read_text().splitlines():
        if line.startswith('## PATTERN: '):
            pattern=line.split(':',1)[1].split('(')[0].strip()
        elif line.startswith('    Testing ') and '|' in line:
            transport=line.split()[1]
        elif line.strip().startswith('|') and 'Kmsg/s' in line:
            cols=[c.strip() for c in line.strip().strip('|').split('|')]
            size=cols[0]
            thr=float(cols[1].split()[0].replace(',',''))*1000
            data[(pattern,transport,size.replace('B',''))]=thr
    return data

def parse_cur(p):
    data={}
    for line in p.read_text().splitlines():
        if line.startswith('RESULT,current,') and ',throughput,' in line:
            _,_,pattern,transport,size,metric,val=line.split(',')
            if metric=='throughput':
                data[(pattern,transport,size)]=float(val)
    return data
b=parse_base(base); c=parse_cur(cur)
rows=[]
for k,v in c.items():
    bv=b.get(k)
    if bv:
        rows.append(((v-bv)/bv,k,bv,v))
rows.sort(key=lambda x:x[0])
for rel,k,bv,v in rows:
    print(f\"{k[0]} {k[1]} {k[2]}B baseline={bv:.1f} current={v:.1f} rel={rel*100:.2f}%\")
