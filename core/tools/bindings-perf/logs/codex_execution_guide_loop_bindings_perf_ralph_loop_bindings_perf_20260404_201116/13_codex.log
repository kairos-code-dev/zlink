        const size_t stop_len = std::strlen (stop);
        zlink::message_t stop_msg (stop_len);
        if (!stop_msg.valid ())
            return;
        std::memcpy (stop_msg.data (), stop, stop_len);
        (void) sock->send (_server_rid, stop_msg, zlink::send_flag::dontwait);
    }

